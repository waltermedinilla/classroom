<%#
  La sala como página propia. Existe para dirección y preceptoría, que llegan desde las
  tarjetas de "clases en vivo" y NO tienen acceso a GET /courses/:id (ni deben tenerlo: mirar
  una clase no es gestionar la materia). El docente y los alumnos ven exactamente la misma
  sala, pero embebida en la solapa "En vivo" de views/course.ejs.
  El contenido es el mismo partial en los dos casos.
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sala en vivo · <%= course.name %></title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div style="max-width:900px;margin:0 auto 16px">
      <h2 style="margin:0 0 4px"><%= course.name %></h2>
      <p style="margin:0;color:var(--text-secondary);font-size:14px">
        <%= course.division?.name || '' %>
        <% if (course.owner?.name) { %> · <%= course.owner.name %><% } %>
        <% if (course.room) { %> · <%= course.room %><% } %>
      </p>
    </div>

    <!-- Diagnóstico de subidas fallidas. Va ANTES del partial: su script lo usa al compartir
         una imagen o un archivo en la sala. En course.ejs se incluye junto a course.js. -->
    <script src="/js/subida-diagnostico.js"></script>
    <%- include('../partials/live-room') %>
  </main>

  <%# Sin el footer, los botones del header de esta página (menú lateral, salir, tema)
      quedan sin sus funciones. Ver views/directivo/en-vivo.ejs. %>
  <%- include('../partials/footer') %>
</body>
</html>
