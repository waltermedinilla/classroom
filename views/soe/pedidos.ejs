<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos — Orientación Escolar</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/soe-styles') %>
  <style>
    /* La tarjeta de un pedido pendiente. La franja de la izquierda es la URGENCIA que puso
       el preceptor: el mismo dato que el chip, legible antes de leer una palabra.
       El color entra por el BORDE y no por un fondo saturado — un fondo en hex obligaría a
       declarar también el color del texto, y el par que se lee en claro se pierde en oscuro. */
    .pedido {
      border: 1px solid var(--border); border-left: 4px solid var(--urgencia, var(--border));
      border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 12px;
      background: var(--surface);
    }
    .pedido.u-alta  { --urgencia: #ea4335; }
    .pedido.u-media { --urgencia: #ea8600; }
    .pedido.u-baja  { --urgencia: #137333; }
    [data-theme="dark"] .pedido.u-alta  { --urgencia: #f28b82; }
    [data-theme="dark"] .pedido.u-media { --urgencia: #fdd663; }
    [data-theme="dark"] .pedido.u-baja  { --urgencia: #81c995; }

    .pedido-cab { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
    .pedido-avatar {
      width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; object-fit: cover;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #0d7377, #14919b);
      color: #ffffff;                 /* fondo en hex ⇒ texto en hex */
      font-size: 16px; font-weight: 600;
    }
    .pedido-quien { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
    .pedido-motivo {
      background: var(--bg); border-radius: var(--radius-sm); padding: 11px 13px;
      font-size: 14px; line-height: 1.55; white-space: pre-wrap; word-break: break-word;
    }
    .pedido-acciones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .pedido details { margin-top: 12px; }
    .pedido summary { cursor: pointer; font-size: 13px; color: var(--primary); }

    /* El aviso de que lo que se escribe acá sale del gabinete. Es lo único que ve el
       preceptor, y tiene que decirse antes del textarea, no debajo. */
    .aviso-respuesta {
      display: flex; gap: 7px; align-items: flex-start;
      font-size: 11.5px; color: var(--text-secondary); line-height: 1.45; margin-bottom: 7px;
    }
    .aviso-respuesta .material-symbols-outlined { font-size: 15px; flex-shrink: 0; margin-top: 1px; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../partials/soe-nav', { activePage }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Pedidos de Preceptoría</h2>
        <div style="font-size:12.5px;color:var(--text-secondary);margin-top:2px">
          Alumnos que Preceptoría derivó al gabinete. Tomar el pedido abre el legajo; descartarlo
          no crea ninguno.
        </div>
      </div>
    </div>

    <%# ── Pendientes ──────────────────────────────────────────────────────────
        El orden lo pone acceso.ordenarPedidos: urgente primero y, dentro de cada urgencia,
        LO MÁS VIEJO ARRIBA. Al revés que el resto del proyecto y a propósito: en una bandeja
        lo que hay que evitar es que un pedido se quede abajo para siempre. %>
    <div class="soe-panel">
      <h3><span class="material-symbols-outlined">move_to_inbox</span> Sin resolver</h3>

      <% if (!pendientes.length) { %>
        <div class="vacio">
          <span class="material-symbols-outlined">inbox</span>
          No hay pedidos esperando.
        </div>
      <% } %>

      <% pendientes.forEach(p => { %>
        <div class="pedido u-<%= p.urgencia %>">
          <div class="pedido-cab">
            <% if (p.student && p.student.avatar) { %>
              <img src="<%= p.student.avatar %>" alt="" class="pedido-avatar">
            <% } else { %>
              <div class="pedido-avatar"><%= ((p.student && p.student.name) || '?').trim().charAt(0).toUpperCase() %></div>
            <% } %>
            <div style="flex:1;min-width:180px">
              <div style="font-size:15px;font-weight:600">
                <%= p.student ? p.student.name : 'Alumno dado de baja' %>
              </div>
              <div class="pedido-quien">
                <%= p.division ? p.division.name : 'Sin curso' %>
                · derivado por <%= p.solicitadaPor ? p.solicitadaPor.name : '—' %>
                el <%= fmt.fechaCorta(p.createdAt) %>
              </div>
            </div>
            <span class="chip <%= p.urgencia === 'alta' ? 'chip-alerta' : 'chip-neutro' %>">
              <span class="punto" style="background:<%= acceso.URGENCIA_COLORS[p.urgencia] %>"></span>
              <%= acceso.URGENCIA_LABELS[p.urgencia] %>
            </span>
          </div>

          <div class="pedido-motivo"><%= p.motivo %></div>

          <% if (typeof soeEscribe !== 'undefined' && soeEscribe && p.student) { %>
            <details>
              <summary>Tomar el pedido o descartarlo</summary>

              <%# Tomar: se abre el legajo (si no lo tenía) y esto que escribió el preceptor
                  entra como primer hito de la línea de tiempo, firmado por él. %>
              <form method="POST" action="/soe/pedidos/<%= p._id %>/tomar" class="soe-form" style="margin-top:12px">
                <div>
                  <label for="tomar-<%= p._id %>">Respuesta al preceptor <span style="font-weight:400;color:var(--text-hint)">(opcional)</span></label>
                  <div class="aviso-respuesta">
                    <span class="material-symbols-outlined">visibility</span>
                    <div>
                      <strong>Esto lo lee el preceptor.</strong> Es lo único del gabinete que
                      llega hasta él: no escribas acá nada del legajo.
                    </div>
                  </div>
                  <textarea id="tomar-<%= p._id %>" name="respuesta" maxlength="500"
                            placeholder="Ej.: Lo cito esta semana. Gracias por avisar."></textarea>
                </div>
                <div class="pedido-acciones">
                  <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">check</span>
                    Tomar y abrir el legajo
                  </button>
                </div>
              </form>

              <%# Descartar: la respuesta es OBLIGATORIA. Un pedido que se descarta sin decir
                  por qué le enseña al preceptor a no volver a derivar. %>
              <form method="POST" action="/soe/pedidos/<%= p._id %>/descartar" class="soe-form"
                    style="margin-top:16px;border-top:1px solid var(--border);padding-top:14px">
                <div>
                  <label for="descartar-<%= p._id %>">No abrir seguimiento — por qué</label>
                  <div class="aviso-respuesta">
                    <span class="material-symbols-outlined">visibility</span>
                    <div>
                      <strong>Obligatorio, y lo lee el preceptor.</strong> Sin una explicación,
                      la próxima vez no avisa.
                    </div>
                  </div>
                  <textarea id="descartar-<%= p._id %>" name="respuesta" maxlength="500" required
                            placeholder="Ej.: Ya está en seguimiento por otra vía. Cualquier novedad, avisame."></textarea>
                </div>
                <div class="pedido-acciones">
                  <button type="submit" class="btn">
                    <span class="material-symbols-outlined">close</span>
                    Descartar el pedido
                  </button>
                </div>
              </form>
            </details>
          <% } %>
        </div>
      <% }) %>
    </div>

    <%# ── Historial ───────────────────────────────────────────────────────── %>
    <% if (resueltos.length) { %>
      <div class="soe-panel">
        <h3><span class="material-symbols-outlined">history</span> Ya resueltos</h3>
        <div class="tabla-scroll">
          <table class="soe-tabla">
            <thead>
              <tr>
                <th>Alumno</th><th>Curso</th><th>Derivó</th><th>Recibido</th>
                <th>Urgencia</th><th>En qué quedó</th><th>Resuelto</th>
              </tr>
            </thead>
            <tbody>
              <% resueltos.forEach(p => { %>
                <tr>
                  <td>
                    <% if (p.student) { %>
                      <a href="/soe/legajo/<%= p.student._id %>#linea"><%= p.student.name %></a>
                    <% } else { %>—<% } %>
                  </td>
                  <td><%= p.division ? p.division.name : '—' %></td>
                  <td style="font-size:12.5px;color:var(--text-secondary)"><%= p.solicitadaPor ? p.solicitadaPor.name : '—' %></td>
                  <td><%= fmt.fechaCorta(p.createdAt) %></td>
                  <td style="font-size:12.5px;color:var(--text-secondary)"><%= acceso.URGENCIA_LABELS[p.urgencia] %></td>
                  <td>
                    <span class="chip <%= p.estado === 'tomada' ? 'chip-ok' : 'chip-neutro' %>">
                      <%= acceso.ESTADO_PEDIDO_LABELS[p.estado] %>
                    </span>
                  </td>
                  <td style="font-size:12.5px;color:var(--text-secondary)">
                    <%= p.resueltaEl ? fmt.fechaCorta(p.resueltaEl) : '—' %>
                    <% if (p.resueltaPor) { %><br><%= p.resueltaPor.name %><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
