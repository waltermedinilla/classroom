  .ag-fecha .m { font-size: 10.5px; text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary); }
  .ag-fecha .h { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
  .ag-cuerpo { min-width: 0; flex: 1; }
  .ag-cuerpo .t { font-size: 13.5px; font-weight: 600; }
  .ag-cuerpo .s { font-size: 12px; color: var(--text-secondary); margin-top: 2px; line-height: 1.45; }
  .ag-fila.atencion .ag-fecha .d { color: #c5221f; }
  [data-theme="dark"] .ag-fila.atencion .ag-fecha .d { color: #f28b82; }

  @media (max-width: 700px) {
    /* La grilla de 7 columnas no se puede colapsar —un calendario con 3 columnas deja de ser
       un calendario—, así que lo que se achica es la celda. El nombre del día pasa a tres
