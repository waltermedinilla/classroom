  <%- include('partials/footer') %>
  <script>
    window.COURSE_ID = '<%= course._id %>';
    window.IS_OWNER = <%= course.canManage(user) %>;
    // Para decidir quién ve Editar/Eliminar en cada novedad: editar es solo del autor,
    // eliminar además lo puede hacer quien gestiona la materia (IS_OWNER), como moderación.
    window.USER_ID = '<%= user._id %>';
    // Acuse de lectura: el registro de que el alumno abrió la actividad se hace siempre.
    // Este flag (lo prende el admin en /admin/tasks) decide solo si al alumno se le avisa.
    window.SHOW_VIEW_RECEIPT = <%= !!(school && school.settings && school.settings.showViewReceiptToStudents) %>;

    function showUploadErrModal(title, msg) {
      document.getElementById('uplModalTitle').innerHTML =
        '<span class="material-symbols-outlined" style="color:#d93025">error</span>' + title;
      document.getElementById('uplModalMsg').textContent = msg;
      document.getElementById('uploadErrModal').style.display = 'flex';
    }
    function closeUploadErrModal() {
      document.getElementById('uploadErrModal').style.display = 'none';
    }
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeUploadErrModal();
    });
    window.USER_INITIAL = '<%= user.name.charAt(0).toUpperCase() %>';
    window.COURSE_COLOR = '<%= (course.header && course.header.color) ? course.header.color : "#1a73e8" %>';
    window.COURSE_COLOR2 = '<%= (course.header && course.header.color2) ? course.header.color2 : "" %>';
  </script>
  <script src="/js/devoluciones.js"></script>
  <!-- Diagnóstico de subidas fallidas. Va ANTES de course.js, que lo usa en uploadSubFile(). -->
  <script src="/js/subida-diagnostico.js"></script>
  <script src="/js/course.js"></script>
  <script src="/js/task-runner.js"></script>
  <% if (course.canManage(user)) { %>
  <script>
    const PRESET_COLORS = ['#1a73e8','#34a853','#ea4335','#fbbc04','#9334e6','#0d7377','#e91e63','#ff5722','#795548','#607d8b'];
    const _INIT_COLOR  = '<%= (course.header && course.header.color)  ? course.header.color  : "#1a73e8" %>';
    const _INIT_COLOR2 = '<%= (course.header && course.header.color2) ? course.header.color2 : "" %>';
    const _INIT_IMAGE  = '<%= (course.header && course.header.image)  ? course.header.image  : "" %>';

    let _customizeTab  = _INIT_IMAGE ? 'image' : 'color';
    let _newImageFile  = null;
    let _removeImage   = false;

    function openCustomizeModal() {
      document.getElementById('hColor').value      = _INIT_COLOR;
      document.getElementById('hColor2').value     = _INIT_COLOR2 || '#9334e6';
      document.getElementById('hGradient').checked = !!_INIT_COLOR2;
      document.getElementById('hColor2Wrap').style.display = _INIT_COLOR2 ? '' : 'none';
      document.getElementById('hBlendColor').value = _INIT_COLOR;
      document.getElementById('imageFilename').textContent = _INIT_IMAGE ? 'Imagen guardada' : '';
      document.getElementById('removeImageBtn').style.display = _INIT_IMAGE ? '' : 'none';
      _newImageFile = null; _removeImage = false;
      switchCustomizeTab(_customizeTab);
      document.getElementById('customizeModal').classList.add('show');
    }

    function closeCustomizeModal() {
      document.getElementById('customizeModal').classList.remove('show');
      document.getElementById('hImageInput').value = '';
      _newImageFile = null;
    }

    function switchCustomizeTab(tab) {
      _customizeTab = tab;
      document.getElementById('customizePanelColor').style.display = tab === 'color' ? '' : 'none';
      document.getElementById('customizePanelImage').style.display = tab === 'image' ? '' : 'none';
      document.getElementById('tabColorBtn').className = tab === 'color' ? 'btn btn-primary' : 'btn btn-outline';
      document.getElementById('tabImageBtn').className = tab === 'image' ? 'btn btn-primary' : 'btn btn-outline';
      updateCustomizePreview();
    }

    function toggleGradient() {
      document.getElementById('hColor2Wrap').style.display = document.getElementById('hGradient').checked ? '' : 'none';
      updateCustomizePreview();
    }

    function updateCustomizePreview() {
      const preview = document.getElementById('customizePreview');
      if (_customizeTab === 'color') {
        const c1 = document.getElementById('hColor').value;
        const useGrad = document.getElementById('hGradient').checked;
        const c2 = document.getElementById('hColor2').value;
        preview.style.background = useGrad
          ? `linear-gradient(135deg, ${c1}, ${c2})`
          : `linear-gradient(135deg, ${c1}, ${c1}88)`;
      } else {
        const blend = document.getElementById('hBlendColor').value + 'bb';
        const imgSrc = _newImageFile ? (window._previewObjectUrl || URL.createObjectURL(_newImageFile))
                     : (_removeImage ? null : (_INIT_IMAGE || null));
        preview.style.background = imgSrc
          ? `linear-gradient(${blend},${blend}), url('${imgSrc}') center/cover no-repeat`
          : document.getElementById('hBlendColor').value;
      }
    }

    function onImageSelected() {
      const file = document.getElementById('hImageInput').files[0];
      if (!file) return;
      _newImageFile = file; _removeImage = false;
      document.getElementById('imageFilename').textContent = file.name;
      document.getElementById('removeImageBtn').style.display = '';
      // Preview local inmediata: libera la URL anterior si existía
      if (window._previewObjectUrl) URL.revokeObjectURL(window._previewObjectUrl);
      window._previewObjectUrl = URL.createObjectURL(file);
      updateCustomizePreview();
    }

    function removeHeaderImage() {
      _newImageFile = null; _removeImage = true;
      document.getElementById('hImageInput').value = '';
      document.getElementById('imageFilename').textContent = '';
      document.getElementById('removeImageBtn').style.display = 'none';
      updateCustomizePreview();
    }

    async function saveCustomize() {
      const btn     = document.getElementById('customizeSaveBtn');
      const errEl   = document.getElementById('customizeError');
      const overlay = document.getElementById('customizePreviewOverlay');
      errEl.classList.remove('show');
      btn.disabled = true;
      overlay.classList.add('show');

      const fd = new FormData();
      fd.append('mode', _customizeTab);
      if (_customizeTab === 'color') {
        fd.append('color', document.getElementById('hColor').value);
        if (document.getElementById('hGradient').checked) fd.append('color2', document.getElementById('hColor2').value);
      } else {
        fd.append('color', document.getElementById('hBlendColor').value);
        if (_newImageFile) fd.append('image', _newImageFile);
        else if (_removeImage) fd.append('removeImage', 'true');
      }
      const res = await fetch(`/courses/${COURSE_ID}/customize`, { method: 'POST', body: fd });
      overlay.classList.remove('show');
      if (window._previewObjectUrl) { URL.revokeObjectURL(window._previewObjectUrl); window._previewObjectUrl = null; }
      if (res.ok) { location.reload(); return; }
      const d = await res.json();
      errEl.textContent = d.error || 'Error al guardar';
      errEl.classList.add('show');
      btn.disabled = false;
    }

    function renderSwatches(containerId, inputId) {
      const el = document.getElementById(containerId);
      PRESET_COLORS.forEach(c => {
        const b = document.createElement('button');
        b.type = 'button';
        b.title = c;
        b.style.cssText = `width:22px;height:22px;border-radius:50%;background:${c};border:2px solid transparent;cursor:pointer;flex-shrink:0;transition:transform .1s,border-color .1s`;
        b.onclick = () => { document.getElementById(inputId).value = c; updateCustomizePreview(); };
        b.onmouseover = () => { b.style.transform = 'scale(1.25)'; b.style.borderColor = 'white'; };
        b.onmouseout  = () => { b.style.transform = ''; b.style.borderColor = 'transparent'; };
        el.appendChild(b);
      });
    }
    renderSwatches('colorSwatches', 'hColor');
    renderSwatches('color2Swatches', 'hColor2');
    renderSwatches('blendSwatches', 'hBlendColor');
  </script>
  <% } %>

  <% if (locals.manageTeachers) { %>
  <script>
    // Gestión de docentes desde la solapa Personas (solo admin/superadmin). Pega contra las
    // rutas ya existentes de /admin/courses/:id — no hay endpoints nuevos para esto.
    const TEACHER_MODAL = {
      coteacher: {
        icon:  'person_add',
        title: 'Agregar suplente',
        help:  'El suplente tiene los mismos permisos que el titular sobre esta materia: crear actividades, calificar y gestionar alumnos.',
        url:   '/admin/courses/<%= course._id %>/co-teachers',
      },
      owner: {
        icon:  'swap_horiz',
        title: 'Cambiar docente titular',
        help:  'El docente que elijas pasa a ser el titular. El titular actual pierde el acceso a esta materia — si querés que lo conserve, agregalo como suplente antes de cambiarlo.',
        url:   '/admin/courses/<%= course._id %>/assign-teacher',
      },
    };
    let _teacherModalMode = 'coteacher';

    function openTeacherModal(mode) {
      _teacherModalMode = mode;
      const cfg = TEACHER_MODAL[mode];
      document.getElementById('teacherModalIcon').textContent  = cfg.icon;
      document.getElementById('teacherModalTitle').textContent = cfg.title;
      document.getElementById('teacherModalHelp').textContent  = cfg.help;
      document.getElementById('teacherModalSelect').value = '';
      const err = document.getElementById('teacherModalError');
      err.textContent = '';
      err.classList.remove('show');
      document.getElementById('teacherModal').classList.add('show');
    }
    function openAddTeacherModal()  { openTeacherModal('coteacher'); }
    function openChangeOwnerModal() { openTeacherModal('owner'); }

    function closeTeacherModal() {
      document.getElementById('teacherModal').classList.remove('show');
    }
    document.getElementById('teacherModal').addEventListener('click', function (e) {
      if (e.target === this) closeTeacherModal();
    });

    async function submitTeacherModal() {
      const teacherId = document.getElementById('teacherModalSelect').value;
      const errEl = document.getElementById('teacherModalError');
      errEl.classList.remove('show');
      if (!teacherId) {
        errEl.textContent = 'Elegí un docente.';
        errEl.classList.add('show');
        return;
      }
      const btn = document.getElementById('teacherModalConfirm');
      btn.disabled = true;
      try {
        const res  = await fetch(TEACHER_MODAL[_teacherModalMode].url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ teacherId }),
        });
        const data = await res.json();
        if (!res.ok) {
          errEl.textContent = data.error || 'No se pudo guardar';
          errEl.classList.add('show');
          btn.disabled = false;
          return;
        }
        window.location.reload();
      } catch {
        errEl.textContent = 'Error de conexión';
        errEl.classList.add('show');
        btn.disabled = false;
      }
    }

    // Quitar suplente — delegado, porque las filas se re-renderizan al recargar.
    document.getElementById('peopleTab').addEventListener('click', async (e) => {
      const btn = e.target.closest('.btn-remove-coteacher');
      if (!btn) return;
      const { teacherId, teacherName } = btn.dataset;
      if (!confirm(`¿Quitar a ${teacherName} como suplente de esta materia? Pierde el acceso a las actividades y calificaciones, pero lo que ya cargó queda en la materia.`)) return;

      btn.disabled = true;
      try {
        const res  = await fetch(`/admin/courses/<%= course._id %>/co-teachers/${teacherId}/delete`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) {
          alert(data.error || 'No se pudo quitar el suplente');
          btn.disabled = false;
          return;
        }
        window.location.reload();
      } catch {
        alert('Error de conexión');
        btn.disabled = false;
      }
    });
  </script>
  <% } %>
</body>
</html>
