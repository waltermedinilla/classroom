<%# Cabeza común del panel Taller. Recibe `titulo`. El header lo incluye cada vista, junto con
    el footer: van de a pares (tests/unit/movil.test.js). %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Talleres - Classroom</title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .tl-caja { background:var(--surface, #fff); border:1px solid var(--border, #dadce0); border-radius:12px; padding:14px 16px; margin-bottom:16px; }
    .tl-caja h2 { font-size:16px; margin:0 0 8px; }
    .tl-barra { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }
    .tl-barra h1 { font-size:20px; margin:0; flex:1 1 auto; }
    .tl-btn { display:inline-flex; align-items:center; gap:4px; padding:6px 12px; border:1px solid var(--border, #dadce0); border-radius:18px; background:var(--surface, #fff); color:inherit; text-decoration:none; font-size:13px; cursor:pointer; }
    .tl-btn.on { background:#e8f0fe; border-color:#c6dafc; color:#174ea6; }
    .tl-tabla { border-collapse:collapse; width:100%; font-size:13px; }
    .tl-tabla th { text-align:left; font-weight:600; color:var(--text-secondary, #5f6368); padding:8px; border-bottom:1px solid var(--border, #dadce0); }
    .tl-tabla td { padding:8px; border-bottom:1px solid var(--border-light, #f1f3f4); vertical-align:top; }
    .tl-ayuda { font-size:12.5px; color:var(--text-secondary, #5f6368); }
    .tl-chip { display:inline-block; font-size:11.5px; font-weight:600; padding:2px 8px; border-radius:10px; white-space:nowrap; }
    .tl-chip.actividad { background:#e6f4ea; color:#137333; }
    .tl-chip.ingreso { background:#e8f0fe; color:#174ea6; }
    .tl-chip.sinRegistro { background:#f1f3f4; color:#5f6368; }
    .tl-chip.clase { background:#fef7e0; color:#8a5300; }
    .tl-num { font-variant-numeric:tabular-nums; }
    .tl-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:10px; }
    .tl-div { border:1px solid var(--border, #dadce0); border-radius:10px; padding:10px 12px; font-size:13px; background:var(--surface, #fff); }
    .tl-div b { display:block; margin-bottom:4px; }
  </style>
</head>
<body>
