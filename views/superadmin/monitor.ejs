<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitor - Superadmin</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .monitor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .metric-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .metric-icon {
      font-size: 28px;
      margin-bottom: 4px;
      color: var(--text-secondary);
    }
    .metric-value {
      font-size: 32px;
      font-weight: 800;
      line-height: 1;
      color: var(--text);
    }
    .metric-label {
      font-size: 12px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: .5px;
      font-weight: 600;
    }
    .metric-sub {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 2px;
    }
    .bar-track {
      height: 8px;
      background: var(--border);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 8px;
    }
    .bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width .6s ease;
    }
    .status-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 4px;
    }
    .status-dot.live {
      animation: pulse-dot 1.6s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50%      { opacity: .35; }
    }
    .role-breakdown {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 10px;
      margin-top: 4px;
      font-size: 12px;
      color: var(--text-secondary);
    }
    .net-rate {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .net-sparkline {
      width: 100%;
      height: 32px;
      margin-top: 8px;
    }
    .net-unavailable {
      font-size: 12px;
      color: var(--text-hint);
      margin-top: 4px;
    }
    .refresh-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .section-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: .6px;
      margin: 24px 0 10px;
    }
    .metric-card-click { cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .metric-card-click:hover,
    .metric-card-click:focus-visible { border-color: var(--primary); box-shadow: var(--shadow-md, var(--shadow-sm)); }

    /* ── Gráfico de rate limit (fase 2 de specs/monitor-ratelimit.spec.md) ── */
    .rl-chart-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .rl-rangos { display: flex; gap: 4px; }
    .rl-rango {
      font-size: 11px; font-weight: 600; padding: 3px 10px; cursor: pointer;
      border: 1px solid var(--border, #dadce0); border-radius: 12px;
      background: transparent; color: var(--text-secondary);
    }
    .rl-rango:hover { border-color: #9334e6; color: #9334e6; }
    .rl-rango.activo { background: #9334e6; border-color: #9334e6; color: #fff; }
    .rl-chart { width: 100%; height: 90px; display: block; margin-top: 10px; overflow: visible; }
    .rl-eje {
      display: flex; justify-content: space-between;
      font-size: 10px; color: var(--text-hint); margin-top: 2px;
    }
    /* align-items:flex-end para que las barras crezcan desde el piso */
    .rl-barras { display: flex; align-items: flex-end; gap: 1px; height: 26px; margin-top: 6px; }
    .rl-barras > div { flex: 1 1 0; min-width: 0; border-radius: 1px 1px 0 0; }
    .rl-leyenda {
      display: flex; gap: 14px; flex-wrap: wrap;
      font-size: 11px; color: var(--text-secondary); margin-top: 10px;
    }
    .rl-leyenda i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 4px; }

    @media (max-width: 600px) {
      .monitor-grid { grid-template-columns: 1fr 1fr; }
      .metric-value { font-size: 26px; }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="main-content main-content-ancho">
    <%- include('../partials/superadmin-nav') %>

    <div class="section-header" style="margin-bottom:16px">
      <span class="material-symbols-outlined section-icon" style="color:#1a73e8">monitor_heart</span>
      <h2 style="margin:0">Monitor del Sistema</h2>
    </div>

    <div class="refresh-bar">
      <span class="status-dot" id="statusDot" style="background:#34a853"></span>
      <span style="font-size:13px;color:var(--text-secondary)">Actualizado: <strong id="lastUpdated">—</strong></span>
      <button class="btn btn-outline" style="font-size:12px;padding:4px 14px" onclick="fetchStats()">
        <span class="material-symbols-outlined" style="font-size:15px;vertical-align:middle">refresh</span>
        Actualizar
      </button>
      <span style="font-size:12px;color:var(--text-secondary);margin-left:auto" id="countdown"></span>
    </div>

    <!-- Usuarios -->
    <div class="section-title">Usuarios</div>
    <div class="monitor-grid">
      <div class="metric-card" style="border-top:3px solid #34a853">
        <span class="material-symbols-outlined metric-icon" style="color:#34a853">sensors</span>
        <div class="metric-label"><span class="status-dot live" style="background:#34a853"></span>Conectados ahora</div>
        <div class="metric-value" id="m-now">—</div>
        <div class="metric-sub">últimos 2 minutos</div>
        <div class="role-breakdown" id="m-now-roles">—</div>
      </div>
      <div class="metric-card" style="border-top:3px solid #1a73e8">
        <span class="material-symbols-outlined metric-icon" style="color:#1a73e8">group</span>
        <div class="metric-label">Activos (15 min)</div>
        <div class="metric-value" id="m-active">—</div>
        <div class="metric-sub" id="m-active-pct">—</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon">people</span>
        <div class="metric-label">Total usuarios</div>
        <div class="metric-value" id="m-total">—</div>
        <div class="metric-sub">registrados</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon">domain</span>
        <div class="metric-label">Escuelas</div>
        <div class="metric-value" id="m-schools">—</div>
        <div class="metric-sub">en la plataforma</div>
      </div>
    </div>

    <!-- Red -->
    <div class="section-title">Ancho de banda</div>
    <div class="monitor-grid">
      <div class="metric-card" style="border-top:3px solid #1a73e8">
        <span class="material-symbols-outlined metric-icon" style="color:#1a73e8">arrow_downward</span>
        <div class="metric-label">Descarga (entrante)</div>
        <div class="net-rate">
          <div class="metric-value" id="m-net-rx">—</div>
        </div>
        <div class="metric-sub" id="m-net-rx-total">—</div>
        <svg class="net-sparkline" viewBox="0 0 120 32" preserveAspectRatio="none">
          <polyline id="m-net-rx-spark" points="" fill="none" stroke="#1a73e8" stroke-width="2" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
      <div class="metric-card" style="border-top:3px solid #ea4335">
        <span class="material-symbols-outlined metric-icon" style="color:#ea4335">arrow_upward</span>
        <div class="metric-label">Subida (saliente)</div>
        <div class="net-rate">
          <div class="metric-value" id="m-net-tx">—</div>
        </div>
        <div class="metric-sub" id="m-net-tx-total">—</div>
        <svg class="net-sparkline" viewBox="0 0 120 32" preserveAspectRatio="none">
          <polyline id="m-net-tx-spark" points="" fill="none" stroke="#ea4335" stroke-width="2" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
    </div>

    <!-- Rate limit -->
    <div class="section-title">Rate limit</div>
    <div class="monitor-grid">
      <div class="metric-card" style="border-top:3px solid #9334e6">
        <span class="material-symbols-outlined metric-icon" style="color:#9334e6">speed</span>
        <div class="metric-label">Cupo de esta IP</div>
        <div style="display:flex;align-items:baseline;gap:4px">
          <div class="metric-value" style="font-size:26px" id="m-rl-usado">—</div>
          <span style="font-size:14px;color:var(--text-secondary)" id="m-rl-limite"> / —</span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" id="m-rl-bar" style="width:0%;background:#9334e6"></div>
        </div>
        <div class="metric-sub" id="m-rl-reset">—</div>
      </div>

      <div class="metric-card" style="border-top:3px solid #ea4335">
        <span class="material-symbols-outlined metric-icon" style="color:#ea4335">block</span>
        <div class="metric-label" id="m-rl-429-label">Bloqueos 429</div>
        <div class="metric-value" id="m-rl-429">—</div>
        <div class="metric-sub" id="m-rl-429-sub">—</div>
      </div>

      <div class="metric-card" style="grid-column: span 2">
        <span class="material-symbols-outlined metric-icon" style="color:#ea8600">trending_up</span>
        <div class="metric-label" id="m-rl-pico-label">Pico de consumo</div>
        <div class="metric-value" style="font-size:26px" id="m-rl-pico">—</div>
        <div class="metric-sub" id="m-rl-pico-ip">—</div>
      </div>
    </div>

    <!-- Consumo en el tiempo (fase 2) -->
    <div class="monitor-grid" style="margin-top:14px">
      <div class="metric-card" style="grid-column: 1 / -1">
        <div class="rl-chart-head">
          <div>
            <span class="material-symbols-outlined metric-icon" style="font-size:20px;color:#9334e6">show_chart</span>
            <span class="metric-label">Consumo del cupo en el tiempo</span>
          </div>
          <div class="rl-rangos" id="m-rl-rangos">
            <button class="rl-rango activo" data-rango="1h">1h</button>
            <button class="rl-rango" data-rango="6h">6h</button>
            <button class="rl-rango" data-rango="24h">24h</button>
            <button class="rl-rango" data-rango="7d">7d</button>
          </div>
        </div>

        <!-- Ocupación del cupo. preserveAspectRatio="none" estira el trazo con el ancho de
             la tarjeta; vector-effect mantiene la línea de 2px (mismo truco que las
             sparklines de Ancho de banda, más arriba en este archivo). -->
        <svg class="rl-chart" viewBox="0 0 300 90" preserveAspectRatio="none" role="img"
             aria-label="Consumo del cupo del rate limit en el tiempo">
          <line id="m-rl-techo" x1="0" x2="300" y1="0" y2="0"
                stroke="#ea4335" stroke-width="1" stroke-dasharray="4 3" opacity=".65"
                vector-effect="non-scaling-stroke"/>
          <path     id="m-rl-area"  d=""      fill="#9334e6" fill-opacity=".16"/>
          <polyline id="m-rl-linea" points="" fill="none" stroke="#9334e6" stroke-width="2"
                    vector-effect="non-scaling-stroke"/>
        </svg>
        <div class="rl-eje" id="m-rl-eje"></div>

        <div class="metric-label" style="margin-top:14px">Peticiones por intervalo</div>
        <div class="rl-barras" id="m-rl-barras"></div>

        <div class="rl-leyenda">
          <span><i style="background:#9334e6"></i> Cupo consumido</span>
          <span><i style="background:#ea4335"></i> Techo (<span id="m-rl-techo-val">—</span>)</span>
          <span><i style="background:var(--text-hint);opacity:.45"></i> Sin datos</span>
        </div>

        <!-- Sin estas aclaraciones el número engaña: ver specs/monitor-ratelimit.spec.md -->
        <div style="font-size:11px;color:var(--text-hint);margin-top:12px;line-height:1.5">
          No incluye estáticos ni el polling de la sala en vivo (están exentos del limiter),
          así que el tráfico real es mayor que esta curva.<br>
          El total suma los <strong id="m-rl-workers">—</strong> workers de PM2, cada uno con
          su propio cupo: el techo efectivo real es esa cantidad de veces el valor dibujado.
          Y el monitor, refrescando cada 5 s, consume ~180 peticiones por cada 15 minutos con
          la pestaña abierta.
        </div>
      </div>
    </div>

    <!-- Memoria -->
    <div class="section-title">Memoria del servidor</div>
    <div class="monitor-grid">
      <div class="metric-card" style="grid-column: span 2">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <span class="material-symbols-outlined metric-icon" style="font-size:22px">memory</span>
            <span class="metric-label">RAM del sistema</span>
          </div>
          <div style="text-align:right">
            <span class="metric-value" style="font-size:24px" id="m-ram-used">—</span>
            <span style="font-size:14px;color:var(--text-secondary)" id="m-ram-total"> / — MB</span>
          </div>
        </div>
        <div class="bar-track">
          <div class="bar-fill" id="m-ram-bar" style="width:0%;background:#1a73e8"></div>
        </div>
        <div class="metric-sub" id="m-ram-pct">—</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon" style="color:#9334e6">javascript</span>
        <div class="metric-label">Heap Node.js</div>
        <div class="metric-value" style="font-size:24px" id="m-heap-used">—</div>
        <div class="metric-sub" id="m-heap-total">— MB total · — MB RSS</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon" style="color:#ea4335">storage</span>
        <div class="metric-label">RAM libre</div>
        <div class="metric-value" style="font-size:24px" id="m-ram-free">—</div>
        <div class="metric-sub">MB disponibles</div>
      </div>
    </div>

    <!-- Almacenamiento -->
    <div class="section-title">Almacenamiento</div>
    <div class="monitor-grid" id="m-disk-section">
      <div class="metric-card" style="grid-column: span 2">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <span class="material-symbols-outlined metric-icon" style="font-size:22px;color:#1a73e8">hard_drive</span>
            <span class="metric-label">Disco del servidor</span>
          </div>
          <div style="text-align:right">
            <span class="metric-value" style="font-size:24px" id="m-disk-used">—</span>
            <span style="font-size:14px;color:var(--text-secondary)" id="m-disk-total"> / —</span>
          </div>
        </div>
        <div class="bar-track">
          <div class="bar-fill" id="m-disk-bar" style="width:0%;background:#1a73e8"></div>
        </div>
        <div class="metric-sub" id="m-disk-pct">—</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon" style="color:#34a853">check_circle</span>
        <div class="metric-label">Espacio libre</div>
        <div class="metric-value" style="font-size:24px" id="m-disk-free">—</div>
        <div class="metric-sub">disponible para la app</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon" style="color:#9334e6">folder</span>
        <div class="metric-label">Ocupa esta app</div>
        <div class="metric-value" style="font-size:24px" id="m-app-total">—</div>
        <div class="metric-sub" id="m-app-fresh">—</div>
      </div>
      <div class="metric-card metric-card-click" style="grid-column: span 2"
           role="button" tabindex="0"
           onclick="bkcAbrir()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();bkcAbrir()}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div>
            <span class="material-symbols-outlined metric-icon" style="color:#ea8600">inventory_2</span>
            <div class="metric-label">Desglose de lo guardado</div>
          </div>
          <span style="font-size:11.5px;color:var(--primary);display:flex;align-items:center;gap:2px">
            Ver detalle y comprimir
            <span class="material-symbols-outlined" style="font-size:15px">chevron_right</span>
          </span>
        </div>
        <div id="m-disk-breakdown" style="margin-top:10px;display:flex;flex-direction:column;gap:8px">
          <div class="metric-sub">—</div>
        </div>
      </div>
    </div>

    <!-- CPU / Carga -->
    <div class="section-title">Carga del sistema</div>
    <div class="monitor-grid">
      <div class="metric-card" style="grid-column: span 2">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <span class="material-symbols-outlined metric-icon" style="font-size:22px;color:#ea8600">speed</span>
            <span class="metric-label">Load average (1 min)</span>
          </div>
          <div style="text-align:right">
            <span class="metric-value" style="font-size:24px" id="m-load1">—</span>
            <span style="font-size:13px;color:var(--text-secondary)" id="m-load-cpus"> / — CPUs</span>
          </div>
        </div>
        <div class="bar-track">
          <div class="bar-fill" id="m-load-bar" style="width:0%;background:#ea8600"></div>
        </div>
        <div class="metric-sub" id="m-load-pct">—</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon">query_stats</span>
        <div class="metric-label">Load avg 5 min</div>
        <div class="metric-value" style="font-size:24px" id="m-load5">—</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon">history</span>
        <div class="metric-label">Load avg 15 min</div>
        <div class="metric-value" style="font-size:24px" id="m-load15">—</div>
      </div>
    </div>

    <!-- Uptime -->
    <div class="section-title">Tiempo activo</div>
    <div class="monitor-grid">
      <div class="metric-card" style="border-top:3px solid #34a853">
        <span class="material-symbols-outlined metric-icon" style="color:#34a853">electric_bolt</span>
        <div class="metric-label">Proceso Node.js</div>
        <div class="metric-value" style="font-size:22px" id="m-uptime-proc">—</div>
        <div class="metric-sub">desde el último reinicio</div>
      </div>
      <div class="metric-card">
        <span class="material-symbols-outlined metric-icon">dns</span>
        <div class="metric-label">Sistema operativo</div>
        <div class="metric-value" style="font-size:22px" id="m-uptime-sys">—</div>
        <div class="metric-sub">uptime del servidor</div>
      </div>
    </div>

  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/backup-compress-modal') %>

  <!-- Matemática del gráfico de rate limit. Va aparte para poder testearla con node:test
       (tests/unit/ratelimitChart.test.js); las funciones quedan como globales. -->
  <script src="/js/ratelimit-chart.js"></script>
  <script>
    const REFRESH_SECONDS = 5; // más frecuente que el resto del panel: bajo costo y da sensación de "tiempo real"
    let countdown = REFRESH_SECONDS;
    let timer;

    const ROLE_LABELS = {
      superadmin: 'Superadmin', admin: 'Admin', directivo: 'Directivos',
      teacher: 'Docentes', preceptor: 'Preceptores', jefe: 'Jefes de Sección', soe: 'SOE', student: 'Alumnos',
    };
    const SPARK_MAX_POINTS = 30;
    const rxHistory = [];
    const txHistory = [];

    function formatBytes(mb) {
      if (mb >= 1024) return (mb / 1024).toFixed(1) + ' GB';
      return mb + ' MB';
    }

    function formatRate(bytesPerSec) {
      if (bytesPerSec >= 1024 * 1024) return (bytesPerSec / 1024 / 1024).toFixed(2) + ' MB/s';
      if (bytesPerSec >= 1024)        return (bytesPerSec / 1024).toFixed(1) + ' KB/s';
      return bytesPerSec + ' B/s';
    }

    function formatBytesTotal(bytes) {
      const gb = bytes / 1024 / 1024 / 1024;
      if (gb >= 1) return gb.toFixed(2) + ' GB acumulados';
      return (bytes / 1024 / 1024).toFixed(1) + ' MB acumulados';
    }

    // Bytes crudos → unidad legible. El servicio de disco devuelve todo en bytes;
    // formatBytes() de arriba espera MB, así que no sirve acá.
    function formatSize(bytes) {
      if (!bytes && bytes !== 0) return '—';
      const gb = bytes / 1024 / 1024 / 1024;
      if (gb >= 1)  return gb.toFixed(2) + ' GB';
      const mb = bytes / 1024 / 1024;
      if (mb >= 1)  return mb.toFixed(1) + ' MB';
      return Math.round(bytes / 1024) + ' KB';
    }

    function pushHistory(arr, value) {
      arr.push(value);
      if (arr.length > SPARK_MAX_POINTS) arr.shift();
    }

    function sparklinePoints(history, width, height) {
      if (history.length < 2) return '';
      const max  = Math.max(...history, 1);
      const step = width / (history.length - 1);
      return history.map((v, i) => `${(i * step).toFixed(1)},${(height - (v / max) * height).toFixed(1)}`).join(' ');
    }

    function formatUptime(seconds) {
      const d = Math.floor(seconds / 86400);
      const h = Math.floor((seconds % 86400) / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      if (d > 0) return `${d}d ${h}h ${m}m`;
      if (h > 0) return `${h}h ${m}m`;
      return `${m}m`;
    }

    function barColor(pct) {
      if (pct < 60) return '#34a853';
      if (pct < 85) return '#ea8600';
      return '#ea4335';
    }

    function setText(id, val) {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    }

    // "en 12 min" / "en 45 s". El reset del limiter es lo que responde la pregunta
    // "¿cuándo se me libera el cupo?", que es lo que uno quiere saber cuando ve un 429.
    function formatReset(seg) {
      if (seg == null) return 'sin datos de reinicio';
      if (seg >= 60)   return `se reinicia en ${Math.round(seg / 60)} min`;
      return `se reinicia en ${seg} s`;
    }

    // Rango elegido para el gráfico. Los botones solo cambian esto y piden de nuevo.
    let rlRango = '1h';
    const RL_ETIQUETA = { '1h': 'la última hora', '6h': 'las últimas 6 horas', '24h': 'las últimas 24 horas', '7d': 'los últimos 7 días' };

    // Ancho/alto del viewBox del <svg>. Las coordenadas se calculan en este espacio y el
    // preserveAspectRatio="none" las estira al ancho real de la tarjeta.
    const RL_W = 300, RL_H = 90;

    function dibujarGrafico(data) {
      const { rellenarBuckets, topeEjeY, puntosSerie, pathArea, alturasTrafico, etiquetasEjeX } = window;

      // Se rellenan los buckets sin muestra ANTES de dibujar: si no, un hueco de tres horas
      // quedaría pegado al punto anterior y la curva mentiría sobre cuándo pasó cada cosa.
      const serie = rellenarBuckets(data.serie, data.desde, data.hasta, data.bucketMin);
      const tope  = topeEjeY(serie, (data.resumen && data.resumen.limite) || (data.ahora && data.ahora.limite) || 0);
      const opts  = { ancho: RL_W, alto: RL_H, tope };

      document.getElementById('m-rl-linea').setAttribute('points', puntosSerie(serie, 'picoUsado', opts));
      document.getElementById('m-rl-area').setAttribute('d', pathArea(serie, 'picoUsado', opts));

      // Techo: solo se dibuja si el límite entra en la escala. Si el pico se pasó del máximo
      // configurado (posible: el cupo es por worker), la línea baja dentro del recuadro sola.
      const limite = (data.resumen && data.resumen.limite) || (data.ahora && data.ahora.limite) || 0;
      const yTecho = tope > 0 ? RL_H - Math.min(1, limite / tope) * RL_H : 0;
      const techo  = document.getElementById('m-rl-techo');
      techo.setAttribute('y1', yTecho.toFixed(1));
      techo.setAttribute('y2', yTecho.toFixed(1));
      setText('m-rl-techo-val', limite ? limite.toLocaleString('es-AR') : '—');

      // Barras de tráfico, con su propia escala (ver alturasTrafico).
      // El gap se saca cuando hay muchas barras: en 7d son 168 y en un teléfono cada una
      // mide 0,8 px, así que el separador de 1 px terminaba siendo más ancho que el dato.
      const cont = document.getElementById('m-rl-barras');
      cont.style.gap = serie.length > 80 ? '0' : '1px';
      cont.innerHTML = alturasTrafico(serie).map(b => {
        const alto  = Math.max(b.alto * 100, b.vacio ? 0 : 2); // mínimo visible si hubo tráfico
        const color = b.bloqueado ? '#ea4335' : (b.vacio ? 'var(--text-hint)' : '#1a73e8');
        const op    = b.vacio ? '.2' : '.75';
        return `<div style="height:${alto.toFixed(1)}%;background:${color};opacity:${op}"></div>`;
      }).join('');

      document.getElementById('m-rl-eje').innerHTML =
        etiquetasEjeX(serie, data.rango).map(m => `<span>${m.label}</span>`).join('');
    }

    async function fetchRateLimit() {
      try {
        const res  = await fetch('/superadmin/monitor/ratelimit?rango=' + rlRango);
        const data = await res.json();

        if (data.ahora) {
          const { usado, limite, resetEnSeg } = data.ahora;
          const pct = limite > 0 ? Math.round((usado / limite) * 100) : 0;
          setText('m-rl-usado',  usado.toLocaleString('es-AR'));
          setText('m-rl-limite', ' / ' + limite.toLocaleString('es-AR'));
          setText('m-rl-reset',  `${pct}% del cupo · ${formatReset(resetEnSeg)}`);
          const bar = document.getElementById('m-rl-bar');
          bar.style.width      = Math.min(100, pct) + '%';
          bar.style.background = barColor(pct);
        } else {
          setText('m-rl-reset', 'Esta ruta está exenta del limiter');
        }

        const r = data.resumen || {};
        setText('m-rl-429', (r.bloqueadasTotal || 0).toLocaleString('es-AR'));
        setText('m-rl-429-sub', r.ultimoBloqueo
          ? 'último: ' + new Date(r.ultimoBloqueo).toLocaleString('es-AR')
          : 'ninguno en ' + RL_ETIQUETA[data.rango]);
        setText('m-rl-429-label', 'Bloqueos 429 (' + RL_ETIQUETA[data.rango] + ')');
        setText('m-rl-pico-label', 'Pico de consumo en ' + RL_ETIQUETA[data.rango]);
        document.getElementById('m-rl-429').style.color =
          (r.bloqueadasTotal || 0) > 0 ? '#ea4335' : 'var(--secondary)';

        // El pico es "qué tan cerca del techo llegó UNA IP", no la suma de todas: por eso
        // se compara contra el límite de un worker y no contra el total del cluster.
        const pico = r.picoMaximo || 0;
        const tope = r.limite || (data.ahora && data.ahora.limite) || 0;
        setText('m-rl-pico', tope > 0
          ? `${pico.toLocaleString('es-AR')} (${Math.round((pico / tope) * 100)}% del cupo)`
          : pico.toLocaleString('es-AR'));
        setText('m-rl-pico-ip', r.picoIp
          ? `IP que lo provocó: ${r.picoIp}`
          : (pico > 0 ? 'sin IP registrada' : 'sin actividad registrada todavía'));
        setText('m-rl-workers', r.workers || '—');

        dibujarGrafico(data);
      } catch {
        setText('m-rl-reset', 'No se pudo leer el consumo del rate limit');
      }
    }

    // Botones de rango: cambian la ventana y piden de nuevo, sin esperar al refresco de 5 s.
    document.getElementById('m-rl-rangos').addEventListener('click', (e) => {
      const btn = e.target.closest('.rl-rango');
      if (!btn) return;
      rlRango = btn.dataset.rango;
      document.querySelectorAll('.rl-rango').forEach(b => b.classList.toggle('activo', b === btn));
      fetchRateLimit();
    });

    async function fetchStats() {
      document.getElementById('statusDot').style.background = '#ea8600';
      try {
        const res  = await fetch('/superadmin/monitor/stats');
        const data = await res.json();

        // Usuarios
        setText('m-now',    data.users.now);
        setText('m-active', data.users.active);
        setText('m-total',  data.users.total);
        const pct = data.users.total > 0
          ? Math.round((data.users.active / data.users.total) * 100)
          : 0;
        setText('m-active-pct', `${pct}% del total en sesión`);
        setText('m-schools', data.schools);

        const roleEntries = Object.entries(data.users.byRole || {});
        setText('m-now-roles', roleEntries.length
          ? roleEntries.map(([role, count]) => `${ROLE_LABELS[role] || role}: ${count}`).join(' · ')
          : 'nadie conectado');

        // Red — ancho de banda
        if (data.network && data.network.available) {
          pushHistory(rxHistory, data.network.rxRate);
          pushHistory(txHistory, data.network.txRate);
          setText('m-net-rx', formatRate(data.network.rxRate));
          setText('m-net-tx', formatRate(data.network.txRate));
          setText('m-net-rx-total', formatBytesTotal(data.network.rxTotal));
          setText('m-net-tx-total', formatBytesTotal(data.network.txTotal));
          document.getElementById('m-net-rx-spark').setAttribute('points', sparklinePoints(rxHistory, 120, 32));
          document.getElementById('m-net-tx-spark').setAttribute('points', sparklinePoints(txHistory, 120, 32));
        } else {
          setText('m-net-rx', 'N/D');
          setText('m-net-tx', 'N/D');
          setText('m-net-rx-total', 'No disponible en este sistema (requiere Linux)');
          setText('m-net-tx-total', 'No disponible en este sistema (requiere Linux)');
        }

        // RAM
        setText('m-ram-used',  formatBytes(data.memory.used));
        setText('m-ram-total', ' / ' + formatBytes(data.memory.total));
        setText('m-ram-free',  formatBytes(data.memory.free));
        setText('m-ram-pct',   `${data.memory.percent}% utilizada · ${data.memory.free} MB libres`);
        const ramBar = document.getElementById('m-ram-bar');
        ramBar.style.width   = data.memory.percent + '%';
        ramBar.style.background = barColor(data.memory.percent);

        // Heap
        setText('m-heap-used',  formatBytes(data.heap.used));
        setText('m-heap-total', `${data.heap.total} MB total · ${data.heap.rss} MB RSS`);

        // Almacenamiento
        if (data.disk) {
          const v = data.disk.volumen;
          if (v.disponible) {
            setText('m-disk-used',  formatSize(v.usado));
            setText('m-disk-total', ' / ' + formatSize(v.total));
            setText('m-disk-free',  formatSize(v.libre));
            setText('m-disk-pct',   `${v.porcentaje}% ocupado · ${formatSize(v.libre)} libres`);
            const diskBar = document.getElementById('m-disk-bar');
            diskBar.style.width      = v.porcentaje + '%';
            diskBar.style.background = barColor(v.porcentaje);
          } else {
            setText('m-disk-pct', 'No se pudo leer el espacio del volumen en este sistema');
          }

          setText('m-app-total', formatSize(data.disk.appTotal));
          // El desglose sale de un cache de 60s (escanear el árbol de archivos es caro),
          // así que se avisa la antigüedad en vez de fingir que es del segundo exacto.
          setText('m-app-fresh', data.disk.calculadoHace < 5
            ? 'recién calculado'
            : `calculado hace ${data.disk.calculadoHace}s`);

          // Desglose: cada carpeta + la base de datos, con barra proporcional al mayor
          const filas = data.disk.carpetas.map(c => ({
            label: c.label, bytes: c.bytes, extra: `${c.archivos} archivo${c.archivos === 1 ? '' : 's'}`,
          }));
          if (data.disk.db.disponible) {
            filas.push({
              label: 'Base de datos',
              bytes: data.disk.db.storage,
              extra: `${data.disk.db.documentos.toLocaleString('es-AR')} documentos · ${formatSize(data.disk.db.indices)} en índices`,
            });
          }
          const mayor = Math.max(...filas.map(f => f.bytes), 1);
          document.getElementById('m-disk-breakdown').innerHTML = filas.map(f => `
            <div>
              <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:3px">
                <span>${f.label}</span>
                <strong>${formatSize(f.bytes)}</strong>
              </div>
              <div class="bar-track" style="height:5px">
                <div class="bar-fill" style="width:${Math.round((f.bytes / mayor) * 100)}%;background:#9334e6"></div>
              </div>
              <div style="font-size:11px;color:var(--text-hint);margin-top:2px">${f.extra}</div>
            </div>
          `).join('');
        } else {
          // El endpoint devuelve disk:null si el cálculo falló; el resto del monitor sigue vivo
          setText('m-disk-pct', 'Datos de almacenamiento no disponibles');
        }

        // Load
        setText('m-load1',    data.load.avg1);
        setText('m-load5',    data.load.avg5);
        setText('m-load15',   data.load.avg15);
        setText('m-load-cpus', ` / ${data.load.cpus} CPUs`);
        setText('m-load-pct',  `${data.load.percent}% de uso estimado`);
        const loadBar = document.getElementById('m-load-bar');
        loadBar.style.width      = Math.min(100, data.load.percent) + '%';
        loadBar.style.background = barColor(data.load.percent);

        // Uptime
        setText('m-uptime-proc', formatUptime(data.uptime.process));
        setText('m-uptime-sys',  formatUptime(data.uptime.system));

        // Rate limit — va en su propio fetch para no ensanchar /monitor/stats, que se llama
        // cada 5 s y ya hace disco + varias queries. Si falla, deja los guiones y no rompe
        // el resto del monitor (mismo criterio que el bloque de almacenamiento).
        fetchRateLimit();

        // Timestamp
        const ts = new Date(data.timestamp);
        setText('lastUpdated', ts.toLocaleTimeString('es-AR'));

        document.getElementById('statusDot').style.background = '#34a853';
      } catch {
        document.getElementById('statusDot').style.background = '#ea4335';
      }

      // Reinicia el contador
      countdown = REFRESH_SECONDS;
    }

    function tick() {
      countdown--;
      setText('countdown', `Próxima actualización en ${countdown}s`);
      if (countdown <= 0) fetchStats();
    }

    // Mientras el modal de compresión está abierto, el refresco se detiene: la descarga
    // del backup puede durar minutos y son cientos de MB: no tiene sentido competirle por
    // el ancho de banda con una métrica que nadie está mirando.
    document.addEventListener('bkc:open', () => {
      clearInterval(timer);
      setText('countdown', 'Pausado');
    });
    document.addEventListener('bkc:close', () => {
      countdown = REFRESH_SECONDS;
      timer = setInterval(tick, 1000);
      fetchStats();
    });

    fetchStats();
    timer = setInterval(tick, 1000);
  </script>
</body>
</html>
