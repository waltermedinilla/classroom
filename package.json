{
  "name": "classroom-escuela",
  "version": "1.0.61",
  "description": "Google Classroom clone with Node.js, Express, MongoDB and vanilla JS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "pm2 start ecosystem.config.js",
    "prod:stop": "pm2 stop classroom",
    "prod:restart": "pm2 restart classroom",
    "prod:logs": "pm2 logs classroom",
    "prod:status": "pm2 status",
    "cleanup": "node cleanup-files.js",
    "cleanup:dry": "node cleanup-files.js --dry-run",
    "cleanup:rooms": "node cleanup-rooms.js",
    "cleanup:rooms:dry": "node cleanup-rooms.js --dry-run",
    "logs:subida": "node tools/ver-subida.js",
    "watchdog": "bash tools/watchdog.sh",
    "watchdog:ahora": "node tools/analizar-watchdog.js --ahora",
    "watchdog:informe": "node tools/analizar-watchdog.js",
    "watchdog:manana": "node tools/analizar-watchdog.js --manana",
    "funnel:guard": "node tools/funnel-guard.js",
    "funnel:estado": "node tools/funnel-guard.js --estado",
    "funnel:simular": "node tools/funnel-guard.js --simular",
    "funnel:reparar": "node tools/funnel-guard.js --forzar",
    "test:smoke": "node tests/smoke/run.js",
    "test:roles": "node tests/roles/check-roles.js",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:images": "node --test tests/images/*.test.js",
    "optimize:images": "node optimize-existing-images.js",
    "optimize:images:dry": "node optimize-existing-images.js --dry-run",
    "migrate:examen": "node migrate-examen-to-evaluacion.js",
    "migrate:examen:dry": "node migrate-examen-to-evaluacion.js --dry-run",
    "prepare": "husky || true"
  },
  "dependencies": {
    "basic-ftp": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.8.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "tar": "^7.5.21",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "nodemon": "^2.0.20"
  }
}
