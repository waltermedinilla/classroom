<%# Selector de período del panel Taller: Día / Semana / Mes, con anterior y siguiente.
    Recibe `ventana` (services/tallerAlcance.js ventanaDelPeriodo) y `base` ('/taller/jefes'). %>
<% const ir = (cambios) => { const q = new URLSearchParams({ periodo: ventana.periodo, fecha: ventana.fecha, ...cambios }); return base + '?' + q.toString(); };
   const [py, pm, pd] = ventana.inicio.split('-').map(Number);
   const tituloPeriodo = ventana.titulo || fmt.fechaLarga(new Date(Date.UTC(py, pm - 1, pd, 15))); %>
<div class="tl-barra" style="margin-bottom:6px">
  <div role="group" aria-label="Período" style="display:flex;gap:4px">
    <a class="tl-btn <%= ventana.periodo === 'dia' ? 'on' : '' %>" href="<%= ir({ periodo: 'dia' }) %>">Día</a>
    <a class="tl-btn <%= ventana.periodo === 'semana' ? 'on' : '' %>" href="<%= ir({ periodo: 'semana' }) %>">Semana</a>
    <a class="tl-btn <%= ventana.periodo === 'mes' ? 'on' : '' %>" href="<%= ir({ periodo: 'mes' }) %>">Mes</a>
  </div>
  <a class="tl-btn" href="<%= ir({ fecha: ventana.anterior }) %>" aria-label="Período anterior"><span class="material-symbols-outlined" style="font-size:18px">chevron_left</span></a>
  <b style="font-size:15px"><%= tituloPeriodo %></b>
  <% if (ventana.siguiente) { %><a class="tl-btn" href="<%= ir({ fecha: ventana.siguiente }) %>" aria-label="Período siguiente"><span class="material-symbols-outlined" style="font-size:18px">chevron_right</span></a><% } %>
  <% if (!ventana.esActual) { %><a class="tl-btn" href="<%= base %>?periodo=<%= ventana.periodo %>">Hoy</a><% } %>
  <form method="get" action="<%= base %>" style="display:flex;gap:4px;align-items:center;margin-left:auto">
    <input type="hidden" name="periodo" value="<%= ventana.periodo %>">
    <label class="tl-ayuda" for="tlFecha">Ir a</label>
    <input type="date" id="tlFecha" name="fecha" value="<%= ventana.fecha %>" class="tl-btn" style="padding:4px 8px" onchange="this.form.submit()">
  </form>
</div>
