<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ofrecer plantillas a escuelas - Superadmin - Classroom</title>
  <%- include('../../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Estilos específicos de esta vista — el resto viene de style.css */
    .assign-info {
      background: var(--bg); border-left: 3px solid var(--primary);
      padding: 12px 16px; border-radius: 8px;
      margin-bottom: 24px; font-size: 13px; color: var(--text-secondary);
    }
    .assign-info strong { color: var(--text); }
    .assign-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; margin-bottom: 20px;
      box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .assign-card-head {
      padding: 18px 22px; border-bottom: 1px solid var(--border);
      display: flex; align-items: flex-start; gap: 14px;
    }
    .assign-card-icon {
      width: 42px; height: 42px; flex-shrink: 0;
      background: var(--primary-light, #e8f0fe); border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: var(--primary);
    }
    .assign-card-icon .material-symbols-outlined { font-size: 22px; }
    .assign-card-head-main { flex: 1; min-width: 0; }
    .assign-card-title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .assign-card-title h3 { margin: 0; font-size: 17px; font-weight: 600; color: var(--text); }
    .assign-card-desc { margin: 4px 0 0; font-size: 13px; color: var(--text-secondary); }
    .assign-card-chips { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .assign-chip {
      font-size: 11px; padding: 2px 8px; border-radius: 10px;
      background: var(--bg); color: var(--text-secondary);
      display: inline-flex; align-items: center; gap: 4px;
    }
    .assign-chip .material-symbols-outlined { font-size: 13px; }
    .assign-schools { padding: 14px 22px 18px; }
    .assign-schools h4 {
      margin: 0 0 10px; font-size: 11px; font-weight: 600;
      color: var(--text-hint); text-transform: uppercase; letter-spacing: .5px;
    }
    .assign-school-list { display: flex; flex-direction: column; gap: 6px; }
    .assign-school-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px;
    }
    .assign-school-row .dot   { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .assign-school-row .color { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .assign-school-row .name  { flex: 1; font-size: 14px; font-weight: 500; color: var(--text); }
    .assign-status-label {
      font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 10px;
    }
    .assign-status-label.accepted { color: #137333; background: #e6f4ea; }
    .assign-status-label.offered  { color: #ea8600; background: #fff3e0; }
    .assign-status-label.rejected { color: #ea4335; background: #fce8e6; }
    .assign-status-label.none     { color: var(--text-hint); background: var(--bg); }
    .assign-resp-hint {
      font-size: 11px; color: var(--text-hint);
    }
    .assign-notice {
      margin: 0; padding: 12px 16px;
      background: #fff3e0; color: #7a4a00; border-radius: 8px; font-size: 13px;
    }
    @media (prefers-color-scheme: dark) {
      .assign-status-label.accepted { background: #1a3a22; color: #6fcf7a; }
      .assign-status-label.offered  { background: #3a2e0a; color: #f5c842; }
      .assign-status-label.rejected { background: #3a1e1c; color: #ea9d95; }
      .assign-notice                { background: #3a2e0a; color: #f5c842; }
    }
  </style>
</head>
<body>
  <%- include('../../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../../partials/superadmin-nav', { activePage: 'tasks' }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Ofrecer plantillas a escuelas</h2>
        <p style="color:var(--text-secondary);font-size:14px;margin-top:4px">
          Cada escuela recibe la oferta y su administrador decide si activarla.
        </p>
      </div>
      <div class="dashboard-actions">
        <a href="/superadmin/tasks" class="btn btn-outline">
          <span class="material-symbols-outlined">arrow_back</span>
          Volver al gestor
        </a>
      </div>
    </div>

    <div class="assign-info">
      <strong>Cómo funciona:</strong> Al ofrecer, la plantilla queda en estado
      <em>ofrecida</em> para esa escuela — el admin la ve en su panel y decide
      <em>aceptar</em> o <em>rechazar</em>. Solo las aceptadas quedan disponibles
      para los docentes. Podés revocar en cualquier momento.
    </div>

    <% if (templates.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><span class="material-symbols-outlined">assignment</span></div>
        <p>Todavía no hay plantillas. Creá una desde el <a href="/superadmin/tasks">gestor</a>.</p>
      </div>
    <% } %>

    <% templates.forEach(t => { %>
      <%
        const statusMeta = ({
          draft:     { label: 'Borrador',  bg: '#fff3e0', color: '#ea8600' },
          published: { label: 'Publicada', bg: '#e6f4ea', color: '#137333' },
          archived:  { label: 'Archivada', bg: '#e8eaed', color: '#5f6368' },
        })[t.status] || { label: t.status, bg: '#eee', color: '#333' };
      %>
      <section class="assign-card">
        <header class="assign-card-head">
          <div class="assign-card-icon"><span class="material-symbols-outlined">assignment</span></div>
          <div class="assign-card-head-main">
            <div class="assign-card-title">
              <h3><%= t.title %></h3>
              <span class="assign-status-label" style="background:<%= statusMeta.bg %>;color:<%= statusMeta.color %>">
                <%= statusMeta.label %>
              </span>
            </div>
            <% if (t.description) { %>
              <p class="assign-card-desc"><%= t.description %></p>
            <% } %>
            <div class="assign-card-chips">
              <span class="assign-chip"><span class="material-symbols-outlined">quiz</span> <%= t.questions.length %> pregunta<%= t.questions.length === 1 ? '' : 's' %></span>
              <span class="assign-chip"><span class="material-symbols-outlined">stars</span> <%= t.defaultPoints %> pts</span>
              <span class="assign-chip"><span class="material-symbols-outlined">schedule</span> <%= fmt.diaMesAnio(t.updatedAt) %></span>
            </div>
          </div>
        </header>

        <div class="assign-schools">
          <% if (t.status !== 'published') { %>
            <p class="assign-notice">
              Publicá esta plantilla desde el gestor para poder ofrecerla a alguna escuela.
            </p>
          <% } else if (schools.length === 0) { %>
            <p class="assign-notice">No hay escuelas registradas todavía.</p>
          <% } else { %>
            <h4>Escuelas</h4>
            <div class="assign-school-list">
              <% schools.forEach(s => {
                const a = byPair[`${t._id}|${s._id}`];
                const status = a ? a.status : 'none';
                const statusLabel = ({ accepted: 'Aceptada', offered: 'Ofrecida', rejected: 'Rechazada', none: 'Sin ofrecer' })[status];
                const dotColor   = ({ accepted: '#137333', offered: '#ea8600', rejected: '#ea4335', none: '#9aa0a6' })[status];
                const respHint   = a && a.respondedAt
                  ? (a.status === 'accepted' ? 'respondió el ' : 'respondió el ') + fmt.diaMes(a.respondedAt)
                  : (status === 'offered' ? 'esperando respuesta' : '');
              %>
                <div class="assign-school-row">
                  <span class="dot" style="background:<%= dotColor %>"></span>
                  <span class="color" style="background:<%= s.color %>"></span>
                  <span class="name"><%= s.name %></span>
                  <span class="assign-status-label <%= status %>"><%= statusLabel %></span>
                  <% if (respHint) { %>
                    <span class="assign-resp-hint"><%= respHint %></span>
                  <% } %>
                  <% if (status === 'none') { %>
                    <button class="btn btn-primary" style="padding:6px 12px;font-size:12px;margin-left:auto" onclick="offerTo('<%= t._id %>','<%= s._id %>',this)">
                      <span class="material-symbols-outlined" style="font-size:16px">send</span>
                      Ofrecer
                    </button>
                  <% } else if (status === 'rejected') { %>
                    <button class="btn btn-primary" style="padding:6px 12px;font-size:12px" onclick="offerTo('<%= t._id %>','<%= s._id %>',this)">
                      <span class="material-symbols-outlined" style="font-size:16px">refresh</span>
                      Volver a ofrecer
                    </button>
                  <% } else { %>
                    <button class="btn btn-outline" style="padding:6px 12px;font-size:12px;color:var(--danger);border-color:var(--border)" onclick="revokeFrom('<%= t._id %>','<%= s._id %>',this)">
                      <span class="material-symbols-outlined" style="font-size:16px">close</span>
                      Revocar
                    </button>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    <% }) %>
  </main>

  <%- include('../../partials/footer') %>

  <script>
    async function offerTo(templateId, schoolId, btn) {
      btn.disabled = true;
      const res = await fetch('/superadmin/tasks/' + templateId + '/offer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ schoolId }),
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error || 'Error'); btn.disabled = false; return; }
      location.reload();
    }
    async function revokeFrom(templateId, schoolId, btn) {
      if (!confirm('¿Revocar la plantilla de esta escuela? Los docentes que la estén usando dejarán de tenerla disponible para nuevas actividades.')) return;
      btn.disabled = true;
      const res = await fetch('/superadmin/tasks/' + templateId + '/revoke', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ schoolId }),
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error || 'Error'); btn.disabled = false; return; }
      location.reload();
    }
  </script>
</body>
</html>
