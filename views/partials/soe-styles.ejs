  }
  .cal-dow .corto { display: none; }
  .cal-celda {
    min-height: 96px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); padding: 6px; overflow: hidden;
  }
  .cal-celda.vacia { border: none; background: transparent; }
  .cal-celda.pasado { background: var(--bg); }
  .cal-num { font-size: 12.5px; font-weight: 600; color: var(--text-secondary); }
  .cal-celda.hoy { border-color: var(--primary); }
  .cal-celda.hoy .cal-num {
    background: var(--primary); color: #ffffff;   /* fondo en variable de marca ⇒ texto explícito */
    border-radius: 50%; width: 22px; height: 22px;
    display: inline-flex; align-items: center; justify-content: center;
  }

  /* Un evento adentro de una celda. El punto de color dice de qué clase es; el texto va en
     los tokens del tema para que se lea en claro y en oscuro sin duplicar nada. */
  .cal-ev {
    display: flex; align-items: center; gap: 4px; margin-top: 4px;
    font-size: 11px; line-height: 1.3; color: var(--text); text-decoration: none;
