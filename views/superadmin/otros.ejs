<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Otros - Superadmin - Classroom</title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .fix-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 20px; margin-bottom: 16px;
      border-left: 4px solid var(--border);
    }
    .fix-card.sev-alta  { border-left-color: #ea4335; }
    .fix-card.sev-media { border-left-color: #ea8600; }
    .fix-card.sev-baja  { border-left-color: #1a73e8; }
    .fix-card.limpio    { border-left-color: #34a853; opacity: .72; }
    .fix-head { display: flex; align-items: flex-start; gap: 12px; }
    .fix-icon {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: var(--bg); color: var(--text-secondary);
    }
    .fix-title { font-size: 16px; font-weight: 600; margin: 0 0 4px; }
    .fix-desc  { font-size: 13px; color: var(--text-secondary); line-height: 1.55; margin: 0; }
    .fix-count {
      margin-left: auto; text-align: right; flex-shrink: 0; padding-left: 12px;
    }
    .fix-count-num { font-size: 30px; font-weight: 700; line-height: 1; }
    .fix-count-lbl { font-size: 10px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: .4px; }
    .fix-nota {
      font-size: 12px; background: var(--bg); border-radius: 8px;
      padding: 10px 12px; margin-top: 12px; color: var(--text-secondary); line-height: 1.5;
    }
    .fix-actions { display: flex; gap: 10px; align-items: center; margin-top: 16px; flex-wrap: wrap; }
    .fix-preview {
      margin-top: 12px; border: 1px solid var(--border); border-radius: 8px;
      max-height: 280px; overflow-y: auto; display: none;
    }
    .fix-preview table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .fix-preview td { padding: 7px 12px; border-bottom: 1px solid var(--border); }
    .fix-preview tr:last-child td { border-bottom: none; }
    .fix-preview .col-sec { color: var(--text-hint); font-size: 11.5px; }
    .fix-preview .col-extra { color: var(--text-secondary); text-align: right; white-space: nowrap; }
    .solo-diag {
      display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700;
      background: #e8f0fe; color: #1a73e8; padding: 3px 10px; border-radius: 10px;
    }
    .fix-result { font-size: 13px; margin-top: 12px; padding: 10px 14px; border-radius: 8px; display: none; }
    .fix-result.ok    { background: #e6f4ea; color: #137333; }
    .fix-result.error { background: #fce8e6; color: #c5221f; }
    .fix-param { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .fix-param select { padding: 7px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font-size: 13px; }

    /* Arreglos que se resuelven grupo por grupo (docentes y alumnos con el mismo DNI): la
       elección de qué cuenta se conserva —y con qué correo queda— es humana, así que cada
       grupo trae su propio botón. El bloque es uno solo para los dos arreglos: los textos y
       los números de cada cuenta los arma services/dbFixes.js. */
    .dupe-group {
      border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 16px; margin-top: 12px;
    }
    .dupe-head {
      font-size: 13px; font-weight: 700; margin-bottom: 4px;
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }
    .dupe-sub { font-size: 11.5px; color: var(--text-hint); margin-bottom: 10px; }
    .dupe-account {
      display: flex; align-items: flex-start; gap: 10px; cursor: pointer;
      padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px;
      margin-bottom: 8px; background: var(--bg);
    }
    .dupe-account:has(input:checked) { border-color: #1a73e8; background: #e8f0fe; }
    .dupe-account input { margin-top: 3px; flex-shrink: 0; }
    .dupe-name { font-size: 13.5px; font-weight: 600; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .dupe-mail { font-size: 12px; color: var(--text-secondary); word-break: break-all; }
    .dupe-stats { font-size: 11.5px; color: var(--text-hint); margin-top: 3px; }
    .dupe-chip {
      font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 10px;
      text-transform: uppercase; letter-spacing: .3px;
    }
    .dupe-chip.sugerida { background: #e6f4ea; color: #137333; }
    .dupe-chip.inactiva { background: #fce8e6; color: #c5221f; }
    .dupe-chip.datos    { background: #fef7e0; color: #b06000; }
    .dupe-aviso {
      font-size: 12px; line-height: 1.5; background: #fef7e0; color: #b06000;
      border-radius: 8px; padding: 9px 12px; margin-bottom: 10px;
    }
    .dupe-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 10px; }
    .dupe-actions select { padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font-size: 12.5px; }
    .dupe-result { font-size: 12.5px; margin-top: 10px; padding: 9px 12px; border-radius: 8px; display: none; }
    .dupe-result.ok    { background: #e6f4ea; color: #137333; }
    .dupe-result.error { background: #fce8e6; color: #c5221f; }

    /* Compositor: la tarjeta es un formulario (alta masiva de materias en varios cursos) */
    .am-block { margin-top: 18px; }
    .am-label {
      font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
      color: var(--text-secondary); margin-bottom: 8px;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .am-label .am-mini {
      font-size: 11px; font-weight: 600; text-transform: none; letter-spacing: 0;
      color: #1a73e8; background: none; border: none; cursor: pointer; padding: 0;
    }
    .am-label .am-mini:hover { text-decoration: underline; }
    .am-hint { font-size: 11.5px; color: var(--text-hint); font-weight: 400; text-transform: none; letter-spacing: 0; }
    .am-cursos {
      display: flex; flex-wrap: wrap; gap: 8px;
      max-height: 190px; overflow-y: auto;
      border: 1px solid var(--border); border-radius: 10px; padding: 12px;
    }
    .am-curso {
      display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
      border: 1px solid var(--border); border-radius: 20px; padding: 6px 13px 6px 10px;
      font-size: 12.5px; background: var(--bg); user-select: none;
    }
    .am-curso:has(input:checked) { border-color: #1a73e8; background: #e8f0fe; color: #1a73e8; font-weight: 600; }
    .am-curso .am-n { font-size: 10.5px; color: var(--text-hint); font-weight: 400; }
    .am-curso:has(input:checked) .am-n { color: #1a73e8; }
    .am-fila {
      display: grid; grid-template-columns: 1fr 1fr 150px 32px; gap: 8px;
      align-items: center; margin-bottom: 8px;
    }
    .am-fila input, .am-fila select {
      width: 100%; padding: 8px 11px; font-size: 13px;
      border: 1px solid var(--border); border-radius: 8px;
      background: var(--surface); color: var(--text-primary); outline: none;
    }
    .am-fila input:focus, .am-fila select:focus { border-color: #1a73e8; }
    .am-quitar {
      background: none; border: none; cursor: pointer; color: var(--text-hint);
      padding: 4px; display: flex; align-items: center; justify-content: center; line-height: 1;
    }
    .am-quitar:hover { color: #ea4335; }
    .am-cabecera {
      display: grid; grid-template-columns: 1fr 1fr 150px 32px; gap: 8px;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
      color: var(--text-hint); margin-bottom: 6px; padding: 0 2px;
    }
    .am-check { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; margin-top: 16px; cursor: pointer; }
    .am-check input { margin-top: 2px; flex-shrink: 0; }
    .am-plan {
      display: none; margin-top: 14px; border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 16px; max-height: 340px; overflow-y: auto; font-size: 12.5px;
    }
    .am-plan h4 { font-size: 13px; margin: 0 0 10px; }
    .am-plan-curso { border-top: 1px solid var(--border); padding: 9px 0; }
    .am-plan-curso:first-of-type { border-top: none; }
    .am-plan-nombre { font-weight: 600; margin-bottom: 3px; }
    .am-plan-item { color: var(--text-secondary); line-height: 1.6; }
    .am-plan-item .am-nuevo  { color: #137333; font-weight: 600; }
    .am-plan-item .am-existe { color: var(--text-hint); }
    @media (max-width: 700px) {
      .am-fila, .am-cabecera { grid-template-columns: 1fr; }
      .am-cabecera { display: none; }
      .am-fila { border: 1px solid var(--border); border-radius: 10px; padding: 10px; }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../partials/superadmin-nav', { activePage: 'otros' }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Sanar la base de datos</h2>
        <p style="color:var(--text-secondary);font-size:14px;margin-top:4px">
          <% if (pendientes === 0) { %>
            No se detectaron problemas de integridad.
          <% } else { %>
            <%= pendientes %> problema<%= pendientes !== 1 ? 's' : '' %> detectado<%= pendientes !== 1 ? 's' : '' %>.
            Revisá el detalle antes de aplicar: estos cambios escriben directo en la base y no se deshacen.
          <% } %>
        </p>
      </div>
    </div>

    <% fixes.forEach(fix => { %>
      <%# Los compositores no son un problema con contador: no llevan la clase "limpio",
          que los pintaría como "sin casos pendientes" cuando en realidad son una herramienta. %>
      <div class="fix-card <%= fix.error ? '' : ((fix.total === 0 && !fix.compositor) ? 'limpio' : 'sev-' + fix.severidad) %>" data-fix="<%= fix.id %>">
        <div class="fix-head">
          <div class="fix-icon">
            <span class="material-symbols-outlined"><%= fix.icono %></span>
          </div>
          <div style="flex:1;min-width:0">
            <h3 class="fix-title">
              <%= fix.titulo %>
              <% if (fix.compositor) { %>
                <span class="solo-diag" title="No corrige nada: crea lo que vos cargues">
                  <span class="material-symbols-outlined" style="font-size:13px">build</span>
                  Herramienta
                </span>
              <% } else if (fix.interactivo) { %>
                <span class="solo-diag" title="La elección —qué cuenta se conserva y con qué correo— la hacés vos, caso por caso">
                  <span class="material-symbols-outlined" style="font-size:13px">rule</span>
                  <%= fix.aplicable ? 'Masivo o caso por caso' : 'Elegís caso por caso' %>
                </span>
              <% } else if (!fix.aplicable) { %>
                <span class="solo-diag" title="No hay una regla automática que lo resuelva sin inventar datos">
                  <span class="material-symbols-outlined" style="font-size:13px">visibility</span>
                  Solo diagnóstico
                </span>
              <% } %>
            </h3>
            <p class="fix-desc"><%= fix.descripcion %></p>
          </div>
          <% if (!fix.compositor || fix.error) { %>
            <div class="fix-count">
              <% if (fix.error) { %>
                <div class="fix-count-num" style="color:#ea4335;font-size:20px">error</div>
              <% } else { %>
                <div class="fix-count-num" data-total style="color:<%= fix.total === 0 ? '#34a853' : fix.severidad === 'alta' ? '#ea4335' : '#ea8600' %>">
                  <%= fix.total %>
                </div>
                <div class="fix-count-lbl">afectados</div>
              <% } %>
            </div>
          <% } %>
        </div>

        <% if (fix.error) { %>
          <div class="fix-nota" style="color:#c5221f">No se pudo diagnosticar: <%= fix.error %></div>
        <% } else { %>
          <% if (fix.nota) { %>
            <div class="fix-nota" data-nota><%= fix.nota %></div>
          <% } else { %>
            <div class="fix-nota" data-nota style="display:none"></div>
          <% } %>

          <%# ── Compositor: la tarjeta es un formulario ────────────────────────────
              Los cursos y los docentes se pintan desde el JSON de abajo, no desde EJS: hay
              que refiltrarlos cada vez que cambia la escuela elegida, y hacerlo dos veces
              (una en el servidor y otra en el navegador) es garantía de que se desincronicen. %>
          <% if (fix.compositor && fix.opciones) { %>
            <script type="application/json" data-opciones>
              <%- JSON.stringify(fix.opciones).replace(/</g, '\\u003c') %>
            </script>

            <div data-compositor>
              <% if (fix.opciones.escuelas.length > 1) { %>
                <div class="am-block">
                  <div class="am-label">Escuela</div>
                  <select data-escuela style="padding:8px 11px;font-size:13px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text-primary)">
                    <% fix.opciones.escuelas.forEach(e => { %>
                      <option value="<%= e.id %>"><%= e.nombre %></option>
                    <% }) %>
                  </select>
                </div>
              <% } else if (fix.opciones.escuelas.length === 1) { %>
                <input type="hidden" data-escuela value="<%= fix.opciones.escuelas[0].id %>">
              <% } %>

              <div class="am-block">
                <div class="am-label">
                  Cursos donde cargarlas
                  <button type="button" class="am-mini" data-todos>Todos</button>
                  <button type="button" class="am-mini" data-ninguno>Ninguno</button>
                  <span class="am-hint" data-elegidos></span>
                </div>
                <div class="am-cursos" data-cursos></div>
              </div>

              <div class="am-block">
                <div class="am-label">
                  Materias
                  <span class="am-hint">Se cargan igual que una materia común: nombre, quién está a cargo y el aula.</span>
                </div>
                <div class="am-cabecera">
                  <div>Nombre de la materia</div>
                  <div>A cargo de</div>
                  <div>Aula (opcional)</div>
                  <div></div>
                </div>
                <div data-materias></div>
                <button type="button" class="btn btn-outline" data-agregar style="font-size:12.5px;padding:6px 14px;margin-top:4px">
                  <span class="material-symbols-outlined" style="font-size:17px">add</span>
                  Agregar materia
                </button>
                <datalist data-nombres>
                  <% fix.opciones.nombres.forEach(n => { %><option value="<%= n %>"><% }) %>
                </datalist>
              </div>

              <%# Por omisión se matricula: una materia nueva y vacía en un curso que ya tiene
                  alumnos deja a todo el curso con matrícula parcial — el problema que viene a
                  resolver el primer arreglo de esta misma pantalla. %>
              <label class="am-check">
                <input type="checkbox" data-matricular checked>
                <span>
                  Inscribir en las materias nuevas a los alumnos que ya cursan en ese curso.
                  <span class="am-hint">
                    Si lo destildás, las materias quedan vacías y hay que matricular a mano.
                    Las tareas vencidas antes de hoy no les figuran como pendientes.
                  </span>
                </span>
              </label>

              <div class="am-plan" data-plan></div>

              <div class="fix-actions">
                <button type="button" class="btn btn-outline" data-previsualizar style="font-size:13px;padding:7px 16px">
                  <span class="material-symbols-outlined">visibility</span>
                  Ver qué se va a crear
                </button>
                <button type="button" class="btn btn-primary" data-crear style="font-size:13px;padding:7px 18px">
                  <span class="material-symbols-outlined">library_add</span>
                  Crear materias
                </button>
              </div>
            </div>
          <% } %>

          <% if (!fix.compositor) { %>
          <div class="fix-preview" data-preview>
            <table>
              <tbody data-preview-body>
                <% fix.muestra.forEach(m => { %>
                  <tr>
                    <td>
                      <div><%= m.principal %></div>
                      <% if (m.secundario) { %><div class="col-sec"><%= m.secundario %></div><% } %>
                    </td>
                    <td class="col-extra"><%= m.extra || '' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <%# Arreglo interactivo: un bloque por grupo con la elección de qué cuenta se
              conserva y con qué correo queda. Sirve igual para 'docentes-dni-duplicado' y
              para 'dni-duplicado-en-curso': el título, los números de cada cuenta y qué se
              puede hacer con la sobrante vienen armados desde services/dbFixes.js. %>
          <% if (fix.interactivo && fix.total > 0) { %>
            <div data-grupos>
              <% fix.grupos.forEach(g => { %>
                <div class="dupe-group" data-clave="<%= g.clave %>">
                  <div class="dupe-head">
                    <span class="material-symbols-outlined" style="font-size:17px"><%= g.icono || 'badge' %></span>
                    <%= g.titulo %>
                  </div>
                  <div class="dupe-sub"><%= g.ayuda %></div>
                  <% if (g.aviso) { %><div class="dupe-aviso"><%= g.aviso %></div><% } %>

                  <% g.cuentas.forEach(c => { %>
                    <label class="dupe-account">
                      <input type="radio" name="keep-<%= g.clave %>" value="<%= c.id %>" <%= c.id === g.sugeridaId ? 'checked' : '' %>>
                      <div style="min-width:0">
                        <div class="dupe-name">
                          <%= c.nombre %>
                          <% (c.chips || []).forEach(ch => { %><span class="dupe-chip <%= ch.tipo %>"><%= ch.texto %></span><% }) %>
                        </div>
                        <div class="dupe-mail"><%= c.email %></div>
                        <div class="dupe-stats"><%= c.detalle %></div>
                      </div>
                    </label>
                  <% }) %>

                  <%# Segunda decisión, independiente de la primera: el caso más común es
                      quedarse con la cuenta que ya tiene el trabajo hecho pero con el correo
                      institucional, que está en la otra. %>
                  <div class="dupe-actions">
                    <label style="font-size:12.5px;color:var(--text-secondary)">Queda con el correo:</label>
                    <select data-email>
                      <% g.cuentas.forEach(c => { %>
                        <option value="<%= c.id %>" <%= c.id === g.sugeridaId ? 'selected' : '' %>><%= c.email %></option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="dupe-actions">
                    <label style="font-size:12.5px;color:var(--text-secondary)">La otra cuenta:</label>
                    <select data-sobrante>
                      <% (g.opcionesSobrante || []).forEach(o => { %>
                        <option value="<%= o.value %>"><%= o.label %></option>
                      <% }) %>
                    </select>
                    <button class="btn btn-primary" data-fusionar style="font-size:12.5px;padding:6px 16px">
                      <span class="material-symbols-outlined" style="font-size:16px">merge_type</span>
                      Fusionar
                    </button>
                  </div>
                  <div class="dupe-result"></div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="fix-actions">
            <% if (fix.total > 0) { %>
              <%# En los interactivos la lista de afectados ya está arriba, grupo por grupo.
                  Salvo que además tengan botón masivo: ahí sigue haciendo falta ver de un
                  vistazo sobre qué casos correría ese botón. %>
              <% if (!fix.interactivo || fix.aplicable) { %>
                <button class="btn btn-outline" data-toggle-preview style="font-size:13px;padding:7px 16px">
                  <span class="material-symbols-outlined">visibility</span>
                  Ver a quiénes afecta
                </button>
              <% } %>

              <% fix.parametros.forEach(p => { %>
                <div class="fix-param">
                  <label for="param-<%= fix.id %>-<%= p.name %>"><%= p.label %>:</label>
                  <select id="param-<%= fix.id %>-<%= p.name %>" data-param="<%= p.name %>">
                    <% p.opciones.forEach(o => { %>
                      <option value="<%= o.value %>"><%= o.label %></option>
                    <% }) %>
                  </select>
                </div>
              <% }) %>

              <% if (fix.aplicable) { %>
                <button class="btn btn-primary" data-aplicar style="font-size:13px;padding:7px 18px">
                  <span class="material-symbols-outlined">healing</span>
                  Aplicar arreglo
                </button>
              <% } %>
            <% } else { %>
              <span style="font-size:13px;color:#137333;display:flex;align-items:center;gap:6px">
                <span class="material-symbols-outlined" style="font-size:18px">check_circle</span>
                Sin casos pendientes
              </span>
            <% } %>
          </div>
          <% } %>

          <div class="fix-result" data-result></div>
        <% } %>
      </div>
    <% }) %>
  </main>

  <%- include('../partials/footer') %>
  <script>
    /* ── Compositor: cargar un grupo de materias en un grupo de cursos ───────────
       A diferencia del resto de la pantalla, acá no hay un diagnóstico contra el cual
       apretar un botón: lo que se va a crear lo escribe la persona. Por eso el "Crear"
       pasa siempre por la vista previa del servidor —el mismo cálculo que después
       aplica— y recién con esos números pide confirmación. */
    document.querySelectorAll('[data-compositor]').forEach(form => {
      const card     = form.closest('.fix-card');
      const id       = card.dataset.fix;
      const opciones = JSON.parse(card.querySelector('[data-opciones]').textContent);
      const result   = card.querySelector('[data-result]');
      const cursosEl = form.querySelector('[data-cursos]');
      const filasEl  = form.querySelector('[data-materias]');
      const escuelaEl= form.querySelector('[data-escuela]');
      const elegidos = form.querySelector('[data-elegidos]');
      const planEl   = form.querySelector('[data-plan]');
      const datalist = form.querySelector('[data-nombres]');
      datalist.id = 'am-nombres-' + id;

      // Los nombres de cursos y docentes salen de la base: se arman con textContent y no
      // con innerHTML para que un nombre con < o & no pueda inyectar nada en la página.
      function el(tag, cls, texto) {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        if (texto !== undefined) n.textContent = texto;
        return n;
      }

      const escuelaActual = () => (escuelaEl ? escuelaEl.value : (opciones.escuelas[0] || {}).id || '');
      const elegidosIds   = () => [...cursosEl.querySelectorAll('input:checked')].map(i => i.value);

      function contar() {
        const n = elegidosIds().length;
        elegidos.textContent = n ? n + ' curso(s) elegidos' : 'ninguno elegido todavía';
      }

      function pintarCursos() {
        const escuela = escuelaActual();
        const cursos  = opciones.cursos.filter(c => c.escuela === escuela);
        cursosEl.innerHTML = '';
        if (!cursos.length) {
          cursosEl.appendChild(el('span', 'am-hint', 'Esta escuela todavía no tiene cursos cargados.'));
          contar();
          return;
        }
        cursos.forEach(c => {
          const label = el('label', 'am-curso');
          const input = document.createElement('input');
          input.type  = 'checkbox';
          input.value = c.id;
          input.addEventListener('change', contar);
          label.append(input, el('span', null, c.nombre), el('span', 'am-n', c.materias + ' mat.'));
          cursosEl.appendChild(label);
        });
        contar();
      }

      // El docente tiene que ser de la misma escuela que el curso: al cambiar de escuela se
      // repueblan los selects y se pierde la elección anterior si ya no corresponde.
      function pintarDocentes(select) {
        const escuela = escuelaActual();
        const previo  = select.value;
        select.innerHTML = '';
        select.appendChild(Object.assign(document.createElement('option'), {
          value: '', textContent: 'Elegí quién la dicta...',
        }));
        opciones.docentes.filter(d => d.escuela === escuela).forEach(d => {
          const o = document.createElement('option');
          o.value = d.id;
          o.textContent = d.nombre + ' · ' + d.email;
          select.appendChild(o);
        });
        if ([...select.options].some(o => o.value === previo)) select.value = previo;
      }

      function agregarFila() {
        const fila = el('div', 'am-fila');

        const nombre = document.createElement('input');
        nombre.type = 'text';
        nombre.placeholder = 'Ej: Matemática';
        nombre.dataset.nombre = '';
        nombre.setAttribute('list', datalist.id);

        const docente = document.createElement('select');
        docente.dataset.docente = '';

        const aula = document.createElement('input');
        aula.type = 'text';
        aula.placeholder = 'Ej: Aula 12';
        aula.dataset.aula = '';

        const quitar = el('button', 'am-quitar');
        quitar.type  = 'button';
        quitar.title = 'Quitar esta materia';
        const cruz = el('span', 'material-symbols-outlined', 'close');
        cruz.setAttribute('style', 'font-size:18px');
        quitar.appendChild(cruz);
        quitar.addEventListener('click', () => {
          fila.remove();
          if (!filasEl.children.length) agregarFila(); // que nunca quede el bloque vacío
        });

        fila.append(nombre, docente, aula, quitar);
        filasEl.appendChild(fila);
        pintarDocentes(docente);
        return nombre;
      }

      const leerMaterias = () => [...filasEl.querySelectorAll('.am-fila')].map(f => ({
        nombre:    f.querySelector('[data-nombre]').value,
        docenteId: f.querySelector('[data-docente]').value,
        aula:      f.querySelector('[data-aula]').value,
      }));

      const cuerpo = () => ({
        divisionIds: elegidosIds(),
        materias:    leerMaterias(),
        matricular:  form.querySelector('[data-matricular]').checked,
      });

      function mostrarError(mensaje) {
        planEl.style.display = 'none';
        result.className   = 'fix-result error';
        result.textContent = mensaje;
        result.style.display = 'block';
      }

      async function pedir(accion) {
        const res  = await fetch('/superadmin/otros/' + id + '/' + accion, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cuerpo()),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'No se pudo completar la operación.');
        return data;
      }

      function pintarPlan(data) {
        planEl.innerHTML = '';
        planEl.appendChild(el('h4', null,
          'Se van a crear ' + data.totalCrear + ' materia(s)' +
          (data.totalIntactas ? '. ' + data.totalIntactas + ' ya existen y quedan como están.' : '.')
        ));
        data.cursos.forEach(c => {
          if (!c.crear.length && !c.intactas.length) return;
          const bloque = el('div', 'am-plan-curso');
          bloque.appendChild(el('div', 'am-plan-nombre', c.nombre));
          c.crear.forEach(m => {
            const linea = el('div', 'am-plan-item');
            linea.appendChild(el('span', 'am-nuevo', 'nueva: '));
            linea.appendChild(document.createTextNode(
              m.nombre + ' — ' + m.docente + (m.aula ? ' · ' + m.aula : ' · sin aula')
            ));
            bloque.appendChild(linea);
          });
          c.intactas.forEach(m => {
            bloque.appendChild(el('div', 'am-plan-item am-existe',
              'ya estaba: ' + m.comoEsta + ' (no se toca)'));
          });
          planEl.appendChild(bloque);
        });
        planEl.style.display = 'block';
      }

      async function conBoton(btn, etiqueta, fn) {
        const original = btn.innerHTML;
        btn.disabled  = true;
        btn.innerHTML = '<span class="material-symbols-outlined">hourglass_top</span> ' + etiqueta;
        result.style.display = 'none';
        try {
          await fn();
        } catch (err) {
          mostrarError(err.message);
        } finally {
          btn.disabled  = false;
          btn.innerHTML = original;
        }
      }

      form.querySelector('[data-todos]').addEventListener('click', () => {
        cursosEl.querySelectorAll('input').forEach(i => { i.checked = true; });
        contar();
      });
      form.querySelector('[data-ninguno]').addEventListener('click', () => {
        cursosEl.querySelectorAll('input').forEach(i => { i.checked = false; });
        contar();
      });
      form.querySelector('[data-agregar]').addEventListener('click', () => { agregarFila().focus(); });

      if (escuelaEl && escuelaEl.tagName === 'SELECT') {
        escuelaEl.addEventListener('change', () => {
          pintarCursos();
          filasEl.querySelectorAll('[data-docente]').forEach(pintarDocentes);
        });
      }

      form.querySelector('[data-previsualizar]').addEventListener('click', (e) => {
        conBoton(e.currentTarget, 'Calculando...', async () => {
          pintarPlan(await pedir('previsualizar'));
        });
      });

      form.querySelector('[data-crear]').addEventListener('click', (e) => {
        conBoton(e.currentTarget, 'Creando...', async () => {
          // La confirmación se arma con los números del servidor, no con los del formulario:
          // lo que importa no es cuántas materias se escribieron sino cuántas faltan de verdad.
          const previo = await pedir('previsualizar');
          pintarPlan(previo);
          if (previo.totalCrear === 0) {
            result.className   = 'fix-result ok';
            result.textContent = 'No hay nada para crear: todas esas materias ya existen en los cursos elegidos.';
            result.style.display = 'block';
            return;
          }
          const cursosTocados = previo.cursos.filter(c => c.crear.length).length;
          if (!confirm(
            'Se van a crear ' + previo.totalCrear + ' materia(s) en ' + cursosTocados + ' curso(s).\n' +
            (previo.totalIntactas ? previo.totalIntactas + ' ya existen y no se van a tocar.\n' : '') +
            '\nEsto escribe directo en la base y no se puede deshacer. ¿Confirmás?'
          )) return;

          const data = await pedir('aplicar');
          planEl.style.display = 'none';
          result.className   = 'fix-result ok';
          result.textContent = data.mensaje + ' Recargá la página para ver los conteos actualizados.';
          result.style.display = 'block';
        });
      });

      pintarCursos();
      agregarFila();
      agregarFila();
      agregarFila();
    });

    document.querySelectorAll('.fix-card').forEach(card => {
      const id      = card.dataset.fix;
      const preview = card.querySelector('[data-preview]');
      const result  = card.querySelector('[data-result]');

      card.querySelector('[data-toggle-preview]')?.addEventListener('click', (e) => {
        const abierto = preview.style.display === 'block';
        preview.style.display = abierto ? 'none' : 'block';
        e.currentTarget.querySelector('.material-symbols-outlined').textContent =
          abierto ? 'visibility' : 'visibility_off';
      });

      // El correo por defecto sigue a la cuenta elegida, hasta que alguien elija otro a
      // mano: ahí manda la elección explícita y deja de moverse sola.
      card.querySelectorAll('.dupe-group').forEach(grupo => {
        const email = grupo.querySelector('[data-email]');
        if (!email) return;
        email.addEventListener('change', () => { email.dataset.tocado = '1'; });
        grupo.querySelectorAll('input[type=radio]').forEach(radio => {
          radio.addEventListener('change', () => {
            if (email.dataset.tocado !== '1') email.value = radio.value;
          });
        });
      });

      // Arreglos que se resuelven grupo por grupo: cada bloque manda su propia elección.
      card.querySelectorAll('[data-fusionar]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const grupo   = btn.closest('.dupe-group');
          const salida  = grupo.querySelector('.dupe-result');
          const elegida = grupo.querySelector('input[type=radio]:checked');
          if (!elegida) return;

          const original = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">hourglass_top</span> Fusionando...';
          salida.style.display = 'none';

          try {
            const res = await fetch('/superadmin/otros/' + id + '/fusionar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                clave:    grupo.dataset.clave,
                keepId:   elegida.value,
                emailId:  grupo.querySelector('[data-email]')?.value || elegida.value,
                sobrante: grupo.querySelector('[data-sobrante]').value,
              }),
            });
            const data = await res.json();

            if (!res.ok) {
              salida.className = 'dupe-result error';
              salida.textContent = data.error || 'No se pudo fusionar.';
              salida.style.display = 'block';
              btn.disabled = false;
              btn.innerHTML = original;
              return;
            }

            // El grupo resuelto se reemplaza por el resultado: si quedara editable, un
            // segundo clic fusionaría contra un estado que ya no existe.
            grupo.querySelectorAll('.dupe-account, .dupe-actions, .dupe-sub, .dupe-aviso').forEach(el => el.remove());
            salida.className = 'dupe-result ok';
            salida.textContent = data.mensaje;
            salida.style.display = 'block';

            card.querySelector('[data-total]').textContent = data.restantes;
            if (data.restantes === 0) {
              card.classList.remove('sev-alta', 'sev-media', 'sev-baja');
              card.classList.add('limpio');
              card.querySelector('[data-total]').style.color = '#34a853';
            }
          } catch (err) {
            salida.className = 'dupe-result error';
            salida.textContent = 'Error de red: ' + err.message;
            salida.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = original;
          }
        });
      });

      card.querySelector('[data-aplicar]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined">hourglass_top</span> Aplicando...';
        result.style.display = 'none';

        // Los <select> de parámetros del arreglo (por ejemplo, a qué escuela asignar)
        const body = {};
        card.querySelectorAll('[data-param]').forEach(sel => { body[sel.dataset.param] = sel.value; });

        try {
          const res  = await fetch('/superadmin/otros/' + id + '/aplicar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();

          if (!res.ok) {
            result.className = 'fix-result error';
            result.textContent = data.error || 'No se pudo aplicar.';
            result.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined">healing</span> Aplicar arreglo';
            return;
          }

          // Una tarjeta puede tener las dos vías (masiva + caso por caso): los bloques de
          // abajo se calcularon contra el estado anterior, así que quedan inservibles. El
          // servidor recalcula el grupo antes de fusionar, o sea que un clic tardío no
          // rompe nada — pero fallaría, y es más claro desactivarlos y pedir recarga.
          const grupos = card.querySelector('[data-grupos]');
          if (grupos && data.restantes > 0) {
            grupos.querySelectorAll('[data-fusionar]').forEach(b => { b.disabled = true; });
          }

          result.className = 'fix-result ok';
          result.textContent = data.mensaje + (data.restantes > 0
            ? ` Quedan ${data.restantes} caso(s) que este arreglo no cubre.` +
              (grupos ? ' Recargá la página para resolverlos uno por uno con los datos al día.' : '')
            : '');
          result.style.display = 'block';

          // El contador se refresca con el diagnóstico posterior al arreglo, para que se
          // vea el efecto sin recargar. Si quedó en cero, la tarjeta pasa a "limpio".
          card.querySelector('[data-total]').textContent = data.restantes;
          if (data.restantes === 0) {
            card.className = 'fix-card limpio';
            grupos?.remove();
            card.querySelector('[data-total]').style.color = '#34a853';
            preview.style.display = 'none';
            btn.remove();
            card.querySelector('[data-toggle-preview]')?.remove();
            card.querySelectorAll('.fix-param').forEach(p => p.remove());
          } else {
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined">healing</span> Aplicar arreglo';
          }
        } catch (err) {
          result.className = 'fix-result error';
          result.textContent = 'Error de red: ' + err.message;
          result.style.display = 'block';
          btn.disabled = false;
          btn.innerHTML = '<span class="material-symbols-outlined">healing</span> Aplicar arreglo';
        }
      });
    });
  </script>
</body>
</html>
