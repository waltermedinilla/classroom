<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Derivaciones — Orientación Escolar</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=block" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/soe-styles') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../partials/soe-nav', { activePage }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Derivaciones</h2>
        <div style="font-size:12.5px;color:var(--text-secondary);margin-top:2px">
          Todas las derivaciones a servicios externos, con lo que cada lugar fue devolviendo.
        </div>
      </div>
    </div>

    <% const atencion = filas.filter(f => f.atencion); %>
    <% if (atencion.length) { %>
      <div class="soe-lectura" style="background:#fce8e6;border-color:#ea4335">
        <span class="material-symbols-outlined" style="color:#c5221f">priority_high</span>
        <div>
          <strong><%= atencion.length %></strong>
          derivación<%= atencion.length === 1 ? '' : 'es' %>
          necesita<%= atencion.length === 1 ? '' : 'n' %> que alguien pregunte: el servicio no
          contestó, el alumno no asistió, o se pasó la fecha de seguimiento.
        </div>
      </div>
    <% } %>

    <% if (!filas.length) { %>
      <div class="soe-panel">
        <div class="vacio">
          <span class="material-symbols-outlined">share</span>
          Todavía no se derivó a ningún alumno a un servicio externo.
        </div>
      </div>
    <% } else { %>
      <div class="soe-panel">
        <div class="tabla-scroll">
          <table class="soe-tabla">
            <thead>
              <tr>
                <th>Alumno</th><th>Curso</th><th>Derivado a</th><th>Tipo</th>
                <th>Desde</th><th>Estado</th><th>Devoluciones</th><th>Seguimiento</th>
              </tr>
            </thead>
            <tbody>
              <% filas.forEach(f => { %>
                <tr style="<%= f.atencion ? 'background:#fce8e618' : '' %>">
                  <td><a href="/soe/legajo/<%= f.legajo.student._id %>#derivaciones"><%= f.legajo.student.name %></a></td>
                  <td><%= f.legajo.division ? f.legajo.division.name : '—' %></td>
                  <td><%= f.referral.destino %></td>
                  <td style="font-size:12.5px;color:var(--text-secondary)"><%= acceso.TIPO_DERIVACION_LABELS[f.referral.tipo] %></td>
                  <td><%= fmt.fechaCorta(f.referral.fecha) %></td>
                  <td>
                    <span class="chip <%= f.atencion ? 'chip-alerta' : (f.activa ? 'chip-ok' : 'chip-neutro') %>">
                      <%= acceso.ESTADO_DERIVACION_LABELS[f.referral.estado] %>
                    </span>
                  </td>
                  <td>
                    <% const n = (f.referral.devoluciones || []).length; %>
                    <% if (n) { %>
                      <%= n %>
                      <span style="color:var(--text-hint);font-size:12px">
                        (últ. <%= fmt.fechaCorta(f.referral.devoluciones[n - 1].fecha) %>)
                      </span>
                    <% } else { %>
                      <span style="color:var(--text-hint)">sin respuesta todavía</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (f.referral.proximoSeguimiento) { %>
                      <span class="<%= f.atencion ? 'chip chip-alerta' : '' %>"><%= fmt.fechaCorta(f.referral.proximoSeguimiento) %></span>
                    <% } else { %>—<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
