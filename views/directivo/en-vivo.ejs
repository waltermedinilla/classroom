<%# Contenedor del panel de dirección. Las tarjetas viven en partials/live-cards.ejs, que se
    comparte con el panel de preceptoría — la única diferencia entre las dos pantallas es cómo
    entra cada rol a la sala (`ingreso`), y eso lo decide la ruta, no la vista. %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>En vivo — Panel Directivo</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=block" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <%- include('../partials/directivo-nav', { activePage: 'envivo' }) %>
    <%- include('../partials/live-cards') %>
  </main>

  <%# El footer no es decorativo: define toggleDrawer(), logout(), el tema y carga
      nav-responsive.js. Sin él, TODOS los botones del header de esta página quedan muertos.
      Faltaba desde que se creó el panel. %>
  <%- include('../partials/footer') %>
</body>
</html>
