<%# Estilos de los diseños nuevos de la sala en vivo (specs/sala-disenos.spec.md).

    REGLA DE ESTE ARCHIVO (CA-14): toda regla va prefijada con la clase de su diseño
    (.lr-diseno-a, -b, -c, o :is(...) de varios), o es la que ESCONDE los bloques de los diseños
    fuera de ellos (.lr-wrap:not(.lr-diseno-X) …). Una regla sin prefijo pisaría la sala Clásica,
    que es la que usan todas las clases y la que no se puede romper. Lo controla
    tests/unit/salaDisenos.test.js.

    Vive en su propio archivo y no en el <style> de live-room.ejs para que ese bloque —que tiene
    sus propios tests de contraste— quede exactamente como estaba. Igual se respetan sus dos
    reglas: un fondo fijo declara su color de texto, y cada color fijo tiene su variante oscura.

    Los tres diseños siguen el botón de tema claro/oscuro del sitio: lo fijo de acá tiene su
    par en el bloque [data-theme="dark"] de abajo. También C, aunque su maqueta sea oscura.

    Iconos que se dibujan solo desde CSS (content: de los botones redondos de C). La fuente se
    pide recortada a los iconos que usa la app (tools/iconos.js), que los encuentra por su
    <span>; como estos no tienen uno, quedan listados acá para el barrido:
    <span class="material-symbols-outlined">play_arrow</span>
    <span class="material-symbols-outlined">call_end</span>
    <span class="material-symbols-outlined">campaign</span> %>
<style>
  /* ── Fuera de los diseños nuevos, sus bloques no existen ──────────────── */
  .lr-wrap:not(.lr-diseno-b):not(.lr-diseno-c):not(.lr-diseno-d) .lr-dis,
  .lr-wrap:not(.lr-diseno-c) .tx-turnos-tit,
  .lr-wrap:not(.lr-diseno-b) .tx-bajo-cuadro,
  .lr-wrap:not(.lr-diseno-d) .tx-sonido,
  .lr-wrap:not(.lr-diseno-d) .lrD-cab-tx,
  .lr-wrap:not(.lr-diseno-d) .lrD-puntos,
  .lr-wrap:not(.lr-diseno-d) .lrD-grupo-chat,
  .lr-wrap:not(.lr-diseno-c) .lrC-volver,
  .lr-wrap:not(.lr-diseno-c) .lrC-curso,
  .lr-wrap:not(.lr-diseno-c) .lrC-reloj,
  .lr-wrap:not(.lr-diseno-c) .lrC-cuenta { display:none !important; }

  /* Qué bloque es de qué diseño */
  .lr-diseno-b .lrC-barra { display:none !important; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-chips, :is(.lr-diseno-b, .lr-diseno-d) .lr-card-presencia .lr-circulos,
  :is(.lr-diseno-b, .lr-diseno-d) .lr-card-presencia .lr-leyenda, :is(.lr-diseno-b, .lr-diseno-d) .tx-turnos-tit { display:none !important; }
  .lr-diseno-c .lrB-solapas, .lr-diseno-c .lrB-panel, .lr-diseno-c .lrB-quien, .lr-diseno-c .lrB-chat-acc,
  .lr-diseno-c .lrB-diseno, .lr-diseno-c .lrA-clase { display:none !important; }

  /* ════════════════════════════════════════════════════════════════════════
     Lo común a B y C (S4). A "Ordenada" se retiró el 2026-11-22.
     ════════════════════════════════════════════════════════════════════════ */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d).lr-wrap { max-width:1180px; }

  /* La barra vieja de la presencia (el punto, el texto, #lrModo y #lrFotos, que siguen
     existiendo para que los interruptores les deleguen el clic) no se ve. */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-card-presencia > .lr-barra { display:none; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-card-presencia .lr-circulos { margin-top:0; }

  /* Cabecera */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab { padding:0; overflow:visible; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-fila { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:14px 16px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-txt { min-width:0; flex:1 1 220px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-titulo { font-size:18px; font-weight:500; line-height:1.25; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-sub { font-size:13px; color:var(--lr-tenue); margin-top:2px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-acc { margin-left:auto; align-items:center; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-pill { display:inline-flex; align-items:center; gap:6px; padding:4px 10px;
                           border-radius:14px; font-size:12.5px; font-weight:700; letter-spacing:.02em;
                           background:#fce8e6; color:#a50e0e; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-pill i { width:8px; height:8px; border-radius:50%; background:#d93025; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-pill.off { background:#f1f3f4; color:#3c4043; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-pill.off i { background:#80868b; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-aviso:empty { display:none; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-aviso { border-top:1px solid var(--border); }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-aviso .lr-aviso { margin:0; border:0; border-radius:0 0 12px 12px;
                           padding:9px 16px; background:#fffaf0; color:#5f4b00; font-size:12.5px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-cab-aviso .lr-aviso small { display:inline; margin:0 0 0 4px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) #lrCampana { border-radius:50%; }

  /* Los interruptores (A y B) */
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-fila { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-rotulo { font-size:11.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
                             color:var(--lr-tenue); margin-right:4px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog { display:inline-flex; align-items:center; gap:8px; padding:7px 12px; border-radius:10px;
                          border:1px solid var(--border); background:var(--surface); color:var(--text);
                          font-size:13.5px; font-family:inherit; cursor:pointer; text-align:left; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog .material-symbols-outlined { font-size:18px; color:var(--lr-tenue); }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-switch { position:relative; width:34px; height:18px; border-radius:9px; background:#bdc1c6; flex:none; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-switch::after { content:''; position:absolute; top:2px; left:2px; width:14px; height:14px;
                                    border-radius:50%; background:#ffffff; transition:left .15s; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog[aria-checked="true"] .lrA-switch { background:#1a73e8; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog[aria-checked="true"] .lrA-switch::after { left:18px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog:focus-visible { outline:2px solid #1a73e8; outline-offset:2px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-slot { display:inline-flex; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-btns { margin-top:10px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-btns:empty { display:none; }
  :is(.lr-diseno-b, .lr-diseno-d) #lrActividad { background:#1a73e8; border-color:#1a73e8; color:#ffffff; font-weight:600; }
  :is(.lr-diseno-b, .lr-diseno-d) #lrCerrar { border-color:#f3b8b4; color:#c5221f; }

  /* Contadores de la presencia (A y C) */
  .lr-diseno-c .lrA-chips { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chip { display:inline-flex; align-items:center; gap:6px; padding:4px 11px; border-radius:14px;
                           font-size:13px; background:var(--bg); color:var(--text); }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chip b { font-weight:600; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) :is(.lrA-chip, .lrB-g-tit) i { width:9px; height:9px; border-radius:50%; flex:none; display:inline-block; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) :is(.lrA-chip, .lrB-g-tit) .c-on  { background:#34a853; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) :is(.lrA-chip, .lrB-g-tit) .c-act { background:#f9ab00; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) :is(.lrA-chip, .lrB-g-tit) .c-est { width:7px; height:7px; border:2px dashed #34a853; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) :is(.lrA-chip, .lrB-g-tit) .c-off { background:#9aa0a6; }

  /* Transmisión */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .tx-toggle.activo { background:#e6f4ea; border-color:#34a853; color:#0d652d; }
  :is(.lr-diseno-b, .lr-diseno-d) #txCerrar { border-color:#f3b8b4; color:#c5221f; }
  .lr-diseno-c .tx-turnos-tit { display:none; font-size:11.5px; font-weight:700; letter-spacing:.06em;
                                text-transform:uppercase; color:var(--lr-tenue); margin:14px 0 8px; }

  /* Chat */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chat-cab { display:flex; align-items:center; gap:8px; margin:-14px -16px 12px;
                               padding:12px 16px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chat-cab > .material-symbols-outlined { color:#1a73e8; font-size:20px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chat-tit { font-weight:500; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrA-chat-estado { margin-left:auto; font-size:12.5px; color:var(--lr-tenue);
                                  white-space:nowrap; display:inline-flex; align-items:center; gap:4px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-msg.mio { flex-direction:row-reverse; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-msg.mio > div:last-child { display:flex; flex-direction:column; align-items:flex-end; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-msg.mio .lr-burbuja { background:#d3e3fd; color:#041e49; border-top-left-radius:12px; border-top-right-radius:2px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lr-sistema { display:table; margin:10px auto; padding:4px 12px; border-radius:14px; background:var(--bg); }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) #lrComposerBox { flex-direction:column; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) #lrComposerBox:not([style*="none"]) { display:flex; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) #lrRespondiendo { order:1; }
  .lr-diseno-c #lrComposerBox .lr-emojis { order:2; margin:0 0 8px; }
  .lr-diseno-c #lrComposerBox .lr-composer { order:3; border-radius:24px; padding:6px 6px 6px 14px; }
  .lr-diseno-c #lrEnviar { width:40px; height:40px; border-radius:50%; background:#1a73e8; color:#ffffff;
                           display:flex; align-items:center; justify-content:center; }
  .lr-diseno-c #lrEnviar .material-symbols-outlined { color:#ffffff; }

  /* El selector de diseño */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) #lrDisenoMenu [role="menuitemradio"] small { display:block; }

  /* ════════════════════════════════════════════════════════════════════════
     B "Panel lateral" — specs/maquetas-sala/B-panel-lateral-*.png
     Computadora: cabecera arriba, y debajo dos columnas: la clase (video y chat) a la izquierda
     y un panel fijo a la derecha (controles, manos, quién está). Celular: solapas.
     ════════════════════════════════════════════════════════════════════════ */
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-cab-fila { padding:12px 16px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-tit { display:flex; align-items:center; gap:8px; font-size:11.5px; font-weight:700; letter-spacing:.06em;
                          text-transform:uppercase; color:var(--lr-tenue); margin-bottom:10px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-tit .material-symbols-outlined { font-size:18px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-tit-n { margin-left:auto; text-transform:none; letter-spacing:0; font-weight:500; color:var(--text); font-size:13px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-vacio { font-size:13px; color:var(--lr-tenue); }

  /* Controles de la clase: lista vertical con explicación */
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-fila { flex-direction:column; align-items:stretch; gap:0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-rotulo { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-rotulo .t-b { display:inline-flex; align-items:center; gap:8px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-rotulo .material-symbols-outlined { font-size:18px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog { border:0; border-bottom:1px solid var(--border); border-radius:0; padding:10px 2px; background:transparent; width:100%; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog-txt { flex:1; min-width:0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog-txt small { display:block; font-size:12px; color:var(--lr-tenue); }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-tog .lrA-switch { margin-left:auto; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-slot { display:flex; padding:10px 0 2px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-slot #lrSonidoClase { width:100%; justify-content:space-between; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-btns { flex-direction:column; align-items:stretch; display:flex; gap:8px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-clase-btns .btn { width:100%; justify-content:center; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-diseno:empty { display:none; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-diseno { margin-top:8px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-diseno #lrDiseno { width:100%; justify-content:center; }

  /* Manos levantadas y quién está, en el panel */
  :is(.lr-diseno-b, .lr-diseno-d) #lrBManosSlot .tx-manos { margin-top:0; display:block !important; }
  :is(.lr-diseno-b, .lr-diseno-d) #lrBManosSlot .tx-mano:first-child { border-top:0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-quien-tit { display:flex; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-grupo { margin-bottom:12px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-g-tit { display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--lr-tenue); margin-bottom:6px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-bolas { display:flex; flex-wrap:wrap; gap:6px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-bolas .lr-bola, :is(.lr-diseno-b, .lr-diseno-d) .lrB-fila .lr-bola { width:38px; height:38px; font-size:14px; margin:3px; flex:none; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-fila { display:flex; align-items:center; gap:10px; font-size:13.5px; padding:3px 0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-fila span { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-fila small { color:var(--lr-tenue); font-size:12px; white-space:nowrap; }
  /* Cada círculo con el nombre debajo (2026-11-26). */
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-bolas:has(.lrB-persona) { display:grid; grid-template-columns:repeat(auto-fill, minmax(78px, 1fr)); gap:10px 6px; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-persona { display:flex; flex-direction:column; align-items:center; gap:4px; min-width:0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-persona .lr-bola { margin:0; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-persona-nom { font-size:11.5px; line-height:1.25; text-align:center; color:var(--text);
                          width:100%; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; word-break:break-word; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-persona:has(.lr-off) .lrB-persona-nom { color:var(--lr-tenue); }

  /* D: "Quién está" va primero en el panel y se destaca (pedido del 2026-11-26: "está muy
     escondida la sección donde nos indica qué alumno se conectó"). */
  .lr-diseno-d .lrB-panel { display:flex; flex-direction:column; }   /* sin id: el celular la sigue escondiendo con data-solapa */
  .lr-diseno-d #lrBSlotQuien { order:-1; }
  .lr-diseno-d #lrBSlotQuien .lr-card-presencia { border-left:4px solid #34a853; }
  .lr-diseno-d .lrB-quien-tit { font-size:13.5px; color:var(--text); }
  .lr-diseno-d .lrB-quien-tit .material-symbols-outlined { color:#34a853; }
  .lr-diseno-d .lrB-quien-tit .lrB-tit-n { font-size:14px; font-weight:600; }
  .lr-diseno-d .lrB-quien-tit #lrDLado { margin-left:10px; }
  /* Mientras se transmite, "Quién está" va arriba del chat, en la columna derecha (ubicarQuien).
     Con muchos alumnos no se come el chat: tiene alto máximo y se desplaza adentro. */
  .lr-diseno-d .lr-card-chat > .lr-card-presencia { margin:0 0 12px; padding:12px 14px 10px; box-shadow:none; border:1px solid var(--border); border-left:4px solid #34a853;
                          border-radius:10px; max-height:250px; overflow-y:auto; }
  .lr-diseno-d .lr-card-chat:has(> .lr-card-presencia) #lrChat { max-height:max(220px, calc(100vh - 600px)) !important; }

  /* La transmisión: botones redondos debajo del video, quién habla como pastilla */
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro:empty { display:none; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro #txControles { margin-top:12px !important; justify-content:center; gap:18px; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro :is(.tx-toggle, #txCerrar) { flex-direction:column; gap:6px; border:0; background:transparent;
                          padding:0; font-size:12.5px; color:var(--text); min-width:64px; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro :is(.tx-toggle, #txCerrar) .material-symbols-outlined { width:48px; height:48px; border-radius:50%;
                          display:flex; align-items:center; justify-content:center; background:var(--bg); font-size:22px; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro .tx-toggle.activo { background:transparent; color:var(--text); }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro .tx-toggle.activo .material-symbols-outlined { background:#d3e3fd; color:#0b57d0; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-bajo-cuadro #txCerrar .material-symbols-outlined { background:#fce8e6; color:#c5221f; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-hablando { display:inline-flex; background:#3c4043; border-color:#3c4043; color:#ffffff; border-radius:20px; }
  :is(.lr-diseno-b, .lr-diseno-d) .tx-hablando .btn { background:#ffffff; color:#c5221f; border-color:#ffffff; }

  /* El chat: la campana y "Clases anteriores" en su cabecera; la etiqueta DOCENTE */
  :is(.lr-diseno-b, .lr-diseno-d) .lrB-chat-acc { margin-left:auto; display:inline-flex; gap:8px; align-items:center; }
  :is(.lr-diseno-b, .lr-diseno-d) .lrA-chat-estado { margin-left:0; }

  @media (min-width: 900px) {
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap { display:grid; grid-template-columns:minmax(0, 1fr) 340px; column-gap:16px; align-items:start; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > * { grid-column:1; min-width:0; }
    /* grid-row:1 explícito: sin él, el aviso de asistencia del alumno (#asBanda, que va ANTES en
       el HTML aunque esté vacío) se quedaba con la fila 1 y la cabecera caía debajo del panel o
       del video. Se vio al fijar D para todos (2026-11-22): antes los alumnos casi no lo veían. */
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #lrACab { grid-column:1 / -1; grid-row:1; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #lrBPanel { grid-column:2; grid-row:2 / span 40; position:sticky; top:12px; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-solapas { display:none !important; }
    /* El chat ocupa el alto de la ventana y tiene su propio scroll: el cuadro de escribir no se
       va nunca de la pantalla (CA-16). */
    :is(.lr-diseno-b, .lr-diseno-d) .lr-card-chat #lrChat { max-height:calc(100vh - 290px); min-height:260px; }
  }
  @media (max-width: 899px) {
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap { display:flex; flex-direction:column; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > * { order:5; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #asBanda, :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #asAviso { order:0; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #lrACab { order:1; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #lrBSolapas { order:2; }
    :is(.lr-diseno-b, .lr-diseno-d).lr-wrap > #txCard { order:3; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-solapas { display:flex; gap:4px; padding:6px; margin-bottom:12px; background:var(--surface);
                                border:1px solid var(--border); border-radius:12px; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-solapas button { flex:1; display:inline-flex; align-items:center; justify-content:center; gap:6px;
                                       padding:9px 6px; border:0; border-radius:8px; background:transparent; color:var(--text);
                                       font:inherit; font-size:13.5px; cursor:pointer; position:relative; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-solapas button[aria-selected="true"] { background:#e8f0fe; color:#0b57d0; font-weight:500; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-solapas button.nuevo::after { content:''; position:absolute; top:6px; right:10px; width:8px; height:8px;
                                                    border-radius:50%; background:#d93025; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-n:empty { display:none; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-n-rojo { background:#d93025; color:#ffffff; border-radius:10px; padding:0 7px; font-size:12px; }
    /* Una solapa a la vista; la transmisión, siempre (el alumno no deja de ver la clase por
       mirar quién está). */
    :is(.lr-diseno-b, .lr-diseno-d):not([data-solapa="chat"]) .lr-card-chat { display:none; }
    :is(.lr-diseno-b, .lr-diseno-d)[data-solapa="chat"] .lrB-panel { display:none; }
    :is(.lr-diseno-b, .lr-diseno-d) .lrB-panel > [data-parte] { display:none; }
    :is(.lr-diseno-b, .lr-diseno-d)[data-solapa="personas"]  .lrB-panel > [data-parte="personas"],
    :is(.lr-diseno-b, .lr-diseno-d)[data-solapa="manos"]     .lrB-panel > [data-parte="manos"],
    :is(.lr-diseno-b, .lr-diseno-d)[data-solapa="controles"] .lrB-panel > [data-parte="controles"] { display:block; }
  }

  /* ════════════════════════════════════════════════════════════════════════
     C "Modo aula" — specs/maquetas-sala/C-modo-aula-*.png
     Barra de arriba, escenario a la izquierda, chat a la derecha y la barra de botones fija
     abajo. La maqueta es oscura, pero C SIGUE EL TEMA DEL SITIO (pedido del 2026-11-22: "que se
     acople a la situación"): en claro se ve claro y con el botón de tema pasa a oscuro, igual que
     el resto de la plataforma. Por eso acá todo va con las variables del sitio, y cada color fijo
     tiene su par en el bloque del tema oscuro de más abajo.
     ════════════════════════════════════════════════════════════════════════ */
  .lr-diseno-c.lr-wrap { background:var(--bg); color:var(--text); border:1px solid var(--border); border-radius:14px; padding:0 0 4px; }

  /* Barra de arriba */
  .lr-diseno-c .lrA-cab { background:var(--surface); color:var(--text); border:0; border-bottom:1px solid var(--border);
                          border-radius:14px 14px 0 0; margin-bottom:12px; }
  .lr-diseno-c .lrA-cab-fila { padding:10px 14px; gap:10px; }
  .lr-diseno-c .lrC-volver { color:var(--text); display:flex; text-decoration:none; }
  .lr-diseno-c .lrC-curso { display:flex; flex-direction:column; line-height:1.2; }
  .lr-diseno-c .lrC-curso b { font-size:16px; font-weight:500; }
  .lr-diseno-c .lrC-curso small { font-size:12.5px; color:var(--lr-tenue); }
  .lr-diseno-c .lrA-pill { background:#d93025; color:#ffffff; }
  .lr-diseno-c .lrA-pill i { background:#ffffff; }
  .lr-diseno-c .lrA-cab-txt { flex:0 1 auto; }
  .lr-diseno-c .lrA-titulo { display:none; }
  .lr-diseno-c .lrC-reloj { font-variant-numeric:tabular-nums; color:var(--lr-tenue); font-size:13px; }
  .lr-diseno-c .lrC-cuenta { display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:18px;
                             background:var(--bg); color:var(--text); font-size:13.5px; margin-left:auto; }
  .lr-diseno-c .lrC-cuenta .material-symbols-outlined { font-size:18px; color:#188038; }
  .lr-diseno-c .lrA-cab-acc { margin-left:0; }
  .lr-diseno-c .lrA-cab-aviso { border-top:0; }
  .lr-diseno-c .lrA-cab-aviso .lr-aviso { border-radius:0; }

  /* Escenario, presencia y chat */
  .lr-diseno-c .tx-card { position:relative; }
  .lr-diseno-c .lr-card-presencia .lrA-chips { margin-bottom:10px; }
  .lr-diseno-c .lrB-quien-tit { display:flex; align-items:center; gap:8px; font-weight:500; margin-bottom:8px; }
  .lr-diseno-c .lrB-quien-tit .lrB-tit-n { color:var(--lr-tenue); font-weight:400; font-size:13px; }
  /* Sobre el video las manos y la palabra flotan (como en Meet); el cuadro flotante es oscuro y
     translúcido en los dos temas porque va encima de una imagen, no del fondo de la página. */
  .lr-diseno-c .tx-card > #txManos::before { content:'Manos levantadas'; display:block; font-size:11.5px; font-weight:700;
                          letter-spacing:.06em; text-transform:uppercase; color:var(--lr-tenue); margin-bottom:4px; }
  .lr-diseno-c .tx-card:has(#txCuadro:not([style*="none"])) > #txManos { position:absolute; right:24px; bottom:24px; z-index:2;
                          width:340px; max-width:calc(100% - 48px); margin:0; padding:10px 14px; border-radius:12px;
                          background:rgba(32,33,36,.94); color:#e8eaed; }
  .lr-diseno-c .tx-card:has(#txCuadro:not([style*="none"])) > #txManos::before { color:#fdd663; }
  .lr-diseno-c .tx-card:has(#txCuadro:not([style*="none"])) > #txManos .tx-mano { border-top-color:#3c4043; }
  .lr-diseno-c .tx-card:has(#txCuadro:not([style*="none"])) > #txHablando { position:absolute; left:24px; bottom:24px; z-index:2; margin:0;
                          border-radius:22px; background:#188038; border-color:#188038; color:#ffffff; }
  .lr-diseno-c .tx-card:has(#txCuadro:not([style*="none"])) > #txHablando .btn { background:#ffffff; color:#c5221f; border-color:#ffffff; }

  /* El escenario primero y "Quién está" debajo (maqueta), aunque en el HTML vayan al revés.
     Vale en la grilla de la computadora y en la columna del celular. */
  .lr-diseno-c.lr-wrap > * { order:3; }
  .lr-diseno-c.lr-wrap > :is(#asBanda, #asAviso) { order:-1; }
  .lr-diseno-c.lr-wrap > #lrACab { order:0; }
  .lr-diseno-c.lr-wrap > #txCard { order:1; }
  .lr-diseno-c.lr-wrap > #lrPresencia { order:2; }
  .lr-diseno-c.lr-wrap > #lrCBarra { order:9; }

  /* La barra de abajo: fija al pie de la ventana mientras se ve la sala */
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra { position:sticky; bottom:0; z-index:5; display:flex; align-items:flex-start; justify-content:center;
                            gap:0; padding:12px 10px 10px; background:var(--surface); color:var(--text); border-top:1px solid var(--border);
                            overflow-x:auto; border-radius:0 0 14px 14px; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-grupo { display:flex; align-items:flex-start; gap:14px; padding:0 14px; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-grupo:empty { display:none; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-grupo + .lrC-grupo { border-left:1px solid var(--border); }
  :is(.lr-diseno-c, .lr-diseno-d) #lrCBarraTx #txControles { margin:0 !important; gap:14px; flex-wrap:nowrap; }
  :is(.lr-diseno-c, .lr-diseno-d) #lrCBarraTx #txManoCaja { margin:0 !important; }
  /* Todo botón de la barra: un círculo con el icono y el rótulo debajo */
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra :is(.btn, .tx-toggle, .lrC-bot) { display:inline-flex; flex-direction:column; align-items:center; gap:6px;
                          border:0; background:transparent; color:var(--text); padding:0; min-width:64px; max-width:84px;
                          font:inherit; font-size:12px; line-height:1.2; text-align:center; cursor:pointer; white-space:normal; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra :is(.btn, .tx-toggle, .lrC-bot) > .material-symbols-outlined:first-child,
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra :is(#lrAbrir, #lrCerrar, #lrSonidoClase)::before {
                          width:52px; height:52px; border-radius:50%; display:flex; align-items:center; justify-content:center;
                          background:var(--bg); color:var(--text); font-size:24px; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra :is(#lrAbrir, #lrCerrar, #lrSonidoClase)::before {
                          font-family:'Material Symbols Outlined'; font-weight:normal; font-style:normal; line-height:1;
                          -webkit-font-feature-settings:'liga'; font-feature-settings:'liga'; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #lrAbrir::before { content:'play_arrow'; background:#1a73e8; color:#ffffff; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #lrCerrar::before { content:'call_end'; background:#d93025; color:#ffffff; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #lrSonidoClase::before { content:'campaign'; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra .tx-toggle.activo { background:transparent; color:var(--text); }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra :is(.tx-toggle.activo, .lrC-bot[aria-pressed="true"]) > .material-symbols-outlined:first-child { background:#d3e3fd; color:#0b57d0; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra .tx-toggle:not(.activo) > .material-symbols-outlined:first-child { background:#fce8e6; color:#c5221f; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #lrActividad > .material-symbols-outlined:first-child { background:#1a73e8; color:#ffffff; width:60px; border-radius:26px; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #txVer > .material-symbols-outlined:first-child { background:#1a73e8; color:#ffffff; }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #txNoVer > .material-symbols-outlined:first-child { border:2px solid #1a73e8; }
  /* Los menús que cuelgan de la barra se abren hacia arriba */
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra .lr-menu { top:auto; bottom:calc(100% + 8px); }
  :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra #lrCBarraClase { position:relative; }

  @media (min-width: 900px) {
    .lr-diseno-c.lr-wrap { display:grid; grid-template-columns:minmax(0, 1fr) 380px; column-gap:16px; align-items:start; }
    .lr-diseno-c.lr-wrap > * { grid-column:1; min-width:0; margin-left:14px; }
    .lr-diseno-c.lr-wrap > #lrACab, .lr-diseno-c.lr-wrap > #lrCBarra { grid-column:1 / -1; margin-left:0; }
    .lr-diseno-c.lr-wrap > .lr-card-chat { grid-column:2; grid-row:2 / span 40; margin-left:0; margin-right:14px; position:sticky; top:12px; }
    .lr-diseno-c .lr-card-chat #lrChat { max-height:calc(100vh - 330px); min-height:280px; }
  }
  @media (max-width: 899px) {
    .lr-diseno-c.lr-wrap { padding:0 8px 0; display:flex; flex-direction:column; }
    :is(.lr-diseno-c, .lr-diseno-d) .lrC-barra { justify-content:flex-start; margin:0 -8px; }
    .lr-diseno-c .lrA-cab { margin:0 -8px 12px; }
  }

  /* ── Hasta el primer poll (data-cargando, solo en la solapa "En vivo" de la materia) ──
     El render sale con la sala "cerrada" porque la página no consulta la sala; mostrar eso
     —"La sala no está abierta", el botón "Abrir sala"— medio segundo y después lo real parecía
     que se entraba por primera vez. Mientras tanto: la cabecera dice "Cargando la sala…" y el
     resto no se ve. */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d)[data-cargando] > :not(#lrACab) { visibility:hidden; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d)[data-cargando] #lrACab :is(.lrA-pill, .lrA-titulo, .lrA-sub, .lrD-cab-tx, .lrC-reloj, .lrC-cuenta, .lrA-cab-acc) { display:none !important; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d)[data-cargando] #lrACab .lrA-cab-txt::before {
    content:"Cargando la sala…"; font-size:15px; color:var(--text-secondary); }

  /* ── Archivos de la clase en miniatura (B, C y D) — specs/sala-dibujo-y-archivos.spec.md, AR ──
     Solo variables del tema: sigue el botón claro/oscuro sin un par [data-theme="dark"]. */
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos { margin-top:10px; padding-top:8px; border-top:1px solid var(--border); }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos[data-n="0"] { display:none; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos-solapas { display:flex; gap:4px; margin-bottom:8px; overflow-x:auto; scrollbar-width:none;
    border-bottom:1px solid var(--border); }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-solapa { display:inline-flex; align-items:center; gap:5px;
    padding:6px 10px; margin-bottom:-1px; border:0; border-bottom:2px solid transparent; background:transparent;
    font:inherit; font-size:12.5px; font-weight:600; color:var(--text-secondary); cursor:pointer; white-space:nowrap; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-solapa[aria-selected="true"] { color:var(--primary, #1a73e8); border-bottom-color:currentColor; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-solapa .material-symbols-outlined { font-size:17px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos-n { font-weight:400; }
  @media (max-width:480px) {
    /* En el celular las dos solapas tienen que entrar en el ancho del chat: sin icono y más justas. */
    :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-solapa { padding:6px 6px; gap:3px; font-size:12px; }
    :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-solapa .material-symbols-outlined { display:none; }
  }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos-vacio { font-size:12.5px; color:var(--text-secondary); padding:6px 2px 10px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-archivos-tira { display:flex; gap:8px; overflow-x:auto;
    padding-bottom:4px; scrollbar-width:thin; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch { flex:0 0 56px; width:56px; height:56px; border-radius:8px;
    overflow:hidden; border:1px solid var(--border); background:var(--bg); color:var(--text);
    display:flex; align-items:center; justify-content:center; text-decoration:none; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch:hover,
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch:focus-visible { outline:2px solid var(--primary, #1a73e8); outline-offset:1px; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-img img { width:100%; height:100%; object-fit:cover; display:block; }
  :is(.lr-diseno-b, .lr-diseno-c, .lr-diseno-d) .lrB-arch-file .lr-ext { width:44px; height:44px; }

  /* ════════════════════════════════════════════════════════════════════════
     D "Aula virtual" — specs/sala-diseno-d.spec.md
     La base es B (todas las reglas de B de arriba valen también para D). Acá va solo lo que
     cambia: el botón Abrir/Cerrar en la cabecera (D1), la transmisión solo con la sala abierta
     (D2), la barra de abajo de C (D3), el video arriba en el celular (D4) y el celular de costado
     a pantalla completa con el chat a la derecha (D5).
     ════════════════════════════════════════════════════════════════════════ */
  /* D1: Abrir / Cerrar sala en la cabecera (son los dos botones de siempre; se ve uno a la vez) */
  .lr-diseno-d .lrA-cab-acc { margin-left:auto; }
  .lr-diseno-d .lrA-cab-acc #lrCerrar { border-color:#f3b8b4; color:#c5221f; }

  /* D6: el estado de la transmisión y "Transmitir" en el medio de la cabecera. "Hablar" (solo
     voz) no se ofrece en D. La tarjeta de la transmisión aparece recién mientras se transmite. */
  .lr-diseno-d .lrA-cab-txt { flex:0 1 auto; }
  .lr-diseno-d .lrD-cab-tx { flex:1 1 260px; display:flex; justify-content:center; min-width:0; }
  .lr-diseno-d .lrD-cab-tx #txBarra { margin:0; padding:6px 8px 6px 14px; gap:12px; flex-wrap:nowrap;
                                      border:1px solid var(--border); border-radius:24px; background:var(--bg); }
  .lr-diseno-d .lrD-cab-tx #txBarra .tx-acciones { flex-wrap:nowrap; }
  /* "Dejar de transmitir" ocupa el lugar de "Transmitir" en la cabecera: misma pastilla, en rojo. */
  .lr-diseno-d .lrD-cab-tx #txBarra #txCerrar { border-radius:20px; white-space:nowrap; }
  .lr-diseno-d .lrD-cab-tx #txEstadoTexto { font-size:13.5px; }
  .lr-diseno-d #txHablar { display:none !important; }
  .lr-diseno-d[data-tx="no"] #txCard { display:none !important; }
  .lr-diseno-d[data-tx="no"] #lrCBarraTx { display:none !important; }
  .lr-diseno-d[data-estado="cerrada"] .lrD-cab-tx { display:none !important; }
  /* Con la sala cerrada la tarjeta de controles queda vacía (sus interruptores son de la clase
     abierta), y desde que no hay botón "Diseño" no le queda nada adentro: no se muestra. */
  .lr-diseno-d[data-estado="cerrada"] #lrAClase { display:none !important; }

  /* D7: al transmitir, la sala se reacomoda — el video a la izquierda y el chat a la derecha.
     Los controles, las manos y quién está quedan detrás de "Más opciones", arriba de la columna
     derecha, que alterna con el chat. Solo en pantallas anchas: en el celular siguen las solapas
     (parado) o la pantalla completa (de costado, D5). */
  .lr-diseno-d .lrD-lado { display:none; }
  .lr-diseno-d .lrD-lado-n:empty { display:none; }
  .lr-diseno-d .lrD-lado-n { background:#d93025; color:#ffffff; border-radius:10px; padding:0 7px; font-size:12px; margin-left:2px; }
  @media (min-width: 900px) {
    /* El chat, un poco más ancho mientras se transmite (pedido del 2026-11-22). */
    .lr-diseno-d[data-tx="activa"].lr-wrap { grid-template-columns:minmax(0, 1fr) 440px; }
    .lr-diseno-d[data-tx="activa"].lr-wrap > .lr-card-chat,
    .lr-diseno-d[data-tx="activa"].lr-wrap > #lrBPanel { grid-column:2; grid-row:2 / span 40; position:sticky; top:12px; }
    /* El botón vive adentro de la cabecera del chat o del título de las opciones (lo muda el
       script); ahí va a la derecha y más chico. */
    .lr-diseno-d .lrA-chat-cab #lrDLado,
    .lr-diseno-d .lrA-rotulo #lrDLado,
    .lr-diseno-d .lrB-tit #lrDLado { margin-left:auto; padding:5px 12px; font-size:13px; text-transform:none;
                                     letter-spacing:0; font-weight:500; }
    /* Cabecera del chat con el botón: arriba "Conversación" y el botón; abajo, el estado de la
       escritura a la izquierda y la campana y "Clases anteriores" a la derecha. */
    .lr-diseno-d .lrA-chat-cab:has(#lrDLado) #lrDLado { order:2; }
    .lr-diseno-d .lrA-chat-cab:has(#lrDLado) .lrA-chat-estado { margin-left:0; order:4; }
