<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nueva tarea — <%= course.name %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="creator-page">

  <!-- Header fijo -->
  <header class="creator-header">
    <div class="creator-header-left">
      <a href="/courses/<%= course._id %>" class="icon-btn" title="Cancelar">
        <span class="material-symbols-outlined">close</span>
      </a>
      <span class="material-symbols-outlined creator-header-icon">assignment</span>
      <span class="creator-header-title">Tarea</span>
    </div>
    <div class="creator-header-right">
      <div id="globalError" class="creator-error-inline" style="display:none"></div>
      <button class="btn btn-primary" id="createBtn" onclick="submitActivity()">
        Crear tarea
      </button>
    </div>
  </header>

  <!-- Cuerpo de dos columnas -->
  <div class="creator-body">

    <!-- Columna principal -->
    <div class="creator-main">

      <!-- Card: Título + Instrucciones -->
      <div class="creator-card">
        <div class="creator-title-field">
          <input type="text" id="actTitle" class="creator-title-input" placeholder="Título">
          <span class="creator-required">* Obligatorio</span>
        </div>
        <div class="creator-divider"></div>
        <div class="creator-editor-wrap">
          <div
            id="actInstructions"
            class="creator-editor"
            contenteditable="true"
            data-placeholder="Instrucciones (opcional)"
          ></div>
          <div class="creator-toolbar">
            <button type="button" class="toolbar-btn" onclick="fmt('bold')" title="Negrita"><strong>B</strong></button>
            <button type="button" class="toolbar-btn" onclick="fmt('italic')" title="Cursiva"><em>I</em></button>
            <button type="button" class="toolbar-btn" onclick="fmt('underline')" title="Subrayado"><u>U</u></button>
            <button type="button" class="toolbar-btn" onclick="fmt('insertUnorderedList')" title="Lista">
              <span class="material-symbols-outlined">format_list_bulleted</span>
            </button>
            <button type="button" class="toolbar-btn" onclick="fmt('strikeThrough')" title="Tachado">
              <s>S</s>
            </button>
          </div>
        </div>
      </div>

      <!-- Card: Adjuntar -->
      <div class="creator-card">
        <div class="creator-card-section-title">Adjuntar</div>
        <div class="creator-att-row">
          <label class="creator-att-btn" title="Subir archivo (PDF, Word, Excel, plano DWG o DXF) o imagen">
            <input type="file" id="fileInput"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.dwg,.dxf,.jpg,.jpeg,.jfif,.png,.webp,.gif,.avif,.tif,.tiff"
                   multiple hidden>
            <div class="creator-att-circle">
              <span class="material-symbols-outlined">upload</span>
            </div>
            <span>Subir</span>
          </label>
          <label class="creator-att-btn" title="Subir una foto o imagen">
            <input type="file" id="imageInput" accept="image/*,.jfif,.avif,.tif,.tiff" multiple hidden>
            <div class="creator-att-circle">
              <span class="material-symbols-outlined">image</span>
            </div>
            <span>Imagen</span>
          </label>
          <button type="button" class="creator-att-btn" onclick="openLinkDialog()" title="Agregar enlace">
            <div class="creator-att-circle">
              <span class="material-symbols-outlined">link</span>
            </div>
            <span>Enlace</span>
          </button>
        </div>

        <!-- Input de enlace -->
        <div id="linkDialog" class="creator-link-dialog" style="display:none">
          <div class="input-group" style="flex:1">
            <span class="material-symbols-outlined input-icon">link</span>
            <input type="url" id="linkUrlInput" placeholder="https://...">
          </div>
          <button class="btn btn-primary" style="padding:0 18px;height:46px" onclick="addLink()">Agregar</button>
          <button class="icon-btn" onclick="closeLinkDialog()" title="Cancelar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <!-- Previsualización de adjuntos -->
        <div id="attPreviews" class="att-preview-grid" style="padding:0 24px 20px;margin-top:4px"></div>
      </div>

    </div>

    <!-- Sidebar -->
    <aside class="creator-sidebar">

      <div class="sidebar-card">
        <div class="sidebar-label">Para</div>
        <div class="sidebar-course-name"><%= course.name %></div>
        <% if (course.division?.name) { %>
          <div class="sidebar-course-sub"><%= course.division.name %></div>
        <% } %>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Asignar a</div>
        <div class="sidebar-chip">
          <span class="material-symbols-outlined">group</span>
          Todos los alumnos
        </div>
      </div>

      <!-- Selector de plantilla — se muestra sólo si el server devuelve plantillas
           disponibles (feature flag TASK_TEMPLATES_TEACHER_ENABLED). Si el flag
           está apagado, este bloque queda oculto y el docente ve el form idéntico
           a como venía siendo. -->
      <div class="sidebar-card" id="templateCard" style="display:none">
        <div class="sidebar-label">Usar plantilla</div>
        <div class="sidebar-input-wrap">
          <select id="sTemplateId" class="sidebar-input">
            <option value="">— Sin plantilla —</option>
          </select>
        </div>
        <div class="sidebar-hint" id="templateHint">Actividad interactiva; el sistema califica automáticamente.</div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Tipo</div>
        <div class="sidebar-input-wrap">
          <select id="sType" class="sidebar-input">
            <option value="tarea">Tarea</option>
            <option value="evaluacion">Evaluación</option>
            <option value="tp">Trabajo Práctico</option>
          </select>
        </div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Puntos</div>
        <div class="sidebar-input-wrap">
          <input type="number" id="sPoints" class="sidebar-input" value="10" min="0" max="10" placeholder="Sin puntos">
        </div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Disponible desde</div>
        <div class="sidebar-input-wrap">
          <input type="datetime-local" id="sAvailableFrom" class="sidebar-input" onchange="avisoProgramada('sAvailableFrom','sAvailableHint')">
        </div>
        <div class="sidebar-hint" id="sAvailableHint">Por defecto: ahora mismo</div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Fecha de entrega</div>
        <div class="sidebar-input-wrap">
          <input type="datetime-local" id="sDueDate" class="sidebar-input">
        </div>
        <div class="sidebar-hint">Vacío = sin fecha límite</div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label">Edición del alumno</div>
        <label style="display:flex;align-items:flex-start;gap:8px;font-size:14px;cursor:pointer;padding:4px 0">
          <input type="checkbox" id="sAllowResubmission" style="margin-top:3px">
          <span>Permitir que el alumno edite su entrega después de enviarla</span>
        </label>
        <div class="sidebar-hint">Sin marcar: una vez entregada, el alumno solo puede visualizarla.</div>
      </div>

    </aside>
  </div>

  <!-- Modal de error de adjunto -->
  <div id="uploadErrModal" class="upl-modal-overlay" style="display:none" onclick="if(event.target===this)closeUploadErrModal()">
    <div class="upl-modal">
      <div class="upl-modal-icon">
        <span class="material-symbols-outlined">error</span>
      </div>
      <p class="upl-modal-title" id="uplModalTitle"></p>
      <p class="upl-modal-msg"   id="uplModalMsg"></p>
      <button class="btn btn-primary" onclick="closeUploadErrModal()">Entendido</button>
    </div>
  </div>

  <!-- Diagnóstico de subidas fallidas. Va ANTES del script de esta página, que lo usa. -->
  <script src="/js/subida-diagnostico.js"></script>
  <!-- Regla compartida con el servidor de qué adjunto es una imagen (window.Adjuntos). -->
  <script src="/js/adjuntosActividad.js"></script>
  <script>
    const COURSE_ID = '<%= course._id %>';
    // Las imágenes van por su propia ruta: se recomprimen a WebP antes de tocar el disco.
    // El resto (PDF, Word, Excel) sigue yendo por donde iba.
    //
    // La ruta se arma en UN solo lugar y no dos veces: el diagnóstico reporta la ruta que
    // falló, y si la que reporta no es exactamente la que se llamó, el reporte manda a buscar
    // al lugar equivocado — que es el único error que un diagnóstico no puede permitirse.
    function rutaDeSubida(nombre) {
      const endpoint = Adjuntos.esImagen(nombre) ? 'upload-image' : 'upload-attachment';
      return '/activities/' + endpoint + '?courseId=' + encodeURIComponent(COURSE_ID);
    }

    // Carga plantillas habilitadas para este curso. Si el feature flag está apagado
    // en el server, la respuesta es {templates:[]} y el selector queda oculto.
    (async function loadTemplates() {
      try {
        const res = await fetch('/activities/available-templates?courseId=' + encodeURIComponent(COURSE_ID), {
          headers: { 'Accept': 'application/json' },
        });
        const data = await res.json();
        if (!res.ok) return;
        const templates = data.templates || [];
        if (templates.length === 0) return; // sin plantillas → sidebar sigue como siempre
        const card = document.getElementById('templateCard');
        const sel  = document.getElementById('sTemplateId');
        templates.forEach(t => {
          const opt = document.createElement('option');
          opt.value = t._id;
          opt.textContent = t.title + ' (' + t.questionsCount + ' pregunta' + (t.questionsCount === 1 ? '' : 's') + ')';
          opt.dataset.points = t.defaultPoints;
          sel.appendChild(opt);
        });
        card.style.display = '';
        // Al elegir plantilla, auto-completar los puntos y ocultar los adjuntos
        // (una actividad interactiva no lleva archivos del docente, es cerrada).
        sel.addEventListener('change', () => {
          const chosen = sel.options[sel.selectedIndex];
          const pts = chosen && chosen.dataset.points;
          if (sel.value && pts) document.getElementById('sPoints').value = pts;
          const uploadCard = document.querySelector('.creator-attachments');
          if (uploadCard) uploadCard.style.display = sel.value ? 'none' : '';
        });
      } catch {
        // Sin conectividad al endpoint: mostramos el form clásico sin selector.
      }
    })();
    // Los planos llevan color propio para no confundirse con el gris de "formato que no
    // conozco". Copia de la de public/js/course.js — ver el comentario de allá.
    const EXT_COLOR = { PDF: '#ea4335', DOC: '#1a73e8', DOCX: '#1a73e8', XLS: '#34a853', XLSX: '#34a853', DWG: '#8430ce', DXF: '#8430ce' };

    // Precarga "Disponible desde" con ahora y "Fecha de entrega" con una semana después
    (function () {
      const toLocal = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000)
        .toISOString().slice(0, 16);

      const now = new Date();
      now.setSeconds(0, 0);
      document.getElementById('sAvailableFrom').value = toLocal(now);

      const nextWeek = new Date(now);
      nextWeek.setDate(nextWeek.getDate() + 7);
      document.getElementById('sDueDate').value = toLocal(nextWeek);
    })();

    // Avisa en el propio formulario que con una fecha futura la actividad NO se publica al
    // guardar. Sin esto el docente la crea, no la ve el alumno y parece que se perdió.
    // Misma firma que la gemela de public/js/course.js, que hace lo mismo en los modales de
    // crear y editar de la vista de materia.
    function avisoProgramada(inputId, hintId) {
      const input = document.getElementById(inputId);
      const hint  = document.getElementById(hintId);
      if (!input || !hint) return;
      const futura = input.value && new Date(input.value) > new Date();
      hint.textContent = futura
        ? 'Queda deshabilitada y se publica sola en esa fecha. Podés adelantarla con el botón de ojo.'
        : 'Por defecto: ahora mismo';
      hint.style.color = futura ? '#b45309' : '';
    }

    // { uid: { url, name, mime } } — solo archivos ya subidos al servidor
    const actUploadedFiles = {};
    let actLinks = [];
    let pendingUploads = 0;

    /* ─── Rich text ─── */
    function fmt(cmd) {
      document.getElementById('actInstructions').focus();
      document.execCommand(cmd, false, null);
    }

    /* ─── Botón crear: refleja si hay subidas en curso ─── */
    function syncCreateBtn() {
      const btn = document.getElementById('createBtn');
      if (pendingUploads > 0) {
        btn.disabled = true;
        btn.textContent = pendingUploads === 1 ? 'Subiendo archivo...' : `Subiendo ${pendingUploads} archivos...`;
      } else {
        btn.disabled = false;
        btn.textContent = 'Crear tarea';
      }
    }

    /* ─── Modal de error ─── */
    function showUploadErrModal(title, msg) {
      document.getElementById('uplModalTitle').textContent = title;
      document.getElementById('uplModalMsg').textContent   = msg;
      document.getElementById('uploadErrModal').style.display = 'flex';
    }
    function closeUploadErrModal() {
      document.getElementById('uploadErrModal').style.display = 'none';
    }
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeUploadErrModal();
    });

    /* ─── Adjuntos: archivos — sube de inmediato al seleccionar ─── */
    // Espejo de EXT_ALLOWED (routes/activities.js), sin el punto. Si las dos se separan, el
    // navegador deja elegir un archivo que el servidor rechaza (o al revés) y nadie se entera
    // hasta que una docente no puede subir su plano: lo ata tests/unit/subidaDwg.test.js.
    const DOC_EXTS       = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'dwg', 'dxf'];
    // Las de Adjuntos.EXT_IMAGEN vienen con punto ('.jpg'); acá se compara sin él.
    const IMG_EXTS       = Adjuntos.EXT_IMAGEN.map(e => e.slice(1));
    const MAX_SIZE_BYTES = 50 * 1024 * 1024; // 50 MB — PDF, Word, Excel
    // La imagen tiene su propio tope, más bajo, porque el servidor la recibe EN MEMORIA para
    // recomprimirla (ver MAX_INPUT_BYTES en config/imagePresets.js). Igual entra cualquier
    // foto de celular: 20 MB es un HDR de 12 MP con margen.
    const MAX_IMG_BYTES  = 20 * 1024 * 1024;

    ['fileInput', 'imageInput'].forEach(id => {
      document.getElementById(id).addEventListener('change', function () {
        Array.from(this.files).forEach(uploadFile);
        this.value = '';
      });
    });

    function uploadFile(file) {
      const extRaw  = file.name.split('.').pop().toLowerCase();
      const esImagen = Adjuntos.esImagen(file.name);

      // Validación cliente: tipo de archivo
      if (!esImagen && !DOC_EXTS.includes(extRaw)) {
        showUploadErrModal(
          'Tipo de archivo no permitido',
          `"${file.name}" no es un formato aceptado.\nPodés subir archivos PDF, Word (.doc, .docx), Excel (.xls, .xlsx), planos de AutoCAD (.dwg, .dxf) o imágenes (${IMG_EXTS.join(', ')}).`
        );
        return;
      }
      // Validación cliente: tamaño. El tope depende de por qué ruta va a ir.
      const tope = esImagen ? MAX_IMG_BYTES : MAX_SIZE_BYTES;
      if (file.size > tope) {
        const mb = (file.size / 1024 / 1024).toFixed(1);
        showUploadErrModal(
          esImagen ? 'Imagen demasiado grande' : 'Archivo demasiado grande',
          `"${file.name}" pesa ${mb} MB. El máximo permitido es ${Math.round(tope / 1024 / 1024)} MB.`
        );
        return;
      }

      const uid   = Date.now() + '-' + Math.random().toString(36).slice(2);
      const ext   = extRaw.toUpperCase();
      const color = EXT_COLOR[ext] || '#5f6368';
      // Mientras sube todavía no hay miniatura que mostrar —la que se muestra al final es la
      // que devuelve el servidor, ya recomprimida— así que la imagen viaja con su ícono.
      const thumbInicial = esImagen
        ? `<div class="att-preview-thumb att-thumb-img">
             <span class="material-symbols-outlined" style="font-size:34px;color:var(--text-hint)">image</span>
           </div>`
        : `<div class="att-preview-thumb" style="background:${color}">
             <span class="att-preview-ext">${ext}</span>
           </div>`;

      // Agrega la tarjeta con barra de progreso
      const grid = document.getElementById('attPreviews');
      const card = document.createElement('div');
      card.className = 'att-preview-card';
      card.id = 'ucard-' + uid;
      card.innerHTML = `
        ${thumbInicial}
        <div class="att-upload-progress-wrap">
          <div class="att-upload-bar" style="width:0%"></div>
        </div>
        <div class="att-upload-status">0%</div>`;
      grid.appendChild(card);

      // El contador sube UNA vez por archivo, no por intento: si cada reintento lo tocara,
      // el botón se re-habilitaría en medio de la espera y se podría crear la actividad sin
      // el adjunto.
      pendingUploads++;
      syncCreateBtn();

      // Seguimiento para el diagnóstico. Lo importante que aporta es cuántos bytes llegó a
      // empujar el navegador: es lo que distingue "se cortó en camino" (red, proxy, límite
      // de un intermediario — nada de eso deja rastro en el log del servidor) de "subió
      // entero y el servidor lo rechazó". Ver public/js/subida-diagnostico.js.
      const ruta = rutaDeSubida(file.name);
      const seg  = SubidaDiag.seguir(ruta, file);

      const enPantalla = () => document.getElementById('ucard-' + uid);
      const terminar   = () => { pendingUploads--; syncCreateBtn(); };
      const estado     = (t) => {
        const c = enPantalla();
        if (c) c.querySelector('.att-upload-status').textContent = t;
      };

      // Cada intento arma su propio FormData y su propio XHR. El objeto `file` sigue vivo en
      // el closure (ya se usaba en xhr.onload), así que no hace falta volver a leer el input,
      // que además se vació al elegir el archivo.
      function enviarIntento() {
        // Si la tarjeta ya no está —la quitaron, o se navegó— se abandona SOLTANDO el
        // contador. Sin esto el botón queda en "Subiendo archivo..." para siempre.
        if (!enPantalla()) return terminar();

        SubidaDiag.nuevoIntento(seg);

        const fd = new FormData();
        fd.append('file', file);

        const xhr = new XMLHttpRequest();

        xhr.upload.onprogress = (e) => {
          SubidaDiag.progreso(seg, e);
          if (!e.lengthComputable) return;
          const pct = Math.round((e.loaded / e.total) * 100);
          const c = enPantalla();
          if (!c) return;
          c.querySelector('.att-upload-bar').style.width = pct + '%';
          c.querySelector('.att-upload-status').textContent = pct < 100 ? pct + '%' : 'Procesando...';
        };

        xhr.onload = () => {
          const c = enPantalla();
          if (!c) { terminar(); return; }

          let data = null;
          try { data = JSON.parse(xhr.responseText); } catch {}

          if ((xhr.status === 200 || xhr.status === 201) && data?.url) {
            actUploadedFiles[uid] = { url: data.url, name: data.name, mime: data.mime };
            // La miniatura sale del archivo YA guardado, no de un FileReader sobre el
            // original: es la versión recomprimida (unos cientos de KB en vez de 4 MB) y
            // además muestra exactamente lo que va a ver el alumno.
            const thumb = esImagen
              ? `<div class="att-preview-thumb att-thumb-img"><img src="${escHtml(data.url)}" alt=""></div>`
              : `<div class="att-preview-thumb" style="background:${color}">
                   <span class="att-preview-ext">${ext}</span>
                 </div>`;
            // El nombre que se muestra es el que devolvió el servidor: para una imagen ya no
            // es "pizarron.jpg" sino "pizarron.webp", que es el archivo que existe de verdad.
            const nombre = data.name || file.name;
            c.innerHTML = `
              ${thumb}
              <div class="att-preview-name" title="${escHtml(nombre)}">${escHtml(nombre)}</div>
              <button class="att-preview-remove" onclick="removeUploadedFile('${uid}')" title="Quitar">
                <span class="material-symbols-outlined">close</span>
              </button>`;
            terminar();
            return;
          }
          fracaso(xhr, 'http');
        };

        xhr.onerror   = () => fracaso(null, 'red');
        xhr.ontimeout = () => fracaso(null, 'timeout');

        xhr.open('POST', ruta);
        xhr.setRequestHeader('Accept', 'application/json');
        xhr.send(fd);
      }

      // Los tres modos de falla convergen acá, y por eso el final es SIEMPRE el mismo: un
      // solo `fallar()`, un solo código SUB-XXXXXX, un solo cartel.
      function fracaso(xhr, motivo) {
        const cuerpo = xhr ? (xhr.responseText || '') : '';
        const espera = (enPantalla() && SubidaDiag.reintentable({
          motivo, status: xhr ? xhr.status : 0, cuerpo,
        })) ? SubidaDiag.esperaDe(seg.intentos) : null;

        if (espera !== null) {
          const c = enPantalla();
          // La barra vuelve a cero: dejarla en el 8% del intento que acaba de morir es la
          // única forma de que la tarjeta mienta sobre lo que está pasando.
          if (c) {
            c.querySelector('.att-upload-bar').style.width = '0%';
            c.title = 'La subida se cortó. Se reintenta sola hasta 3 veces, durante unos 50 segundos.';
          }
          SubidaDiag.esperar(espera,
            (s) => estado('Reintento en ' + s + ' s'),
            () => { estado('Reintentando ' + (seg.intentos + 1) + ' de 4'); enviarIntento(); });
          return;
        }

        // Se agotó la ventana (o no había nada que reintentar): exactamente lo de antes.
        terminar();
        const c = enPantalla();
        if (c) c.remove();
        // El mensaje del servidor, si vino, lo respeta el diagnóstico y lo muestra igual;
        // lo que agrega es el código para poder encontrar después qué pasó exactamente.
        showUploadErrModal('No se pudo subir el archivo',
          SubidaDiag.mensaje(SubidaDiag.fallar(seg, xhr, motivo)));
      }

      enviarIntento();
    }

    function removeUploadedFile(uid) {
      delete actUploadedFiles[uid];
      const c = document.getElementById('ucard-' + uid);
      if (c) c.remove();
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ─── Adjuntos: enlace ─── */
    function openLinkDialog() {
      document.getElementById('linkDialog').style.display = 'flex';
      document.getElementById('linkUrlInput').focus();
    }
    function closeLinkDialog() {
      document.getElementById('linkDialog').style.display = 'none';
      document.getElementById('linkUrlInput').value = '';
    }
    document.getElementById('linkUrlInput').addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); addLink(); }
      if (e.key === 'Escape') closeLinkDialog();
    });
    function addLink() {
      let url = document.getElementById('linkUrlInput').value.trim();
      if (!url) return;
      if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
      let domain = url;
      try { domain = new URL(url).hostname; } catch {}
      actLinks.push({ name: domain, url });
      closeLinkDialog();
      renderLinks();
    }
    function removeLink(i) { actLinks.splice(i, 1); renderLinks(); }

    function renderLinks() {
      // Solo re-renderiza los chips de links; las tarjetas de archivo las maneja el DOM directamente
      const existing = document.querySelectorAll('.att-link-card');
      existing.forEach(el => el.remove());
      const grid = document.getElementById('attPreviews');
      actLinks.forEach((l, i) => {
        const domain = l.name || l.url;
        const card = document.createElement('div');
        card.className = 'att-preview-card att-link-card';
        card.innerHTML = `
          <div class="att-preview-thumb link-thumb">
            <img src="https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64" width="36" height="36"
              style="border-radius:6px"
              onerror="this.outerHTML='<span class=\\'material-symbols-outlined\\' style=\\'font-size:36px;color:var(--primary)\\'>language</span>'">
          </div>
          <div class="att-preview-name" title="${escHtml(l.url)}">${escHtml(domain)}</div>
          <button class="att-preview-remove" onclick="removeLink(${i})" title="Quitar">
            <span class="material-symbols-outlined">close</span>
          </button>`;
        grid.appendChild(card);
      });
    }

    /* ─── Enviar ─── */
    async function submitActivity() {
      const title = document.getElementById('actTitle').value.trim();
      const errEl = document.getElementById('globalError');

      if (!title) {
        errEl.textContent = 'El título es obligatorio';
        errEl.style.display = 'block';
        document.getElementById('actTitle').focus();
        return;
      }
      if (pendingUploads > 0) {
        errEl.textContent = 'Esperá a que terminen de subirse los archivos';
        errEl.style.display = 'block';
        return;
      }
      errEl.style.display = 'none';

      const btn = document.getElementById('createBtn');
      btn.disabled = true;
      btn.textContent = 'Creando...';

      const fd = new FormData();
      fd.append('courseId', COURSE_ID);
      fd.append('title', title);
      fd.append('description', document.getElementById('actInstructions').innerText.trim());
      fd.append('type', document.getElementById('sType').value || 'tarea');
      fd.append('points', document.getElementById('sPoints').value || '');
      fd.append('dueDate', document.getElementById('sDueDate').value || '');
      fd.append('availableFrom', document.getElementById('sAvailableFrom').value || '');
      fd.append('allowResubmission', document.getElementById('sAllowResubmission').checked ? '1' : '');
      fd.append('uploadedFiles', JSON.stringify(Object.values(actUploadedFiles)));
      fd.append('links', JSON.stringify(actLinks));

      // Si el docente eligió una plantilla, la mandamos: el server copia el
      // snapshot y la actividad se comporta como interactiva. Sin plantilla,
      // el flujo es idéntico al que tenía antes de la Fase 5.
      const tplSel = document.getElementById('sTemplateId');
      if (tplSel && tplSel.value) fd.append('templateId', tplSel.value);

      const res = await fetch('/activities/create', { method: 'POST', body: fd });
      const data = await res.json();

      btn.disabled = false;
      btn.textContent = 'Crear tarea';

      if (!res.ok) {
        errEl.textContent = data.error || 'Error al crear la tarea';
        errEl.style.display = 'block';
        return;
      }

      window.location.href = '/courses/' + COURSE_ID;
    }
  </script>
</body>
</html>
