<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clases · <%= course.name %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div style="max-width:900px;margin:0 auto">
      <a href="/courses/<%= course._id %>/sala" style="font-size:14px;color:#1a73e8;text-decoration:none">← Volver a la sala</a>
      <h2 style="margin:8px 0 4px">Clases de <%= course.name %></h2>
      <p style="margin:0 0 18px;color:#5f6368;font-size:14px">
        <%= course.division?.name || '' %> · <%= total %> alumnos
      </p>

      <% if (!sesiones.length) { %>
        <div class="empty-state">
          <div class="empty-icon"><span class="material-symbols-outlined">sensors_off</span></div>
          <p>Todavía no se abrió ninguna sala en esta materia.</p>
        </div>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:8px">
          <% sesiones.forEach(function (s) { %>
            <a href="/courses/<%= course._id %>/sala/clases/<%= s._id %>"
               style="display:flex;justify-content:space-between;align-items:center;gap:12px;
                      background:#fff;border:1px solid #dadce0;border-radius:8px;padding:12px 16px;
                      text-decoration:none;color:inherit">
              <div>
                <div style="font-weight:500">
                  <%# fmt viene de services/liveRoom.js: fecha y hora en la zona de la escuela,
                      no en la del servidor (producción corre en UTC). %>
                  <%= fmt.fechaDia(s.openedAt) %>
                  <% if (s.title) { %> · <%= s.title %><% } %>
                </div>
                <div style="font-size:13px;color:#5f6368">
                  <%= fmt.hora(s.openedAt) %>
                  <% if (s.closedAt) { %>
                    – <%= fmt.hora(s.closedAt) %>
                    <% if (s.autoClosed) { %> · <span title="Nadie la cerró: se cerró sola por inactividad">cerrada automáticamente</span><% } %>
                  <% } %>
                </div>
              </div>
              <div style="text-align:right;white-space:nowrap">
                <% if (s.enVivo) { %>
                  <span style="font-size:12px;background:#e6f4ea;color:#137333;padding:3px 9px;border-radius:12px">● en vivo</span>
                <% } %>
                <div style="font-size:13px;color:#5f6368"><%= s.presentes %> de <%= total %> presentes</div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
