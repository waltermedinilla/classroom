# Autobump patch después de cada commit.
# Guarda: si el commit recién hecho ya es un bump, no volvemos a bumpear (corta el loop).
# También corta en merges y rebases en progreso para no interferir.
if git log -1 --pretty=%B | grep -q '^chore: bump v'; then
  exit 0
fi
if [ -f .git/MERGE_HEAD ] || [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
  exit 0
fi

npm version patch --no-git-tag-version >/dev/null
NEW_VERSION=$(node -p "require('./package.json').version")
git add package.json package-lock.json 2>/dev/null
git commit -m "chore: bump v${NEW_VERSION}" --no-verify >/dev/null
echo "→ Bump automático: v${NEW_VERSION}"
