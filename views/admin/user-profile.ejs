<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= target.name %> - Admin - Classroom</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%
      /* Esta pantalla la comparten el admin y el superadmin: `requireAdmin` acepta los dos
         roles y desde el 2026-07-31 el listado de /superadmin/users enlaza acá.

         Sin este condicional, el superadmin entraba y salía con las solapas del panel de
         ADMINISTRADOR, y el botón de volver lo dejaba en /admin/users: desde ahí ninguna
         solapa vuelve a /superadmin, así que quedaba encerrado en el panel de admin y
         parecía que había perdido el rol (reportado por el usuario). El rol nunca cambió
         —no hay nada que lo escriba— pero la navegación decía otra cosa. */
      const esSuper  = user.role === 'superadmin';
      const volverA  = esSuper ? '/superadmin/users' : '/admin/users';
    %>
    <% if (esSuper) { %>
      <%- include('../partials/superadmin-nav', { activePage: 'users' }) %>
    <% } else { %>
      <%- include('../partials/admin-nav', { activePage: 'users' }) %>
    <% } %>

    <a href="<%= volverA %>" class="btn btn-outline" style="margin-bottom:24px">
      <span class="material-symbols-outlined">arrow_back</span>
      Volver a usuarios
    </a>

    <div class="profile-header">
      <div class="profile-avatar">
        <div class="avatar-huge" style="width:80px;height:80px;font-size:36px;background:<%= target.role === 'superadmin' ? '#6200ea' : target.role === 'admin' ? '#ea4335' : target.role === 'teacher' ? '#1a73e8' : target.role === 'directivo' ? '#9334e6' : target.role === 'preceptor' ? '#ea8600' : target.role === 'jefe' ? '#3f51b5' : target.role === 'soe' ? '#0d7377' : '#5f6368' %>">
          <%= target.name.charAt(0).toUpperCase() %>
        </div>
      </div>
      <div class="profile-info">
        <h2><%= target.name %></h2>
        <% if (target.dni) { %><p style="font-family:monospace;font-size:13px;color:var(--text-secondary);margin-bottom:2px">DNI: <%= target.dni %></p><% } %>
        <p class="profile-email"><%= target.email %></p>
        <span class="role-badge role-<%= target.role %>" style="font-size:14px;padding:6px 16px"><%= roleNames[target.role] || target.role %></span>
        <p class="profile-date">Registrado el <%= new Date(target.createdAt).toLocaleDateString('es-ES', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></p>
        <% const totalStudents = createdCourses.reduce((sum, c) => sum + c.students.length, 0); %>
        <div style="display:flex;gap:12px;margin-top:10px;flex-wrap:wrap">
          <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 14px;background:var(--surface-variant,#f1f3f4);border-radius:20px;font-size:13px;color:var(--text)">
            <span class="material-symbols-outlined" style="font-size:16px;color:var(--primary)">school</span>
            <strong><%= createdCourses.length %></strong>&nbsp;curso<%= createdCourses.length !== 1 ? 's' : '' %> dictado<%= createdCourses.length !== 1 ? 's' : '' %>
          </div>
          <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 14px;background:var(--surface-variant,#f1f3f4);border-radius:20px;font-size:13px;color:var(--text)">
            <span class="material-symbols-outlined" style="font-size:16px;color:#34a853">people</span>
            <strong><%= totalStudents %></strong>&nbsp;alumno<%= totalStudents !== 1 ? 's' : '' %> en total
          </div>
        </div>
        <%- include('../partials/contact-info', { person: target }) %>
        <%- include('../partials/about-info', { person: target }) %>
      </div>
      <div style="margin-left:auto;display:flex;flex-direction:column;gap:10px;align-items:stretch;min-width:200px">
        <% const isProtected = target.email === PROTECTED_ADMIN_EMAIL || target.role === 'superadmin'; %>
        <% if (target.active === false) { %>
          <span style="display:inline-flex;align-items:center;gap:6px;background:#fce8e6;color:#ea4335;font-size:12px;font-weight:700;padding:5px 14px;border-radius:20px;letter-spacing:.3px">
            <span class="material-symbols-outlined" style="font-size:15px">block</span>
            CUENTA DESHABILITADA
          </span>
        <% } %>
        <% if (!isProtected && target._id.toString() !== user._id.toString()) { %>
          <button class="btn btn-primary" id="impersonateBtn">
            <span class="material-symbols-outlined">swap_horiz</span>
            Ver como este usuario
          </button>
          <button class="btn btn-outline" id="toggleActiveBtn" style="font-size:13px;padding:8px 18px;border-color:<%= target.active === false ? '#34a853' : '#ea4335' %>;color:<%= target.active === false ? '#34a853' : '#ea4335' %>">
            <span class="material-symbols-outlined"><%= target.active === false ? 'check_circle' : 'block' %></span>
            <%= target.active === false ? 'Habilitar cuenta' : 'Deshabilitar cuenta' %>
          </button>
          <button class="btn btn-outline" id="resetPasswordBtn" style="font-size:13px;padding:8px 18px">
            <span class="material-symbols-outlined">lock_reset</span>
            Restablecer contraseña
          </button>
          <button class="btn btn-danger" id="deleteBtn" style="font-size:13px;padding:8px 18px">
            <span class="material-symbols-outlined">delete</span>
            Eliminar usuario
          </button>
        <% } %>
        <% if (isProtected) { %>
          <span style="font-size:12px;color:var(--text-hint);display:flex;align-items:center;gap:4px">
            <span class="material-symbols-outlined" style="font-size:16px">lock</span>
            Administrador protegido
          </span>
        <% } %>
      </div>
    </div>

    <% if (!isProtected) { %>
    <div class="profile-actions">
      <div class="profile-action-card">
        <h4>Cambiar rol</h4>
        <form id="roleForm" style="display:flex;gap:12px;align-items:center;margin-top:12px">
          <div class="input-group" style="flex:1">
            <span class="material-symbols-outlined input-icon">badge</span>
            <select id="newRole" class="select-input">
              <option value="admin" <%= target.role === 'admin' ? 'selected' : '' %>>Administrador</option>
              <option value="directivo" <%= target.role === 'directivo' ? 'selected' : '' %>>Directivo</option>
              <option value="teacher" <%= target.role === 'teacher' ? 'selected' : '' %>>Docente</option>
              <option value="preceptor" <%= target.role === 'preceptor' ? 'selected' : '' %>>Preceptor</option>
              <option value="jefe" <%= target.role === 'jefe' ? 'selected' : '' %>>Jefe de Sección</option>
              <option value="soe" <%= target.role === 'soe' ? 'selected' : '' %>>SOE</option>
              <option value="student" <%= target.role === 'student' ? 'selected' : '' %>>Alumno</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
        <div class="form-error" id="roleError" style="margin-top:8px"></div>
      </div>
    </div>
    <% } %>

    <%# Alcance del preceptor. Va acá y no en el alta porque el rol se puede asignar por
        varios caminos que no preguntan por cursos (cambio individual, cambio en lote del
        superadmin): este bloque es el único lugar donde el admin se entera de que el
        preceptor quedó sin nada asignado. El aviso ámbar es deliberado — un preceptor sin
        cursos no ve absolutamente nada y eso parece un error de la aplicación. %>
    <% if (target.role === 'preceptor') { %>
    <div class="profile-actions">
      <div class="profile-action-card">
        <h4>Cursos a cargo</h4>
        <% const _sinAlcance = !target.allDivisions && assignedDivisionIds.length === 0; %>
        <% if (_sinAlcance) { %>
          <div style="background:#fef4e5;color:#e67e00;padding:10px 14px;border-radius:8px;font-size:13px;margin-top:12px;display:flex;gap:8px;align-items:flex-start">
            <span class="material-symbols-outlined" style="font-size:18px">warning</span>
            <span>Este preceptor todavía no tiene cursos asignados: al entrar no ve ningún curso ni alumno.</span>
          </div>
        <% } %>

        <% if (!schoolDivisions.length) { %>
          <p style="font-size:13px;color:var(--text-hint);margin-top:12px">
            <%= target.school ? 'La escuela no tiene cursos cargados todavía.' : 'El usuario no está asignado a ninguna escuela.' %>
          </p>
        <% } else { %>
          <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:14px 0 12px;cursor:pointer">
            <input type="checkbox" id="allDivisions" <%= target.allDivisions ? 'checked' : '' %> onchange="toggleScopeList()">
            <strong>Todos los cursos de la escuela</strong>
          </label>
          <div id="scopeList" style="max-height:260px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:10px">
            <% schoolDivisions.forEach(d => { %>
              <label style="display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 0;cursor:pointer">
                <input type="checkbox" class="scope-division" value="<%= d._id %>"
                  <%= assignedDivisionIds.includes(d._id.toString()) ? 'checked' : '' %>>
                <%= d.name %>
              </label>
            <% }) %>
          </div>
          <div class="form-error" id="scopeError" style="margin-top:8px"></div>
          <div id="scopeOk" style="display:none;background:#e6f4ea;color:#137333;padding:8px 12px;border-radius:8px;font-size:13px;margin-top:8px"></div>
          <button type="button" class="btn btn-primary" id="scopeSaveBtn" style="margin-top:14px">
            <span class="material-symbols-outlined">save</span>
            Guardar cursos
          </button>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# Materias del docente. Espejo del bloque de arriba: al preceptor se le asignan sus
        cursos desde acá y al docente no se le podía asignar nada — había que entrar materia
        por materia. Se lo agrega como SUPLENTE (ver POST /admin/users/:id/courses); las
        materias donde ya es TITULAR vienen tildadas y bloqueadas, porque destildarlas
        dejaría la materia sin docente. %>
    <% if (target.role === 'teacher') { %>
    <div class="profile-actions">
      <div class="profile-action-card">
        <h4>Materias que dicta</h4>
        <%
          const _titularIds  = schoolCourses.filter(c => String(c.owner) === String(target._id)).map(c => String(c._id));
          const _suplenteIds = schoolCourses.filter(c => (c.coTeachers || []).some(t => String(t) === String(target._id))).map(c => String(c._id));
          const _asignadas   = _titularIds.length + _suplenteIds.length;
          /* Agrupadas por división: con ~450 materias, una lista plana es ilegible. */
          const _porDivision = {};
          schoolCourses.forEach(c => {
            const k = c.division?.name || 'Sin curso asignado';
            (_porDivision[k] = _porDivision[k] || []).push(c);
          });
          const _divisiones = Object.keys(_porDivision).sort((a, b) => a.localeCompare(b, 'es'));
        %>
        <% if (_asignadas === 0) { %>
          <div style="background:#fef4e5;color:#e67e00;padding:10px 14px;border-radius:8px;font-size:13px;margin-top:12px;display:flex;gap:8px;align-items:flex-start">
            <span class="material-symbols-outlined" style="font-size:18px">warning</span>
            <span>Este docente todavía no tiene materias asignadas: al entrar no ve ninguna materia ni alumno.</span>
          </div>
        <% } %>

        <% if (!schoolCourses.length) { %>
          <p style="font-size:13px;color:var(--text-hint);margin-top:12px">
            <%= target.school ? 'La escuela no tiene materias cargadas todavía.' : 'El usuario no está asignado a ninguna escuela.' %>
          </p>
        <% } else { %>
          <p style="font-size:13px;color:var(--text-secondary);margin:12px 0 10px">
            Tildá las materias que dicta. Queda como <strong>suplente</strong>, con los mismos permisos que el titular.
            Las que ya dicta como titular aparecen bloqueadas — para cambiar un titular, entrá a la materia.
          </p>
          <div class="input-group" style="margin-bottom:10px">
            <span class="material-symbols-outlined input-icon">search</span>
            <input type="text" id="courseSearch" placeholder="Buscar materia o curso..." autocomplete="off">
          </div>
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:10px;font-size:13px;flex-wrap:wrap">
            <span id="courseCount" style="color:var(--text-secondary)"></span>
            <button type="button" class="btn btn-outline" id="courseClearBtn" style="padding:3px 10px;font-size:12px">Destildar todas</button>
          </div>
          <div id="courseList" style="max-height:320px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:10px">
            <% _divisiones.forEach(divName => { %>
              <div class="course-scope-group" data-division="<%= divName.toLowerCase() %>">
                <div style="font-size:12px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.4px;margin:10px 0 4px"><%= divName %></div>
                <% _porDivision[divName].forEach(c => { %>
                  <% const esTitular = _titularIds.includes(String(c._id)); %>
                  <label class="course-scope-item" data-name="<%= (c.name + ' ' + divName).toLowerCase() %>"
                         style="display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 0;cursor:<%= esTitular ? 'default' : 'pointer' %>">
                    <input type="checkbox" class="scope-course" value="<%= c._id %>"
                      <%= esTitular || _suplenteIds.includes(String(c._id)) ? 'checked' : '' %>
                      <%= esTitular ? 'disabled data-titular="1"' : '' %>>
                    <span style="<%= esTitular ? 'color:var(--text-secondary)' : '' %>"><%= c.name %></span>
                    <% if (esTitular) { %>
                      <span style="background:#e8f0fe;color:#1a73e8;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;letter-spacing:.3px">TITULAR</span>
                    <% } %>
                  </label>
                <% }) %>
              </div>
            <% }) %>
          </div>
          <div class="form-error" id="courseScopeError" style="margin-top:8px"></div>
          <div id="courseScopeOk" style="display:none;background:#e6f4ea;color:#137333;padding:8px 12px;border-radius:8px;font-size:13px;margin-top:8px"></div>
          <button type="button" class="btn btn-primary" id="courseScopeSaveBtn" style="margin-top:14px">
            <span class="material-symbols-outlined">save</span>
            Guardar materias
          </button>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="section" style="margin-top:32px">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">star</span>
        <h3>Cursos creados (<%= createdCourses.length %>)</h3>
      </div>
      <% if (createdCourses.length === 0) { %>
        <div class="empty-state small"><p>No creó cursos</p></div>
      <% } else { %>
        <div class="course-grid">
          <% createdCourses.forEach(c => { %>
            <a href="/courses/<%= c._id %>" class="course-card" style="--card-color:#1a73e8">
              <div class="card-banner" style="min-height:80px">
                <div class="card-banner-content">
                  <h4 style="font-size:20px"><%= c.name %></h4>
                  <% if (!c.school) { %>
                    <p style="font-size:12px;margin-top:4px;opacity:.85">(Sin Matricular)</p>
                  <% } %>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%# Materias donde es suplente. Antes no se mostraban en ningún lado: el perfil de un
        docente que solo era suplente se veía igual al de uno sin ninguna materia. %>
    <% if (coTaughtCourses.length) { %>
    <div class="section">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">group_add</span>
        <h3>Materias como suplente (<%= coTaughtCourses.length %>)</h3>
      </div>
      <div class="course-grid">
        <% coTaughtCourses.forEach(c => { %>
          <a href="/courses/<%= c._id %>" class="course-card" style="--card-color:#9334e6">
            <div class="card-banner" style="min-height:80px">
              <div class="card-banner-content">
                <h4 style="font-size:20px"><%= c.name %></h4>
                <% if (c.division) { %>
                  <p style="font-size:12px;margin-top:4px;opacity:.85"><%= c.division.name %></p>
                <% } %>
              </div>
            </div>
            <div class="card-footer"><span>Titular: <%= c.owner?.name || 'Sin docente' %></span></div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="section">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">group</span>
        <h3>Cursos unidos (<%= joinedCourses.length %>)
          <% if (target.role === 'student' && joinedCourses.length === 0) { %>
            <span class="badge-unmatriculated" style="margin-left:8px">(Sin Matricular)</span>
          <% } %>
        </h3>
      </div>
      <% if (joinedCourses.length === 0) { %>
        <div class="empty-state small">
          <% if (target.role === 'student') { %>
            <p>Este alumno no está matriculado en ningún curso.</p>
          <% } else { %>
            <p>No se unió a cursos</p>
          <% } %>
        </div>
      <% } else { %>
        <div class="course-grid">
          <% joinedCourses.forEach(c => { %>
            <a href="/courses/<%= c._id %>" class="course-card" style="--card-color:#34a853">
              <div class="card-banner" style="min-height:80px">
                <div class="card-banner-content">
                  <h4 style="font-size:20px"><%= c.name %></h4>
                  <% if (!c.school) { %>
                    <p style="font-size:12px;margin-top:4px;opacity:.85">(Sin Matricular)</p>
                  <% } %>
                </div>
              </div>
              <div class="card-footer"><span><%= c.owner?.name || 'Sin docente' %></span></div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script>
    <% if (!isProtected) { %>
    document.getElementById('roleForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl = document.getElementById('roleError');
      errorEl.classList.remove('show');
      const res = await fetch('/admin/users/<%= target._id %>/role', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role: document.getElementById('newRole').value }),
      });
      const data = await res.json();
      if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.add('show'); return; }
      location.reload();
    });

    // ── Alcance del preceptor ────────────────────────────────────────────────
    // Los elementos solo existen si el usuario es preceptor Y la escuela tiene divisiones
    // cargadas, así que todo va detrás de una guarda de existencia.
    function toggleScopeList() {
      const todos = document.getElementById('allDivisions').checked;
      const list  = document.getElementById('scopeList');
      list.style.opacity       = todos ? '.45' : '1';
      list.style.pointerEvents = todos ? 'none' : '';
    }

    if (document.getElementById('scopeSaveBtn')) {
      toggleScopeList(); // sincronizar el estado visual al cargar

      document.getElementById('scopeSaveBtn').addEventListener('click', async () => {
        const errorEl = document.getElementById('scopeError');
        const okEl    = document.getElementById('scopeOk');
        const btn     = document.getElementById('scopeSaveBtn');
        errorEl.classList.remove('show');
        okEl.style.display = 'none';
        btn.disabled = true;

        const todos = document.getElementById('allDivisions').checked;
        const res = await fetch('/admin/users/<%= target._id %>/divisions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            allDivisions: todos,
            divisionIds: [...document.querySelectorAll('.scope-division:checked')].map(c => c.value),
          }),
        });
        const data = await res.json();
        btn.disabled = false;

        if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.add('show'); return; }
        okEl.textContent = data.allDivisions
          ? 'Ahora ve todos los cursos de la escuela.'
          : 'Cursos guardados: ' + data.count + '.';
        okEl.style.display = 'block';
        // Recarga para que el aviso de "sin cursos asignados" se actualice.
        setTimeout(() => location.reload(), 1000);
      });
    }

    // ── Materias del docente ─────────────────────────────────────────────────
    // Mismo patrón que el alcance del preceptor de arriba: los elementos solo existen si
    // el usuario es docente Y la escuela tiene materias, así que va todo detrás de la guarda.
    if (document.getElementById('courseScopeSaveBtn')) {
      const searchEl = document.getElementById('courseSearch');
      const countEl  = document.getElementById('courseCount');
      const cajas    = () => [...document.querySelectorAll('.scope-course')];

      function refrescarConteo() {
        const tildadas = cajas().filter(c => c.checked).length;
        const titular  = cajas().filter(c => c.dataset.titular).length;
        countEl.textContent = titular
          ? `${tildadas} materia(s) — ${titular} como titular`
          : `${tildadas} materia(s) seleccionada(s)`;
      }

      // Filtro por nombre de materia o de curso. Se ocultan también los encabezados de
      // división que quedan sin ninguna materia visible, si no queda el título suelto.
      searchEl.addEventListener('input', () => {
        const q = searchEl.value.trim().toLowerCase();
        document.querySelectorAll('.course-scope-group').forEach(grupo => {
          let visibles = 0;
          grupo.querySelectorAll('.course-scope-item').forEach(item => {
            const coincide = !q || item.dataset.name.includes(q);
            item.style.display = coincide ? '' : 'none';
            if (coincide) visibles++;
          });
          grupo.style.display = visibles ? '' : 'none';
        });
      });

      document.getElementById('courseList').addEventListener('change', refrescarConteo);

      // Solo destilda las suplencias: las de titular están disabled y no se tocan.
      document.getElementById('courseClearBtn').addEventListener('click', () => {
        cajas().forEach(c => { if (!c.disabled) c.checked = false; });
        refrescarConteo();
      });

      refrescarConteo();

      document.getElementById('courseScopeSaveBtn').addEventListener('click', async () => {
        const errorEl = document.getElementById('courseScopeError');
        const okEl    = document.getElementById('courseScopeOk');
        const btn     = document.getElementById('courseScopeSaveBtn');
        errorEl.classList.remove('show');
        okEl.style.display = 'none';
        btn.disabled = true;

        // Se manda la lista completa de deseadas, incluidas las de titular: la ruta las
        // ignora, pero mandarlas evita que un cambio de criterio allá las interprete como
        // "destildadas". Las disabled no entran en :checked del querySelectorAll, así que
        // se agregan aparte.
        const courseIds = [
          ...cajas().filter(c => c.checked && !c.disabled).map(c => c.value),
          ...cajas().filter(c => c.dataset.titular).map(c => c.value),
        ];

        const res = await fetch('/admin/users/<%= target._id %>/courses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseIds }),
        });
        const data = await res.json();
        btn.disabled = false;

        if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.add('show'); return; }
        const partes = [];
        if (data.agregadas) partes.push(`${data.agregadas} agregada(s)`);
        if (data.quitadas)  partes.push(`${data.quitadas} quitada(s)`);
        okEl.textContent = partes.length
          ? `Materias guardadas: ${partes.join(', ')}. Ahora dicta ${data.titular + data.suplente} en total.`
          : 'No hubo cambios que guardar.';
        okEl.style.display = 'block';
        // Recarga para refrescar el aviso ámbar y la grilla de materias de más abajo.
        setTimeout(() => location.reload(), 1200);
      });
    }

    document.getElementById('impersonateBtn').addEventListener('click', async () => {
      if (!confirm('¿Ver la plataforma como <%= target.name %>? Podrás volver desde la barra superior.')) return;
      const res = await fetch('/admin/users/<%= target._id %>/impersonate', { method: 'POST' });
      if (res.ok) window.location.href = '/courses';
      else { const d = await res.json(); alert(d.error); }
    });

    document.getElementById('toggleActiveBtn').addEventListener('click', async () => {
      const isActive = <%= target.active !== false %>;
      const accion = isActive ? 'deshabilitar' : 'habilitar';
      if (!confirm(`¿Querés ${accion} la cuenta de <%= target.name %>?`)) return;
      const res = await fetch('/admin/users/<%= target._id %>/toggle-active', { method: 'POST' });
      const data = await res.json();
      if (res.ok) location.reload();
      else alert(data.error);
    });

    document.getElementById('resetPasswordBtn').addEventListener('click', async () => {
      const hint = '<%= target.dni ? `el DNI (${target.dni})` : "Classroom1234" %>';
      if (!confirm(`¿Restablecer la contraseña de <%= target.name %>?\nLa nueva contraseña será ${hint}.`)) return;
      const res = await fetch('/admin/users/<%= target._id %>/reset-password', { method: 'POST' });
      const data = await res.json();
      if (res.ok) alert(`Contraseña restablecida. La nueva contraseña es: ${data.hint}`);
      else alert(data.error);
    });

    document.getElementById('deleteBtn').addEventListener('click', async () => {
      if (!confirm('¿Eliminar a <%= target.name %>? Esta acción no se puede deshacer.')) return;
      const res = await fetch('/admin/users/<%= target._id %>/delete', { method: 'POST' });
      if (res.ok) window.location.href = '/admin/users';
      else { const d = await res.json(); alert(d.error); }
    });
    <% } %>
  </script>
</body>
</html>
