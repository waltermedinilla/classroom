<%# Dos filas: hasta Monitor arriba, el resto abajo. Es el único nav con 11 solapas y en
    una sola fila obligaba a scrollear horizontalmente incluso en escritorio. El corte es
    fijo (no depende del ancho) para que las solapas no se muevan de fila entre pantallas:
    lo marca .admin-nav-break, ver "Admin Nav" en style.css. %>
<nav class="admin-nav admin-nav-2filas">
  <a href="/superadmin" class="admin-nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
    <span class="material-symbols-outlined">dashboard</span>
    Resumen
  </a>
  <a href="/superadmin/schools" class="admin-nav-item <%= activePage === 'schools' ? 'active' : '' %>">
    <span class="material-symbols-outlined">domain</span>
    Escuelas
  </a>
  <a href="/superadmin/users" class="admin-nav-item <%= activePage === 'users' ? 'active' : '' %>">
    <span class="material-symbols-outlined">people</span>
    Usuarios
  </a>
  <a href="/superadmin/import" class="admin-nav-item <%= activePage === 'import' ? 'active' : '' %>">
    <span class="material-symbols-outlined">upload_file</span>
    Importar
  </a>
  <a href="/superadmin/suggestions" class="admin-nav-item <%= activePage === 'suggestions' ? 'active' : '' %>">
    <span class="material-symbols-outlined">lightbulb</span>
    Sugerencias
  </a>
  <a href="/superadmin/messages" class="admin-nav-item <%= activePage === 'messages' ? 'active' : '' %>">
    <span class="material-symbols-outlined">forum</span>
    Mensajes
  </a>
  <a href="/superadmin/themes" class="admin-nav-item <%= activePage === 'themes' ? 'active' : '' %>">
    <span class="material-symbols-outlined">palette</span>
    Temas
  </a>
  <a href="/superadmin/roles" class="admin-nav-item <%= activePage === 'roles' ? 'active' : '' %>">
    <span class="material-symbols-outlined">admin_panel_settings</span>
    Roles
  </a>
  <%# El corte se volvió a mover un ítem antes al sumar "Mensajes": con 13 solapas, dejarlo
      donde estaba daba 9 arriba y 4 abajo. Ahora quedan 8 y 5. Cuando "Tareas" está apagada
      por su feature flag quedan 8 y 4, que sigue entrando bien. %>
  <span class="admin-nav-break" aria-hidden="true"></span>
  <% if (typeof taskTemplatesEnabled === 'undefined' || taskTemplatesEnabled) { %>
  <a href="/superadmin/tasks" class="admin-nav-item <%= activePage === 'tasks' ? 'active' : '' %>">
    <span class="material-symbols-outlined">assignment</span>
    Tareas
  </a>
  <% } %>
  <a href="/superadmin/monitor" class="admin-nav-item <%= activePage === 'monitor' ? 'active' : '' %>">
    <span class="material-symbols-outlined">monitor_heart</span>
    Monitor
  </a>
  <a href="/superadmin/audit" class="admin-nav-item <%= activePage === 'audit' ? 'active' : '' %>">
    <span class="material-symbols-outlined">history</span>
    Auditoría
  </a>
  <% if (typeof user !== 'undefined' && user?.email === 'waltermedinilla@gmail.com') { %>
  <a href="/superadmin/backup" class="admin-nav-item <%= activePage === 'backup' ? 'active' : '' %>">
    <span class="material-symbols-outlined">backup</span>
    Backup
  </a>
  <%# "Otros" queda bajo la misma restricción que Backup: sus arreglos escriben en masa
      sobre la base y no se deshacen (ver routes/dbFixes.js). %>
  <a href="/superadmin/otros" class="admin-nav-item <%= activePage === 'otros' ? 'active' : '' %>">
    <span class="material-symbols-outlined">healing</span>
    Otros
  </a>
  <% } %>
</nav>
