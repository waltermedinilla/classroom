<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= division.name %> — Panel Directivo</title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .back-link {
      display: inline-flex; align-items: center; gap: 4px; font-size: 13px;
      color: var(--text-secondary); text-decoration: none; margin-bottom: 10px;
    }
    .back-link:hover { color: var(--primary); }
    .mini-stats { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0 24px; }
    .mini-stat {
      flex: 1; min-width: 120px; background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 14px 16px;
    }
    .mini-stat-value { font-size: 24px; font-weight: 700; color: var(--text-primary); line-height: 1; }
    .mini-stat-label { font-size: 11px; color: var(--text-secondary); margin-top: 5px; text-transform: uppercase; letter-spacing: .3px; }
    .section-h {
      display: flex; align-items: center; gap: 7px; font-size: 15px; font-weight: 600;
      margin: 24px 0 10px;
    }
    .simple-table {
      width: 100%; border-collapse: collapse; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    }
    .simple-table th, .simple-table td {
      padding: 10px 14px; text-align: left; font-size: 13px;
      border-bottom: 1px solid var(--border);
    }
    .simple-table th {
      background: var(--bg); font-weight: 600; font-size: 11px;
      text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary);
    }
    .simple-table tr:last-child td { border-bottom: none; }
    .simple-table tr:hover td { background: var(--bg); }
    a.name-link { color: var(--text-primary); text-decoration: none; font-weight: 500; }
    a.name-link:hover { color: var(--primary); text-decoration: underline; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; }
    .badge-red  { background: #fce8e6; color: #c5221f; }
    .badge-warn { background: #fef4e5; color: #e67e00; }
    .badge-ok   { background: #e6f4ea; color: #137333; }
    .rate-bar {
      display: inline-block; width: 60px; height: 6px; background: var(--border);
      border-radius: 3px; overflow: hidden; vertical-align: middle; margin-right: 6px;
    }
    .rate-bar-fill { display: block; height: 100%; border-radius: 3px; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <%- include('../partials/directivo-nav', { activePage: 'divisions' }) %>

    <a href="/directivo/divisions" class="back-link">
      <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>
      Volver a divisiones
    </a>

    <div class="dashboard-topbar">
      <div>
        <h2><%= division.name %></h2>
        <p style="color:var(--text-secondary);font-size:14px;margin-top:4px">
          Materias y alumnos de esta división
        </p>
      </div>
    </div>

    <div class="mini-stats">
      <div class="mini-stat">
        <div class="mini-stat-value"><%= stats.materias %></div>
        <div class="mini-stat-label">Materias</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-value"><%= stats.alumnos %></div>
        <div class="mini-stat-label">Alumnos</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-value"><%= stats.docentes %></div>
        <div class="mini-stat-label">Docentes</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-value"><%= stats.actividades %></div>
        <div class="mini-stat-label">Actividades</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-value" style="color:<%= stats.tasa === null ? 'var(--text-hint)' : stats.tasa >= 80 ? '#34a853' : stats.tasa >= 50 ? '#ea8600' : '#ea4335' %>">
          <%= stats.tasa === null ? '—' : stats.tasa + '%' %>
        </div>
        <div class="mini-stat-label">Tasa de entrega</div>
      </div>
    </div>

    <div class="section-h">
      <span class="material-symbols-outlined" style="color:#1a73e8">menu_book</span>
      Materias de la división
    </div>
    <% if (!courses.length) { %>
      <div style="padding:20px;text-align:center;color:var(--text-secondary);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)">
        Esta división no tiene materias todavía.
      </div>
    <% } else { %>
      <div style="overflow-x:auto">
        <table class="simple-table">
          <thead>
            <tr>
              <th>Materia</th>
              <th>Docente</th>
              <th style="text-align:center">Alumnos</th>
              <th style="text-align:center">Actividades</th>
              <th>Tasa de entrega</th>
              <th style="text-align:center">Sin calificar</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(c => { %>
              <tr>
                <td><a href="/directivo/courses/<%= c._id %>" class="name-link"><%= c.name %></a></td>
                <td>
                  <%= c.teacher %>
                  <% if (!c.teacherActive) { %><span class="badge badge-red" style="margin-left:4px">Deshabilitado</span><% } %>
                </td>
                <td style="text-align:center"><%= c.students %></td>
                <td style="text-align:center"><%= c.activities %></td>
                <td>
                  <% if (c.tasa === null) { %>
                    <span style="color:var(--text-hint)">—</span>
                  <% } else { %>
                    <span class="rate-bar">
                      <span class="rate-bar-fill" style="width:<%= Math.min(100, c.tasa) %>%;background:<%= c.tasa >= 80 ? '#34a853' : c.tasa >= 50 ? '#ea8600' : '#ea4335' %>"></span>
                    </span>
                    <strong style="color:<%= c.tasa >= 80 ? '#34a853' : c.tasa >= 50 ? '#ea8600' : '#ea4335' %>"><%= c.tasa %>%</strong>
                  <% } %>
                </td>
                <td style="text-align:center">
                  <% if (c.vencidasSinCalificar > 0) { %>
                    <span class="badge badge-warn"><%= c.vencidasSinCalificar %></span>
                  <% } else { %>
                    <span class="badge badge-ok">0</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="section-h">
      <span class="material-symbols-outlined" style="color:#1a73e8">group</span>
      Alumnos de la división
    </div>
    <% if (!students.length) { %>
      <div style="padding:20px;text-align:center;color:var(--text-secondary);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)">
        No hay alumnos inscriptos en las materias de esta división.
      </div>
    <% } else { %>
      <div style="overflow-x:auto">
        <table class="simple-table">
          <thead>
            <tr>
              <th>Alumno</th>
              <th>DNI</th>
              <th style="text-align:center">Entregas</th>
              <th style="text-align:center">Promedio</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(s => { %>
              <tr>
                <td>
                  <a href="/directivo/students/<%= s._id %>" class="name-link"><%= s.name %></a>
                  <div style="font-size:11px;color:var(--text-hint)"><%= s.email %></div>
                </td>
                <td><%= s.dni || '—' %></td>
                <td style="text-align:center"><%= s.entregas %></td>
                <td style="text-align:center">
                  <% if (s.promedio === null) { %>
                    <span style="color:var(--text-hint)">—</span>
                  <% } else { %>
                    <strong style="color:<%= s.promedio < 6 ? '#ea4335' : s.promedio < 8 ? '#ea8600' : '#34a853' %>"><%= s.promedio %></strong>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
