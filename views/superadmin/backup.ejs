<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backup y Restauración — Superadmin</title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .backup-warning {
      background: #fff3e0; border: 1px solid #ea8600; border-radius: var(--radius);
      padding: 14px 18px; font-size: 13px; color: #7a4a00; margin-bottom: 20px;
      display: flex; gap: 10px; align-items: flex-start;
    }
    .backup-section {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 24px; margin-bottom: 24px;
    }
    .backup-section h3 {
      margin: 0 0 14px; font-size: 16px; display: flex; align-items: center; gap: 8px;
    }
    .stats-mini-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px; margin-bottom: 16px;
    }
    .stats-mini-card {
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      padding: 12px 14px;
    }
    .stats-mini-value { font-size: 20px; font-weight: 700; line-height: 1; }
    .stats-mini-label { font-size: 11px; color: var(--text-secondary); margin-top: 2px; text-transform: uppercase; letter-spacing: .3px; }
    .last-backup-note {
      font-size: 12px; color: var(--text-secondary); margin-bottom: 14px;
    }
    .drop-zone {
      border: 2px dashed var(--border); border-radius: var(--radius); padding: 30px;
      text-align: center; color: var(--text-secondary); cursor: pointer;
      transition: border-color .15s ease, background .15s ease;
    }
    .drop-zone:hover, .drop-zone.dragover { border-color: var(--primary); background: var(--bg); }
    .diff-table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 13px; }
    .diff-table th, .diff-table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }
    .diff-table th { font-size: 11px; text-transform: uppercase; color: var(--text-secondary); }
    .diff-up   { color: #137333; font-weight: 600; }
    .diff-down { color: #c5221f; font-weight: 600; }
    .diff-same { color: var(--text-hint); }
    .diff-table tr.diff-missing td { background: #fef7e0; }
    .diff-missing-tag { font-size: 11px; color: #b06000; font-weight: 600; }
    .warn-box {
      background: #fef7e0; border: 1px solid #f9ab00; border-radius: var(--radius);
      padding: 14px 16px; margin-top: 14px; font-size: 13px;
    }
    .warn-box ul { margin: 8px 0 0; padding-left: 20px; }
    .warn-box li { margin-bottom: 2px; }
    .confirm-box {
      background: #fce8e6; border: 1px solid #ea4335; border-radius: var(--radius);
      padding: 18px; margin-top: 16px;
    }
    .confirm-checks label { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; margin-bottom: 8px; cursor: pointer; }
    .confirm-checks input[type="checkbox"] { margin-top: 2px; }
    .confirm-input {
      width: 100%; max-width: 260px; padding: 8px 12px; border: 1px solid var(--border);
      border-radius: 8px; font-size: 14px; margin: 10px 0; box-sizing: border-box;
      background: var(--surface); color: var(--text-primary);
    }
    .restore-log { font-size: 12px; font-family: monospace; color: var(--text-secondary); margin-top: 10px; }
    .restore-log div { padding: 2px 0; }
    .backup-result-ok  { background: #e6f4ea; border: 1px solid #34a853; border-radius: var(--radius); padding: 16px; margin-top: 16px; }
    .backup-result-err { background: #fce8e6; border: 1px solid #ea4335; border-radius: var(--radius); padding: 16px; margin-top: 16px; }
    .spinner-inline {
      display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(0,0,0,.15);
      border-top-color: var(--primary); border-radius: 50%; animation: spin .7s linear infinite;
      vertical-align: -2px; margin-right: 6px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ─── Envío por FTP ─── */
    .ftp-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px; margin-bottom: 14px;
    }
    .ftp-campo { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ftp-campo > span { font-size: 12px; color: var(--text-secondary); }
    .ftp-campo input, .ftp-campo select {
      padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px;
      background: var(--surface); color: var(--text-primary); box-sizing: border-box; width: 100%;
    }
    .ftp-hint { font-size: 11.5px; color: var(--text-hint); }
    .ftp-pasos { margin-top: 14px; font-size: 13px; }
    .ftp-pasos summary { cursor: pointer; color: var(--text-secondary); font-size: 12.5px; }
    .ftp-pasos ol { margin: 10px 0 0; padding-left: 22px; line-height: 1.65; }
    .ftp-pasos li { margin-bottom: 6px; }
    .ftp-pasos code {
      background: var(--bg); padding: 1px 5px; border-radius: 4px; font-size: 12px;
    }
    .ftp-barra {
      height: 8px; background: var(--bg); border-radius: 99px; overflow: hidden;
      border: 1px solid var(--border); margin: 8px 0 6px;
    }
    .ftp-barra > div {
      height: 100%; width: 0; background: var(--primary); transition: width .4s linear;
    }
    .ftp-cifras {
      display: flex; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--text-secondary);
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="main-content main-content-ancho">
    <%- include('../partials/superadmin-nav', { activePage: 'backup' }) %>

    <div class="section-header" style="margin-bottom:16px">
      <span class="material-symbols-outlined section-icon" style="color:#1a73e8">backup</span>
      <h2 style="margin:0">Backup y Restauración</h2>
    </div>

    <div class="backup-warning">
      <span class="material-symbols-outlined" style="color:#ea8600">shield</span>
      <div>Solo <strong>waltermedinilla@gmail.com</strong> puede generar o restaurar backups. El archivo generado contiene datos sensibles (contraseñas hasheadas, DNIs, emails) — guardalo en un lugar privado, nunca lo compartas.</div>
    </div>

    <!-- ─── Modo mantenimiento ─── -->
    <div class="backup-section" id="maintenanceSection">
      <h3><span class="material-symbols-outlined" style="color:#ea8600">build</span>Modo mantenimiento</h3>
      <div id="maintenanceLoading" style="font-size:13px;color:var(--text-hint)">Consultando estado...</div>
      <div id="maintenanceContent" style="display:none"></div>
    </div>

    <!-- ─── Generar backup ─── -->
    <div class="backup-section">
      <h3><span class="material-symbols-outlined" style="color:#1a73e8">download</span>Generar backup completo</h3>

      <div id="statsLoading" style="font-size:13px;color:var(--text-hint)">Calculando qué se va a incluir...</div>
      <div id="statsGrid" class="stats-mini-grid" style="display:none"></div>

      <div id="lastBackupNote" class="last-backup-note" style="display:none"></div>

      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button class="btn btn-primary" id="downloadBtn" onclick="downloadBackup()">
          <span class="material-symbols-outlined">download</span>
          Generar y descargar backup
        </button>
        <button class="btn btn-outline" onclick="bkcAbrir()">
          <span class="material-symbols-outlined">compress</span>
          Comprimir y descargar…
        </button>
      </div>
      <div id="downloadStatus" style="margin-top:10px;font-size:13px;display:none"></div>
    </div>

    <!-- ─── Enviar por FTP a otra PC ─── -->
    <div class="backup-section">
      <h3><span class="material-symbols-outlined" style="color:#1a73e8">lan</span>Enviar el backup a otra PC por FTP</h3>

      <p style="font-size:13px;color:var(--text-secondary);margin:0 0 14px">
        En vez de bajar el backup por el navegador, el servidor lo empuja directo a otra máquina
        (por ejemplo tu PC, usando su IP o su nombre de Tailscale). Va el paquete completo:
        la base de datos entera más todos los archivos subidos, el mismo <code>.tar.gz</code>
        que genera el botón de arriba y que sirve para restaurar.
      </p>

      <div class="backup-warning" style="margin-bottom:16px">
        <span class="material-symbols-outlined" style="color:#ea8600">swap_horiz</span>
        <div>
          <strong>Importante, porque FTP funciona al revés de lo que suena:</strong> el que manda es
          este servidor, pero <strong>la PC que recibe tiene que estar corriendo un servidor FTP</strong>
          y encendida durante toda la transferencia. FTP no puede "empujarle" un archivo a una
          máquina que no está escuchando. Abajo están los pasos para dejarlo andando en Windows.
        </div>
      </div>

      <div id="ftpConfigLoading" style="font-size:13px;color:var(--text-hint)">Cargando destino guardado...</div>

      <div id="ftpForm" style="display:none">
        <div class="ftp-grid">
          <label class="ftp-campo" style="grid-column:span 2">
            <span>IP o nombre de la PC que recibe</span>
            <input type="text" id="ftpHost" autocomplete="off" placeholder="100.101.102.103  ó  mi-pc.tailc1c538.ts.net">
            <span class="ftp-hint">La que muestra Tailscale para esa máquina.</span>
          </label>
          <label class="ftp-campo">
            <span>Puerto</span>
            <input type="number" id="ftpPuerto" min="1" max="65535" placeholder="21">
          </label>
          <label class="ftp-campo">
            <span>Modo de conexión</span>
            <select id="ftpModo">
              <option value="plano">Sin cifrar (FTP)</option>
              <option value="ftps">FTPS explícito (AUTH TLS)</option>
              <option value="ftps-implicito">FTPS implícito (puerto 990)</option>
            </select>
          </label>
          <label class="ftp-campo">
            <span>Usuario</span>
            <input type="text" id="ftpUsuario" autocomplete="off" placeholder="usuario del servidor FTP">
          </label>
          <label class="ftp-campo">
            <span>Contraseña</span>
            <input type="password" id="ftpPassword" autocomplete="new-password" placeholder="">
            <span class="ftp-hint" id="ftpPasswordHint"></span>
          </label>
          <label class="ftp-campo" style="grid-column:span 2">
            <span>Carpeta de destino en esa PC</span>
            <input type="text" id="ftpDirectorio" autocomplete="off" placeholder="/backups-classroom">
            <span class="ftp-hint">Si no existe, se crea. Es relativa a la carpeta raíz del sitio FTP.</span>
          </label>
        </div>

        <label style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start;margin-bottom:6px">
          <input type="checkbox" id="ftpGuardarPassword" style="margin-top:2px">
          <span id="ftpGuardarPasswordTexto">
            Recordar la contraseña en el servidor (cifrada con la clave del sistema), así el envío
            se puede disparar con un solo clic.
          </span>
        </label>

        <div style="font-size:12.5px;color:var(--text-secondary);margin-bottom:14px">
          Comprimir antes de enviar (achica el paquete, tarda más CPU del servidor):
          <label style="margin-left:10px"><input type="checkbox" id="ftpCompImagenes"> imágenes</label>
          <label style="margin-left:10px"><input type="checkbox" id="ftpCompPdf"> PDF</label>
          <span id="ftpCompNota" class="ftp-hint" style="display:block;margin-top:4px"></span>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <button class="btn btn-outline" id="ftpProbarBtn" onclick="ftpProbar()">
            <span class="material-symbols-outlined">network_check</span>
            Probar conexión
          </button>
          <button class="btn btn-outline" id="ftpGuardarBtn" onclick="ftpGuardar()">
            <span class="material-symbols-outlined">save</span>
            Guardar destino
          </button>
          <button class="btn btn-primary" id="ftpEnviarBtn" onclick="ftpEnviar()">
            <span class="material-symbols-outlined">cloud_upload</span>
            Enviar backup ahora
          </button>
          <button class="btn btn-outline" id="ftpCancelarBtn" style="display:none;border-color:#c5221f;color:#c5221f" onclick="ftpCancelar()">
            <span class="material-symbols-outlined">stop_circle</span>
            Cancelar envío
          </button>
          <button class="btn btn-outline" id="ftpOlvidarBtn" style="display:none;margin-left:auto" onclick="ftpOlvidar()">
            <span class="material-symbols-outlined">delete</span>
            Olvidar destino
          </button>
        </div>

        <div id="ftpStatus" style="margin-top:14px;font-size:13px"></div>

        <details class="ftp-pasos">
          <summary>Cómo dejar tu PC con Windows lista para recibir (una sola vez)</summary>
          <ol>
            <li>
              <strong>Instalar el servidor FTP.</strong> Panel de control → Programas →
              <em>Activar o desactivar las características de Windows</em> →
              <code>Internet Information Services</code> → <code>Servidor FTP</code>
              (marcar <em>Servicio FTP</em> y <em>Extensibilidad de FTP</em>) y también
              <code>Herramientas de administración web</code> → <em>Consola de administración de IIS</em>.
              Alternativa más simple si preferís: instalar <strong>FileZilla Server</strong>.
            </li>
            <li>
              <strong>Crear el sitio FTP.</strong> Administrador de IIS → clic derecho en <em>Sitios</em> →
              <em>Agregar sitio FTP</em>. Elegí la carpeta donde querés que caigan los backups
              (ojo: que tenga espacio, el paquete pesa cerca de 1 GB).
            </li>
            <li>
              <strong>Enlace y autenticación.</strong> En el asistente, dejá el puerto <code>21</code>,
              elegí <em>Sin SSL</em> si vas a usar el modo "Sin cifrar", marcá
              <em>Autenticación básica</em> y en autorización dale
              <strong>permiso de Leer y Escribir</strong> a tu usuario. Sin el permiso de escritura
              la conexión entra pero el envío falla.
            </li>
            <li>
              <strong>Abrir el firewall.</strong> Firewall de Windows → <em>Permitir una aplicación</em> →
              habilitá <code>Servidor FTP</code> para redes privadas. Además, en IIS →
              <em>Compatibilidad con firewall FTP</em>, poné un rango de puertos pasivos
              (por ejemplo <code>50000-50100</code>) y abrí ese mismo rango en el firewall:
              es el paso que más se olvida y el que hace fallar la transferencia justo después
              de conectar bien.
            </li>
            <li>
              <strong>Averiguar la dirección.</strong> Abrí Tailscale en esa PC y copiá su IP
              <code>100.x.y.z</code> o su nombre. Pegala arriba, apretá <em>Probar conexión</em> y,
              si da verde, ya podés enviar.
            </li>
          </ol>
          <p style="margin:10px 0 0;color:var(--text-secondary);font-size:12.5px">
            Sobre el cifrado: el tráfico entre las dos máquinas viaja dentro del túnel de Tailscale,
            que ya va cifrado. Por eso el modo "Sin cifrar" es aceptable acá y es el que menos
            configuración necesita. FTPS agrega una segunda capa si el servidor de tu PC la soporta.
          </p>
        </details>
      </div>
    </div>

    <!-- ─── Restaurar ─── -->
    <div class="backup-section">
      <h3><span class="material-symbols-outlined" style="color:#ea4335">upload</span>Restaurar desde backup</h3>

      <div class="backup-warning" style="margin-bottom:16px">
        <span class="material-symbols-outlined" style="color:#ea8600">warning</span>
        <div>
          Al restaurar, la base de datos actual queda <strong>reemplazada por completo</strong> con el contenido del backup.
          Todo lo creado después de la fecha del backup se pierde. El sistema genera automáticamente un backup del
          estado actual antes de aplicar cualquier cambio, como red de seguridad.
        </div>
      </div>

      <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
        <span class="material-symbols-outlined" style="font-size:32px;color:var(--text-hint)">upload_file</span>
        <p style="margin:8px 0 0">Elegí un archivo .tar.gz o arrastralo acá</p>
        <input type="file" id="fileInput" accept=".tar.gz,.tgz" style="display:none">
      </div>

      <div id="previewArea" style="display:none"></div>
    </div>

  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/backup-compress-modal') %>

  <script>
    const LAST_BACKUP_KEY = 'classroom_last_backup';

    function formatBytes(bytes) {
      if (bytes >= 1024 * 1024 * 1024) return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
      if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
      if (bytes >= 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return bytes + ' B';
    }

    function renderLastBackupNote() {
      const raw = localStorage.getItem(LAST_BACKUP_KEY);
      const el = document.getElementById('lastBackupNote');
      if (!raw) return;
      try {
        const info = JSON.parse(raw);
        const date = new Date(info.date);
        // El tamaño solo lo saben los backups viejos: desde que la descarga la maneja el
        // navegador (y no un blob en memoria) la página nunca ve cuántos bytes bajaron.
        el.textContent = `Último backup generado desde este navegador: ${Fecha.fechaHora(date)}`
          + (info.size ? ` (${formatBytes(info.size)})` : '');
        el.style.display = 'block';
      } catch {}
    }

    async function loadStats() {
      try {
        const res  = await fetch('/superadmin/backup/stats');
        const data = await res.json();
        const c = data.collections, f = data.files;

        const cards = [
          ['schools',       'Escuelas'],
          ['users',         'Usuarios'],
          ['courses',       'Materias'],
          ['divisions',     'Divisiones'],
          ['activities',    'Actividades'],
          ['submissions',   'Entregas'],
          ['announcements', 'Novedades'],
          ['suggestions',   'Sugerencias'],
          ['subjects',      'Catálogo materias'],
          // Sala en vivo. Estaban en COLLECTIONS (routes/backup.js) y sí se respaldaban,
          // pero faltaban acá: la pantalla decía "qué se va a incluir" y se las comía.
          ['roomsessions',  'Sesiones de sala'],
          ['roommessages',  'Mensajes de sala'],
          ['roompresences', 'Asistencias de sala'],
        ];
        let html = cards.map(([key, label]) => `
          <div class="stats-mini-card">
            <div class="stats-mini-value">${c[key] ?? 0}</div>
            <div class="stats-mini-label">${label}</div>
          </div>`).join('');

        const totalFileBytes = f.archivos.sizeBytes + f.entregas.sizeBytes;
        const totalFileCount = f.archivos.count + f.entregas.count;
        html += `
          <div class="stats-mini-card" style="grid-column:span 2">
            <div class="stats-mini-value">${formatBytes(totalFileBytes)}</div>
            <div class="stats-mini-label">${totalFileCount} archivo(s) subidos (adjuntos, novedades, avatares, entregas)</div>
          </div>`;

        document.getElementById('statsGrid').innerHTML = html;
        document.getElementById('statsGrid').style.display = 'grid';
        document.getElementById('statsLoading').style.display = 'none';
      } catch {
        document.getElementById('statsLoading').textContent = 'No se pudo calcular (revisá la consola)';
      }
    }

    // La descarga la maneja el NAVEGADOR, no esta página.
    //
    // Antes acá había un fetch() + res.blob(): eso obliga a la pestaña a juntar el backup
    // entero en memoria antes de poder guardarlo. Con la base real son ~850 MB dentro de la
    // pestaña, y ese es el punto donde la descarga se caía sin decir por qué (el catch de
    // abajo mostraba el cartel genérico "Error al generar el backup", que no distingue un
    // fallo del servidor de uno del navegador).
    //
    // Un iframe apuntado a la ruta deja que el navegador escriba directo a Descargas, sin
    // pasar por la memoria de la página. Se pierde la barra de progreso propia; la del
    // navegador ya la muestra, y a cambio la descarga aguanta cualquier tamaño.
    function downloadBackup() {
      const btn    = document.getElementById('downloadBtn');
      const status = document.getElementById('downloadStatus');
      status.style.display = 'block';
      status.innerHTML = '<span class="spinner-inline"></span>Preparando el backup...';
      btn.disabled = true;

      // Se reusa un único iframe: cada descarga puede durar minutos y no hace falta ir
      // acumulando nodos en el DOM a cada clic.
      let marco = document.getElementById('backupFrame');
      if (!marco) {
        marco = document.createElement('iframe');
        marco.id = 'backupFrame';
        marco.style.display = 'none';
        document.body.appendChild(marco);
      }

      let resuelto = false;

      // Si la respuesta trae Content-Disposition: attachment, el navegador se la lleva a
      // Descargas y el iframe NUNCA navega: 'load' no dispara. Que dispare significa que el
      // servidor mandó algo renderizable — o sea, un error. Es lo que evita que un fallo
      // termine mostrando un cartel de éxito.
      marco.onload = () => {
        if (resuelto) return;
        resuelto = true;
        btn.disabled = false;
        status.innerHTML = '<span style="color:#c5221f">✗ El servidor no devolvió el backup. Revisá logs/error.log en el servidor.</span>';
      };

      marco.src = '/superadmin/backup/download?t=' + Date.now();

      // Pasados unos segundos sin 'load', la descarga arrancó de verdad. El servidor manda el
      // primer byte casi de inmediato (el tar sale en streaming), así que este margen es
      // holgado. De acá en más la maneja el navegador y esta página no se entera de nada más.
      setTimeout(() => {
        if (resuelto) return;
        resuelto = true;
        btn.disabled = false;
        localStorage.setItem(LAST_BACKUP_KEY, JSON.stringify({ date: new Date().toISOString() }));
        renderLastBackupNote();
        status.innerHTML = '<span style="color:#137333">✔ Descarga en curso: buscá <b>classroom-backup-….tar.gz</b> en la barra de descargas del navegador. Con la base actual son unos 850 MB, puede tardar varios minutos.</span>';
      }, 5000);
    }

    // ─── Envío por FTP ──────────────────────────────────────────────────────
    // El servidor arma el .tar.gz y lo empuja a la PC del dueño. La respuesta de /ftp/enviar
    // NO es un JSON al final sino un stream NDJSON (un evento por línea): el envío puede
    // durar una hora y sin progreso en pantalla nadie sabe si sigue vivo.
    let ftpEnvioAbort = null;   // AbortController del envío en curso
    let ftpTienePassword = false;

    function ftpDatosDelFormulario() {
      return {
        host:       document.getElementById('ftpHost').value.trim(),
        puerto:     document.getElementById('ftpPuerto').value.trim(),
        usuario:    document.getElementById('ftpUsuario').value.trim(),
        modo:       document.getElementById('ftpModo').value,
        directorio: document.getElementById('ftpDirectorio').value.trim(),
        password:   document.getElementById('ftpPassword').value,
      };
    }

    function ftpMensaje(html, tipo) {
      const el = document.getElementById('ftpStatus');
      const clase = tipo === 'ok' ? 'backup-result-ok' : tipo === 'error' ? 'backup-result-err' : '';
      el.innerHTML = clase ? `<div class="${clase}">${html}</div>` : html;
    }

    function ftpDuracion(ms) {
      const s = Math.round(ms / 1000);
      if (s < 60) return s + ' s';
      const m = Math.floor(s / 60);
      if (m < 60) return `${m} min ${String(s % 60).padStart(2, '0')} s`;
      return `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')} min`;
    }

    async function cargarFtpConfig() {
      try {
        const res  = await fetch('/superadmin/backup/ftp/config');
        const data = await res.json();

        const d = data.destino;
        if (d) {
          document.getElementById('ftpHost').value       = d.host;
          document.getElementById('ftpPuerto').value     = d.puerto;
          document.getElementById('ftpUsuario').value    = d.usuario;
          document.getElementById('ftpModo').value       = d.modo;
          document.getElementById('ftpDirectorio').value = d.directorio;
          document.getElementById('ftpOlvidarBtn').style.display = '';
        }

        ftpTienePassword = data.tienePassword;
        document.getElementById('ftpGuardarPassword').checked = data.tienePassword;
        document.getElementById('ftpPasswordHint').textContent = data.tienePassword
          ? 'Hay una guardada: dejalo vacío para usarla.'
          : '';

        // Sin JWT_SECRET el servidor no puede cifrar nada, y guardar en claro la contraseña
        // del FTP de casa no es una opción. Se dice por qué en vez de dejar un check que
        // falla sin explicación al apretar "Guardar".
        if (!data.puedeGuardarPassword) {
          const chk = document.getElementById('ftpGuardarPassword');
          chk.checked  = false;
          chk.disabled = true;
          document.getElementById('ftpGuardarPasswordTexto').innerHTML =
            'No se puede recordar la contraseña en este servidor (falta <code>JWT_SECRET</code>). ' +
            'Escribila cada vez que envíes.';
        }

        document.getElementById('ftpConfigLoading').style.display = 'none';
        document.getElementById('ftpForm').style.display = 'block';
      } catch {
        document.getElementById('ftpConfigLoading').textContent = 'No se pudo cargar el destino guardado';
      }
    }

    // El puerto por defecto cambia con el modo, pero solo se pisa si el dueño tenía puesto
    // el default del modo anterior: si escribió 2121 a mano, cambiar de modo no se lo borra.
    document.getElementById('ftpModo').addEventListener('change', (e) => {
      const puerto = document.getElementById('ftpPuerto');
      if (e.target.value === 'ftps-implicito' && (puerto.value === '' || puerto.value === '21')) puerto.value = 990;
      if (e.target.value !== 'ftps-implicito' && puerto.value === '990') puerto.value = 21;
    });

    // Las herramientas de compresión son binarios del sistema (sharp, Ghostscript) y pueden
    // faltar en el servidor. Se consulta el mismo endpoint que usa el modal de compresión,
    // que ya cachea el recorrido de disco 60 s.
    async function ftpCargarHerramientas() {
      try {
        const res  = await fetch('/superadmin/backup/file-stats');
        const data = await res.json();
        const faltan = [];
        if (!data.herramientas.imagenes) {
          document.getElementById('ftpCompImagenes').disabled = true;
          faltan.push('imágenes (falta sharp en el servidor)');
        }
        if (!data.herramientas.pdf) {
          document.getElementById('ftpCompPdf').disabled = true;
          faltan.push('PDF (falta Ghostscript en el servidor: <code>sudo apt install ghostscript</code>)');
        }
        if (faltan.length) {
          document.getElementById('ftpCompNota').innerHTML = 'No se puede comprimir ' + faltan.join(' ni ') + '.';
        }
      } catch { /* que falle esto no puede romper la pantalla; los checks quedan habilitados */ }
    }

    function ftpComprimirPedido() {
      const tipos = [];
      if (document.getElementById('ftpCompImagenes').checked) tipos.push('imagenes');
      if (document.getElementById('ftpCompPdf').checked)      tipos.push('pdf');
      return tipos;
    }

    async function ftpGuardar() {
      const btn = document.getElementById('ftpGuardarBtn');
      btn.disabled = true;
      ftpMensaje('<span class="spinner-inline"></span>Guardando destino...');
      try {
        const res = await fetch('/superadmin/backup/ftp/config', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...ftpDatosDelFormulario(),
            guardarPassword: document.getElementById('ftpGuardarPassword').checked,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'No se pudo guardar');

        ftpTienePassword = data.tienePassword;
        document.getElementById('ftpPassword').value = '';
        document.getElementById('ftpPasswordHint').textContent = data.tienePassword
          ? 'Hay una guardada: dejalo vacío para usarla.'
          : '';
        document.getElementById('ftpOlvidarBtn').style.display = '';
        ftpMensaje(`✔ Destino guardado: <strong>${esc(data.destino.host)}:${data.destino.puerto}${esc(data.destino.directorio)}</strong>`, 'ok');
      } catch (err) {
        ftpMensaje('✗ ' + esc(err.message), 'error');
      } finally {
        btn.disabled = false;
      }
    }

    async function ftpOlvidar() {
      if (!confirm('¿Borrar el destino FTP guardado (incluida la contraseña)?')) return;
      try {
        const res = await fetch('/superadmin/backup/ftp/config', { method: 'DELETE' });
        if (!res.ok) throw new Error('No se pudo borrar');
        ['ftpHost', 'ftpPuerto', 'ftpUsuario', 'ftpDirectorio', 'ftpPassword'].forEach(id => {
          document.getElementById(id).value = '';
        });
        ftpTienePassword = false;
        document.getElementById('ftpGuardarPassword').checked = false;
        document.getElementById('ftpPasswordHint').textContent = '';
        document.getElementById('ftpOlvidarBtn').style.display = 'none';
        ftpMensaje('✔ Destino olvidado.', 'ok');
      } catch (err) {
        ftpMensaje('✗ ' + esc(err.message), 'error');
      }
    }

    async function ftpProbar() {
      const btn = document.getElementById('ftpProbarBtn');
      btn.disabled = true;
      ftpMensaje('<span class="spinner-inline"></span>Conectando y probando permiso de escritura...');
      try {
        const res = await fetch('/superadmin/backup/ftp/probar', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(ftpDatosDelFormulario()),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'No se pudo conectar');

        ftpMensaje(
          `✔ Conexión correcta con <strong>${esc(data.host)}:${data.puerto}</strong>. ` +
          `Se pudo escribir en <strong>${esc(data.carpeta)}</strong>.` +
          (data.limpio ? '' : ' <em>Quedó un archivo de prueba <code>.classroom-prueba-de-escritura</code> ' +
                              'que no se pudo borrar: el usuario FTP puede escribir pero no eliminar.</em>'),
          'ok');
      } catch (err) {
        ftpMensaje('✗ ' + esc(err.message), 'error');
      } finally {
        btn.disabled = false;
      }
    }

    function ftpCancelar() {
      if (ftpEnvioAbort) ftpEnvioAbort.abort();
    }

    async function ftpEnviar() {
      const enviarBtn = document.getElementById('ftpEnviarBtn');
      const cancelBtn = document.getElementById('ftpCancelarBtn');
      enviarBtn.disabled = true;
      cancelBtn.style.display = '';
      ftpMensaje('<span class="spinner-inline"></span>Preparando el envío...');

      ftpEnvioAbort = new AbortController();
      const arranque = Date.now();
      let estimado = 0, ultimoBytes = 0, termino = false;

      const pintarProgreso = (bytes, ms) => {
        // El estimado sale del peso de los archivos del servidor: el .tar.gz pesa casi lo
        // mismo (ya son JPEG/PDF comprimidos). Puede quedar corto, así que la barra se
        // clava en 99% hasta que llega el evento de fin en vez de mostrar 103%.
        const pct = estimado ? Math.min(99, Math.round(bytes / estimado * 100)) : 0;
        const velocidad = ms > 0 ? bytes / (ms / 1000) : 0;
        const restante  = (estimado && velocidad > 0 && bytes < estimado)
          ? ftpDuracion((estimado - bytes) / velocidad * 1000) : null;

        ftpMensaje(`
          <div><span class="spinner-inline"></span>Transfiriendo... no cierres esta pestaña.</div>
          <div class="ftp-barra"><div style="width:${pct}%"></div></div>
          <div class="ftp-cifras">
            <span>${formatBytes(bytes)}${estimado ? ' de ~' + formatBytes(estimado) : ''}</span>
            <span>${formatBytes(velocidad)}/s</span>
            <span>${ftpDuracion(ms)} transcurridos</span>
            ${restante ? `<span>faltan ~${restante}</span>` : ''}
          </div>`);
      };

      const manejarEvento = (ev) => {
        if (ev.tipo === 'estado') {
          ftpMensaje('<span class="spinner-inline"></span>' + esc(ev.mensaje));
        } else if (ev.tipo === 'inicio') {
          estimado = ev.estimadoBytes || 0;
          pintarProgreso(0, 0);
        } else if (ev.tipo === 'progreso') {
          ultimoBytes = ev.bytes;
          pintarProgreso(ev.bytes, ev.ms);
        } else if (ev.tipo === 'fin') {
          termino = true;
          if (ev.ok) {
            localStorage.setItem(LAST_BACKUP_KEY, JSON.stringify({ date: new Date().toISOString(), size: ev.bytes }));
            renderLastBackupNote();
            ftpMensaje(
              `✅ Backup enviado: <strong>${formatBytes(ev.bytes)}</strong> en ${ftpDuracion(ev.ms)}.` +
              `<div style="margin-top:6px;font-size:12px">Quedó en <code>${esc(ev.remoto)}</code> de la PC de destino.</div>`,
              'ok');
          } else if (ev.cancelado) {
            ftpMensaje('Envío cancelado. Se borró el archivo parcial del destino.', 'error');
          } else {
            ftpMensaje(`✗ ${esc(ev.error)}` +
              (ev.bytes ? `<div style="margin-top:6px;font-size:12px">Se habían transferido ${formatBytes(ev.bytes)} antes de cortarse.</div>` : ''),
              'error');
          }
        }
      };

      try {
        const res = await fetch('/superadmin/backup/ftp/enviar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...ftpDatosDelFormulario(), comprimir: ftpComprimirPedido() }),
          signal: ftpEnvioAbort.signal,
        });

        // Los errores que el servidor puede detectar ANTES de empezar (destino incompleto,
        // sin contraseña, rate limit) llegan como JSON con status de error. A partir del
        // 200 la respuesta es el stream y los fallos vienen adentro, en el evento `fin`.
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || `El servidor respondió ${res.status}`);
        }

        const lector = res.body.getReader();
        const dec    = new TextDecoder();
        let buffer   = '';
        while (true) {
          const { value, done } = await lector.read();
          if (done) break;
          buffer += dec.decode(value, { stream: true });
          const lineas = buffer.split('\n');
          buffer = lineas.pop();
          for (const linea of lineas) {
            if (linea.trim()) manejarEvento(JSON.parse(linea));
          }
        }

        // Stream cortado sin evento `fin`: se cayó la conexión con el navegador, no el FTP.
        // Hay que decirlo, porque del lado del servidor el envío pudo haber seguido.
        if (!termino) {
          ftpMensaje('✗ Se perdió la conexión con el servidor antes de terminar. Revisá la carpeta de ' +
                     'destino: si hay un archivo <code>.part</code>, el envío quedó a medias.', 'error');
        }
      } catch (err) {
        if (err.name === 'AbortError') {
          ftpMensaje(`Envío cancelado a los ${formatBytes(ultimoBytes)} (${ftpDuracion(Date.now() - arranque)}). ` +
                     'El archivo parcial se borra solo del destino.', 'error');
        } else {
          ftpMensaje('✗ ' + esc(err.message), 'error');
        }
      } finally {
        ftpEnvioAbort = null;
        enviarBtn.disabled = false;
        cancelBtn.style.display = 'none';
      }
    }

    // ─── Restore ───
    let currentPreviewToken = null;

    const fileInput = document.getElementById('fileInput');
    const dropZone  = document.getElementById('dropZone');
    fileInput.addEventListener('change', () => { if (fileInput.files[0]) uploadForPreview(fileInput.files[0]); });
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      if (e.dataTransfer.files[0]) uploadForPreview(e.dataTransfer.files[0]);
    });

    async function uploadForPreview(file) {
      const area = document.getElementById('previewArea');
      area.style.display = 'block';
      area.innerHTML = '<div style="padding:16px"><span class="spinner-inline"></span>Leyendo el backup...</div>';

      const fd = new FormData();
      fd.append('file', file);
      try {
        const res  = await fetch('/superadmin/backup/preview', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) {
          area.innerHTML = `<div class="backup-result-err">✗ ${data.error || 'Error al leer el backup'}</div>`;
          return;
        }
        currentPreviewToken = data.previewToken;
        renderPreview(data.manifest, data.diff, data.willEmpty || []);
      } catch (err) {
        area.innerHTML = `<div class="backup-result-err">✗ Error de conexión: ${err.message}</div>`;
      }
    }

    function renderPreview(manifest, diff, willEmpty) {
      const area = document.getElementById('previewArea');
      const date = new Date(manifest.createdAt);

      const rows = Object.entries(diff).map(([name, { current, backup, missing }]) => {
        const delta = backup - current;
        const cls = delta > 0 ? 'diff-up' : delta < 0 ? 'diff-down' : 'diff-same';
        const sign = delta > 0 ? '+' : '';
        // Una colección ausente del backup muestra "no venía" en vez de un 0 que se leería
        // igual que "venía vacía" — el resultado es el mismo pero el motivo no.
        const celdaBackup = missing ? '<span class="diff-missing-tag">no venía</span>' : backup;
        return `<tr class="${missing ? 'diff-missing' : ''}">
          <td>${name}</td><td>${current}</td><td>${celdaBackup}</td><td class="${cls}">${sign}${delta}</td>
        </tr>`;
      }).join('');

      // El párrafo traduce a lenguaje llano QUÉ se pierde, porque "roomsessions" no le dice nada
      // a nadie a la hora de decidir. Hoy las tres opcionales de COLLECTIONS son las de la sala en
      // vivo; si se marca otra colección como optional, hay que actualizar esa frase.
      const avisoVaciado = willEmpty.length ? `
        <div class="warn-box">
          <strong>⚠️ Este backup es anterior a estas colecciones y NO las incluye:</strong>
          <ul>${willEmpty.map(n => `<li><code>${n}</code></li>`).join('')}</ul>
          <div style="margin-top:8px">
            Al restaurar <strong>se van a vaciar</strong>. Es lo que corresponde a volver a esa
            fecha —en ese momento no existían—, pero significa que perdés todo lo que haya hoy
            en la sala en vivo: sesiones, transcripciones y asistencias.
          </div>
        </div>` : '';

      const totalFiles = manifest.files.archivos.count + manifest.files.entregas.count;
      const totalBytes = manifest.files.archivos.sizeBytes + manifest.files.entregas.sizeBytes;

      // Los backups comprimidos traen este campo; los generados antes de la feature, no.
      // Hay que decirlo ANTES de restaurar: las fotos y los PDFs del servidor van a quedar
      // reemplazados por las versiones más livianas, y de ahí no se vuelve (salvo por el
      // backup de seguridad que el propio restore genera).
      const avisoCompresion = manifest.compresion ? `
        <div class="backup-warning" style="margin-bottom:12px">
          <span class="material-symbols-outlined" style="color:#ea8600">compress</span>
          <div>
            Este backup tiene los archivos <strong>comprimidos</strong>
            (${manifest.compresion.imagenes.count} imagen(es), ${manifest.compresion.pdf.count} PDF(s)).
            Al restaurarlo, los archivos del servidor quedan reemplazados por esas versiones más livianas.
            Las rutas no cambian, así que nada deja de verse.
          </div>
        </div>` : '';

      area.innerHTML = `
        <div style="margin-top:16px;padding:16px;background:var(--bg);border-radius:var(--radius)">
          <div style="font-size:13px;margin-bottom:10px">
            <strong>Fecha del backup:</strong> ${Fecha.fechaHora(date)} ·
            <strong>Generado por:</strong> ${manifest.generatedBy || '—'}
          </div>
          <table class="diff-table">
            <thead><tr><th>Colección</th><th>Actual</th><th>Backup</th><th>Cambio</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
          <div style="font-size:13px;color:var(--text-secondary);margin-bottom:12px">
            Archivos incluidos: ${formatBytes(totalBytes)} en ${totalFiles} archivo(s)
          </div>
          <!-- Los dos avisos son independientes y un backup puede disparar ambos: uno
               comprimido y a la vez anterior a las colecciones de sala en vivo. El de
               vaciado va primero porque es el único que implica perder datos. -->
          ${avisoVaciado}
          ${avisoCompresion}

          <div class="confirm-box">
            <strong style="color:#c5221f">🔴 Confirmación requerida</strong>
            <div class="confirm-checks" style="margin-top:10px">
              <label><input type="checkbox" class="confirm-check"> Entiendo que esto reemplaza TODA la base de datos actual</label>
              <label><input type="checkbox" class="confirm-check"> Entiendo que se pierden los cambios posteriores a ${Fecha.fechaHora(date)}</label>
              <label><input type="checkbox" class="confirm-check"> Entiendo que la app puede tardar unos segundos en volver a responder normalmente</label>
              ${willEmpty.length ? `<label><input type="checkbox" class="confirm-check"> Entiendo que se van a vaciar: ${willEmpty.join(', ')}</label>` : ''}
            </div>
            <label style="font-size:13px;display:block;margin-top:8px">Escribí <strong>RESTAURAR</strong> para habilitar el botón:</label>
            <input type="text" id="confirmText" class="confirm-input" autocomplete="off">
            <div style="display:flex;gap:10px;margin-top:6px">
              <button class="btn btn-outline" onclick="cancelPreview()">Cancelar</button>
              <button class="btn btn-primary" id="restoreBtn" disabled style="background:#c5221f;border-color:#c5221f" onclick="doRestore()">
                <span class="material-symbols-outlined">warning</span>
                Restaurar ahora
              </button>
            </div>
            <div id="restoreResult"></div>
          </div>
        </div>`;

      const checks = area.querySelectorAll('.confirm-check');
      const confirmText = document.getElementById('confirmText');
      const restoreBtn  = document.getElementById('restoreBtn');
      const syncBtn = () => {
        const allChecked = [...checks].every(c => c.checked);
        restoreBtn.disabled = !(allChecked && confirmText.value === 'RESTAURAR');
      };
      checks.forEach(c => c.addEventListener('change', syncBtn));
      confirmText.addEventListener('input', syncBtn);
    }

    function cancelPreview() {
      document.getElementById('previewArea').style.display = 'none';
      document.getElementById('previewArea').innerHTML = '';
      fileInput.value = '';
      currentPreviewToken = null;
    }

    async function doRestore() {
      const restoreBtn = document.getElementById('restoreBtn');
      const resultEl   = document.getElementById('restoreResult');
      restoreBtn.disabled = true;
      resultEl.innerHTML = '<div style="margin-top:12px"><span class="spinner-inline"></span>Restaurando... no cierres esta pestaña ni recargues.</div>';

      try {
        const res  = await fetch('/superadmin/backup/restore', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ previewToken: currentPreviewToken, confirmedText: document.getElementById('confirmText').value }),
        });
        const data = await res.json();
        if (!res.ok) {
          resultEl.innerHTML = `<div class="backup-result-err">✗ ${data.error || 'Error durante la restauración'}
            ${data.log?.length ? '<div class="restore-log">' + data.log.map(l => `<div>• ${l}</div>`).join('') + '</div>' : ''}
          </div>`;
          restoreBtn.disabled = false;
          return;
        }
        resultEl.innerHTML = `<div class="backup-result-ok">
          ✅ Restauración completa
          <div class="restore-log">${data.log.map(l => `<div>✔ ${l}</div>`).join('')}</div>
          <div style="margin-top:8px;font-size:12px">Backup de seguridad del estado anterior: <strong>${data.safetyBackup}</strong></div>
        </div>`;
      } catch (err) {
        resultEl.innerHTML = `<div class="backup-result-err">✗ Error de conexión: ${err.message}</div>`;
        restoreBtn.disabled = false;
      }
    }

    // ─── Modo mantenimiento ─────────────────────────────────────────────────
    // Tres estados: normal / EN ESPERA (programado, esperando a que la plataforma se
    // vacíe) / ACTIVO. Ver specs/mantenimiento-ventana.spec.md.
    const ROLE_NAMES = <%- JSON.stringify(roleNames) %>;

    // Los nombres los escriben otras personas (salen de la BD). Sin escapar, un usuario
    // llamado "<img onerror=...>" ejecutaría código en el panel del dueño.
    const esc = (s) => String(s === null || s === undefined ? '' : s)
      .replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

    let maintData      = { state: null, pending: null, activity: null };
    let maintPollTimer = null;

    async function loadMaintenanceStatus() {
      try {
        const res  = await fetch('/superadmin/backup/maintenance-status');
        const data = await res.json();
        maintData = data;
        renderMaintenanceSection(data);
        startActivityPoll();
      } catch {
        document.getElementById('maintenanceLoading').textContent = 'No se pudo consultar el estado';
      }
    }

    // Con una espera en curso manda el umbral con el que se programó; si no, el que el
    // dueño esté tanteando en el formulario (así ve el efecto ANTES de programar nada).
    function idleMinutesEnUso() {
      if (maintData.pending) return maintData.pending.idleMinutes || 5;
      const el = document.getElementById('maintIdle');
      const n  = el ? parseInt(el.value, 10) : 5;
      return Number.isFinite(n) && n > 0 ? Math.min(60, n) : 5;
    }

    function startActivityPoll() {
      clearInterval(maintPollTimer);
      if (maintData.state) return; // ya está bloqueado: no hay a quién esperar
      maintPollTimer = setInterval(pollActivity, 10000);
      pollActivity();
    }

    async function pollActivity() {
      // Un panel abierto y olvidado toda la tarde no tiene por qué seguir consultando.
      if (document.hidden || maintData.state) return;
      try {
        const res  = await fetch('/superadmin/backup/maintenance/activity?idleMinutes=' + idleMinutesEnUso());
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al consultar');
        // El promotor pudo haber activado el mantenimiento solo mientras mirábamos (o el
        // estado pudo cambiar desde el otro worker): ahí se recarga la sección entera.
        if (data.active || (!!data.pending !== !!maintData.pending)) return loadMaintenanceStatus();
        renderActivity(data);
      } catch {
        const box = document.getElementById('maintActivityBox');
        if (box) box.innerHTML = '<span style="color:#c5221f;font-size:13px">No se pudo consultar quién está trabajando.</span>';
      }
    }

    document.addEventListener('visibilitychange', () => { if (!document.hidden) pollActivity(); });

    // El semáforo. Se dibuja en su propio nodo para que el refresco cada 10 s no le borre
    // al dueño lo que esté tipeando en el formulario de al lado.
    function renderActivity(a) {
      const box = document.getElementById('maintActivityBox');
      if (!box) return;

      const ready = a.count === 0;
      const roles = Object.entries(a.byRole || {})
        .map(([r, n]) => `${ROLE_NAMES[r] || r}: ${n}`).join(' · ');

      const lista = (a.users || []).map(u => `
        <div style="display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px solid var(--border);font-size:12.5px">
          <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(u.name)}</span>
          <span style="color:var(--text-hint);white-space:nowrap">${esc(ROLE_NAMES[u.role] || u.role)} · ${u.minutesAgo === 0 ? 'ahora' : 'hace ' + u.minutesAgo + ' min'}</span>
        </div>`).join('');

      const espera = a.pending
        ? `<div style="font-size:12px;margin-top:6px">Esperando hace <strong>${a.pending.waitedMinutes} min</strong>${
             a.pending.deadline ? ' · se activa igual a las ' + Fecha.hora(a.pending.deadline) : ''}</div>`
        : '';

      box.innerHTML = `
        <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:10px;
                    background:${ready ? '#e6f4ea' : '#fef7e0'};border:1px solid ${ready ? '#137333' : '#f0c040'}">
          <span style="font-size:18px;line-height:1.2">${ready ? '🟢' : '🟠'}</span>
          <div style="color:${ready ? '#137333' : '#7a5b00'};min-width:0">
            <strong style="font-size:13.5px">${ready
              ? 'Listo para mantener: no hay nadie trabajando.'
              : a.count + (a.count === 1 ? ' persona trabajando ahora mismo.' : ' personas trabajando ahora mismo.')}</strong>
            <div style="font-size:11.5px;opacity:.9;margin-top:3px">
              Cuenta a quien haya usado la plataforma en los últimos ${a.idleMinutes} min (vos no contás).${roles ? ' · ' + esc(roles) : ''}
            </div>
            ${espera}
          </div>
        </div>
        ${lista ? `<details style="margin-top:8px">
          <summary style="cursor:pointer;font-size:12.5px;color:var(--text-secondary)">Ver quiénes están${a.truncated ? ' (primeros ' + a.users.length + ')' : ''}</summary>
          <div style="margin-top:6px;max-height:220px;overflow:auto">${lista}</div>
        </details>` : ''}`;
    }

    function renderMaintenanceSection(data) {
      document.getElementById('maintenanceLoading').style.display = 'none';
      const content = document.getElementById('maintenanceContent');
      content.style.display = 'block';

      const state   = data.state;
      const pending = data.pending;
      const inputCss = 'padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:13px;background:var(--surface);color:var(--text-primary)';

      if (state) {
        const date = new Date(state.activatedAt);
        const origen = state.reason === 'restore' ? '(automático, durante una restauración)'
                     : state.reason === 'auto'
                        ? (state.promotedBy === 'deadline'
                            ? '(automático, venció el tope de espera)'
                            : '(automático, se vació la plataforma)')
                        : '(manual)';
        content.innerHTML = `
          <div class="backup-warning" style="border-color:#ea4335;background:#fce8e6;color:#7a1a1a">
            <span class="material-symbols-outlined" style="color:#c5221f">error</span>
            <div>
              <strong>El sitio está EN MANTENIMIENTO ahora mismo.</strong> Todos los usuarios (excepto vos) ven la
              página de aviso en vez de la app.<br>
              <span style="font-size:12px">Activado ${Fecha.fechaHora(date)} por ${esc(state.activatedBy)} ${origen}</span><br>
              <span style="font-size:12px">Mensaje mostrado: "${esc(state.message)}"${state.eta ? ' · ETA: ' + esc(state.eta) : ''}</span>
            </div>
          </div>
          <button class="btn btn-primary" onclick="toggleMaintenance(false)">
            <span class="material-symbols-outlined">check_circle</span>
            Desactivar mantenimiento
          </button>
          <div id="maintenanceActionStatus" style="margin-top:10px;font-size:13px"></div>`;

      } else if (pending) {
        const date = new Date(pending.requestedAt);
        content.innerHTML = `
          <div id="maintActivityBox" style="margin-bottom:12px"></div>
          <div class="backup-warning" style="border-color:#ea8600;background:#fef7e0;color:#7a5b00">
            <span class="material-symbols-outlined" style="color:#ea8600">hourglass_top</span>
            <div>
              <strong>Mantenimiento EN ESPERA.</strong> No se expulsó a nadie: los que ya estaban adentro
              siguen trabajando y no entra nadie nuevo. Apenas la plataforma quede vacía, el mantenimiento
              se activa solo (se controla cada 30 segundos).<br>
              <span style="font-size:12px">Programado ${Fecha.fechaHora(date)} por ${esc(pending.requestedBy)} ·
              inactividad ${pending.idleMinutes} min ·
              ${pending.maxWaitMinutes ? 'se activa igual tras ' + pending.maxWaitMinutes + ' min de espera' : 'sin tope de espera'}</span><br>
              <span style="font-size:12px">Mensaje: "${esc(pending.message)}"${pending.eta ? ' · ETA: ' + esc(pending.eta) : ''}${
                pending.notifyActiveUsers ? ' · los usuarios conectados están viendo el aviso' : ''}</span>
            </div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="btn btn-outline" onclick="cancelMaintenanceWindow()">
              <span class="material-symbols-outlined">event_busy</span>
              Cancelar espera
            </button>
            <button class="btn btn-outline" style="border-color:#c5221f;color:#c5221f" onclick="toggleMaintenance(true)">
              <span class="material-symbols-outlined">bolt</span>
              Activar ahora igual
            </button>
          </div>
          <div id="maintenanceActionStatus" style="margin-top:10px;font-size:13px"></div>`;

      } else {
        content.innerHTML = `
          <div id="maintActivityBox" style="margin-bottom:12px"></div>
          <p style="font-size:13px;color:var(--text-secondary);margin:0 0 12px">
            <strong>Programar</strong> corta los ingresos nuevos y espera a que terminen los que ya están
            trabajando: cuando no quede nadie, el mantenimiento se activa solo.
            <strong>Activar ahora</strong> bloquea a todos en el acto, estén haciendo lo que estén haciendo.
          </p>
          <div style="display:flex;flex-direction:column;gap:8px;max-width:460px">
            <input type="text" id="maintMessage" placeholder="Mensaje (opcional, ej: Estamos actualizando el sistema)" style="${inputCss}">
            <input type="text" id="maintEta" placeholder="Tiempo estimado (opcional, ej: 10-15 minutos)" style="${inputCss}">
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <label style="font-size:12.5px;color:var(--text-secondary);display:flex;flex-direction:column;gap:4px;flex:1;min-width:180px">
                Considerar inactivo tras (min)
                <input type="number" id="maintIdle" value="5" min="1" max="60" style="${inputCss}" oninput="pollActivity()">
              </label>
              <label style="font-size:12.5px;color:var(--text-secondary);display:flex;flex-direction:column;gap:4px;flex:1;min-width:180px">
                Esperar como máximo (min, opcional)
                <input type="number" id="maintMaxWait" placeholder="sin límite" min="1" max="1440" style="${inputCss}">
              </label>
            </div>
            <label style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start">
              <input type="checkbox" id="maintNotify" style="margin-top:2px">
              <span>Avisar a los que están trabajando (les muestra una franja para que vayan guardando).
                Ojo: puede acelerar la espera, pero también provocar una avalancha de entregas de último momento.</span>
            </label>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
            <button class="btn btn-primary" onclick="scheduleMaintenance()">
              <span class="material-symbols-outlined">schedule</span>
              Programar mantenimiento
            </button>
            <button class="btn btn-outline" style="border-color:#ea8600;color:#ea8600" onclick="toggleMaintenance(true)">
              <span class="material-symbols-outlined">build</span>
              Activar ahora
            </button>
          </div>
          <div id="maintenanceActionStatus" style="margin-top:10px;font-size:13px"></div>`;
      }
    }

    async function maintAction(path, body, mensajeError) {
      const statusEl = document.getElementById('maintenanceActionStatus');
      statusEl.innerHTML = '<span class="spinner-inline"></span>Aplicando...';
      try {
        const res  = await fetch(path, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || mensajeError);
        await loadMaintenanceStatus();
        return data;
      } catch (err) {
        statusEl.innerHTML = `<span style="color:#c5221f">✗ ${esc(err.message)}</span>`;
        return null;
      }
    }

    async function scheduleMaintenance() {
      const data = await maintAction('/superadmin/backup/maintenance/schedule', {
        message:           document.getElementById('maintMessage').value.trim(),
        eta:               document.getElementById('maintEta').value.trim(),
        idleMinutes:       document.getElementById('maintIdle').value,
        maxWaitMinutes:    document.getElementById('maintMaxWait').value,
        notifyActiveUsers: document.getElementById('maintNotify').checked,
      }, 'Error al programar el mantenimiento');

      // Caso "no había nadie": no se programó nada, se activó en el acto. Conviene decirlo,
      // porque el dueño apretó "programar" y se encontró con el sitio ya bloqueado.
      if (data && data.activated) {
        document.getElementById('maintenanceActionStatus').innerHTML =
          '<span style="color:#137333">✓ No había nadie trabajando: el mantenimiento se activó en el acto.</span>';
      }
    }

    function cancelMaintenanceWindow() {
      maintAction('/superadmin/backup/maintenance/cancel', {}, 'Error al cancelar la espera');
    }

    // Activar/desactivar YA MISMO. Con una espera en curso, el mensaje y la ETA salen de
    // ella (el formulario no está en pantalla en ese estado).
    function toggleMaintenance(activate) {
      const path = activate ? '/superadmin/backup/maintenance/on' : '/superadmin/backup/maintenance/off';
      let body = {};
      if (activate) {
        const msgEl = document.getElementById('maintMessage');
        body = msgEl
          ? { message: msgEl.value.trim(), eta: document.getElementById('maintEta').value.trim() }
          : { message: maintData.pending?.message, eta: maintData.pending?.eta };
      }
      maintAction(path, body, 'Error al aplicar el cambio');
    }

    loadStats();
    renderLastBackupNote();
    loadMaintenanceStatus();
    cargarFtpConfig();
    // Diferido: /file-stats recorre el disco y no vale la pena que compita con /stats,
    // que es lo que la pantalla necesita mostrar primero.
    setTimeout(ftpCargarHerramientas, 400);
  </script>
</body>
</html>
