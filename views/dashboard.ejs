<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clases - Classroom</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="main-content">
    <div class="dashboard-topbar">
      <h2>Tus clases</h2>
      <div class="dashboard-actions">
        <% /* Unirse por código se ELIMINÓ (decisión del usuario, 2026-07-30). La única vía
              del alumno para pedir el alta es la solicitud, que llega como sugerencia al
              superadmin; matricular es siempre una acción administrativa. Los docentes
              tampoco crean materias desde acá (decisión del 2026-07-25). */ %>
        <% if (user.role !== 'teacher') { %>
          <button class="btn btn-outline" onclick="showRequestModal()">
            <span class="material-symbols-outlined">outgoing_mail</span>
            Enviar solicitud para unirme
          </button>
        <% } %>
        <% /* El preceptor tampoco: no dicta materias, las administra desde /preceptor.
              El endpoint POST /courses/create además lo rechaza por rol. */ %>
        <% if (user.role !== 'student' && user.role !== 'teacher' && user.role !== 'preceptor') { %>
        <button class="btn btn-primary" onclick="showCreateModal()">
          <span class="material-symbols-outlined">add</span>
          Crear clase
        </button>
        <% } %>
      </div>
    </div>

    <% if (typeof pendingSummary !== 'undefined' && pendingSummary) { %>
    <div class="pending-band">
      <span class="material-symbols-outlined">assignment_late</span>
      <span>
        Tenés <strong><%= pendingSummary.total %></strong>
        tarea<%= pendingSummary.total !== 1 ? 's' : '' %> pendiente<%= pendingSummary.total !== 1 ? 's' : '' %>
        <% if (pendingSummary.dueToday > 0) { %>
          &nbsp;·&nbsp; <strong class="pending-band-urgent"><%= pendingSummary.dueToday %> vence<%= pendingSummary.dueToday !== 1 ? 'n' : '' %> hoy</strong>
        <% } %>
      </span>
      <a href="/activities/my-pending" class="pending-band-link">Ver todas</a>
    </div>
    <% } %>

    <%# Invitación a completar el perfil. Va DESPUÉS del aviso de tareas pendientes y en
        azul informativo (no ámbar) para no competir con él: lo urgente es la tarea que vence,
        esto es opcional. Arranca oculto y lo muestra el script de abajo si no fue descartado,
        así no parpadea al cargar. %>
    <% if (typeof profilePrompt !== 'undefined' && profilePrompt) { %>
    <div class="profile-band" id="profileBand" style="display:none">
      <span class="material-symbols-outlined">account_circle</span>
      <span>
        Contanos algo sobre vos: te falta agregar
        <strong><%= profilePrompt.faltantes.join(', ').replace(/, ([^,]*)$/, ' y $1') %></strong>.
      </span>
      <a href="/courses/profile" class="profile-band-link">Completar perfil</a>
      <button class="profile-band-close" onclick="descartarAvisoPerfil()" title="No mostrar por ahora"
        aria-label="Cerrar aviso">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <script>
      /* El descarte vive en localStorage y no en la base: es una preferencia de presentación,
         no un dato del usuario. Caduca a los 7 días para que el aviso vuelva a aparecer una
         vez, en vez de perderse para siempre con un solo click distraído. */
      (function () {
        var CLAVE = 'avisoPerfilDescartadoEl';
        var DIAS  = 7;
        var band  = document.getElementById('profileBand');
        if (!band) return;

        var descartadoEl = parseInt(localStorage.getItem(CLAVE) || '0', 10);
        var vencido = !descartadoEl || (Date.now() - descartadoEl) > DIAS * 24 * 60 * 60 * 1000;
        if (vencido) band.style.display = 'flex';

        window.descartarAvisoPerfil = function () {
          localStorage.setItem(CLAVE, String(Date.now()));
          band.style.display = 'none';
        };
      })();
    </script>
    <% } %>

    <section class="section">
      <% if (courses.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><span class="material-symbols-outlined">school</span></div>
          <% if (user.role === 'student') { %>
            <%
              /* Elegir el curso una sola vez — FUNCIÓN TEMPORAL (ver services/selfEnroll.js).
                 Con la automatrícula apagada la lista llega vacía y el alumno ve el texto de
                 siempre: pedir el alta por solicitud. */
              const cursosAuto = locals.autoMatricula || [];
              const escuelasAuto = [...new Set(cursosAuto.map(c => c.escuela))];
            %>
            <p><span class="badge-unmatriculated" style="font-size:13px;padding:4px 12px">(Sin Matricular)</span></p>
            <% if (cursosAuto.length) { %>
              <p style="margin-top:10px;color:var(--text-secondary);font-size:14px;max-width:460px">
                Todavía no estás en ninguna materia. Elegí tu curso y quedás inscripto en todas
                sus materias. <strong>Se elige una sola vez</strong>: si después no es el que te
                corresponde, el cambio lo hace el administrador.
              </p>
              <div id="autoMatriculaBox" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;align-items:center;margin-top:16px">
                <div class="input-group" style="margin-bottom:0;min-width:210px">
                  <span class="material-symbols-outlined input-icon">school</span>
                  <select id="autoMatriculaCurso" class="select-input">
                    <option value="">Elegí tu curso</option>
                    <% if (escuelasAuto.length > 1) { %>
                      <% escuelasAuto.forEach(esc => { %>
                        <optgroup label="<%= esc %>">
                          <% cursosAuto.filter(c => c.escuela === esc).forEach(c => { %>
                            <option value="<%= c._id %>"><%= c.name %></option>
                          <% }) %>
                        </optgroup>
                      <% }) %>
                    <% } else { %>
                      <% cursosAuto.forEach(c => { %>
                        <option value="<%= c._id %>"><%= c.name %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
                <button class="btn btn-primary" id="autoMatriculaBtn" onclick="confirmarAutoMatricula()">
                  <span class="material-symbols-outlined">how_to_reg</span>
                  Matricularme
                </button>
              </div>
              <div class="form-error" id="autoMatriculaError" style="margin-top:10px"></div>
              <p style="margin-top:14px;color:var(--text-secondary);font-size:12.5px">
                ¿No encontrás tu curso? Usá «Enviar solicitud para unirme» y te matricula el administrador.
              </p>
              <script>
                async function confirmarAutoMatricula() {
                  const sel   = document.getElementById('autoMatriculaCurso');
                  const btn   = document.getElementById('autoMatriculaBtn');
                  const error = document.getElementById('autoMatriculaError');
                  error.classList.remove('show');
                  error.textContent = '';

                  if (!sel.value) {
                    error.textContent = 'Elegí tu curso de la lista.';
                    error.classList.add('show');
                    return;
                  }
                  /* Se elige una sola vez y lo hace el propio alumno: vale preguntarle antes
                     de escribir, porque deshacerlo ya no está en sus manos. */
                  const curso = sel.options[sel.selectedIndex].text;
                  if (!confirm('Vas a quedar inscripto en todas las materias de ' + curso +
                               '. Después solo el administrador puede cambiarte. ¿Confirmás?')) return;

                  btn.disabled = true;
                  btn.innerHTML = '<span class="material-symbols-outlined">hourglass_top</span> Matriculando...';
                  try {
                    const res = await fetch('/courses/self-enroll', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ divisionId: sel.value }),
                    });
                    const data = await res.json();
                    if (!res.ok) {
                      error.textContent = data.error || 'No se pudo matricular.';
                      error.classList.add('show');
                      btn.disabled = false;
                      btn.innerHTML = '<span class="material-symbols-outlined">how_to_reg</span> Matricularme';
                      return;
                    }
                    window.location.reload(); // ya tiene materias: el panel se pinta con ellas
                  } catch {
                    error.textContent = 'Error de conexión. Intentá de nuevo.';
                    error.classList.add('show');
                    btn.disabled = false;
                    btn.innerHTML = '<span class="material-symbols-outlined">how_to_reg</span> Matricularme';
                  }
                }
              </script>
            <% } else { %>
              <p style="margin-top:10px;color:var(--text-secondary);font-size:14px">
                No estás matriculado en ningún curso. Usá el botón «Enviar solicitud para unirme» y el administrador te va a matricular.
              </p>
            <% } %>
          <% } else { %>
            <p>Aún no tenés clases. Creá una para empezar.</p>
          <% } %>
        </div>
      <% } %>
      <div class="course-grid">
        <% courses.forEach(course => { %>
          <%
            const subtitle = course.division?.name || '';
            const _h = course.header || {};
            const _defaultColor = course.isOwner ? '#1a73e8' : '#34a853';
            const _cardColor = _h.color || _defaultColor;
            let _bannerStyle = '';
            if (_h.image) {
              _bannerStyle = `background: linear-gradient(${_cardColor}bb,${_cardColor}bb), url('${_h.image}') center/cover no-repeat;`;
            } else if (_h.color && _h.color2) {
              _bannerStyle = `background: linear-gradient(135deg, ${_h.color}, ${_h.color2});`;
            }
          %>
          <a href="/courses/<%= course._id %>" class="course-card" style="--card-color: <%= _cardColor %>">
            <div class="card-banner"<% if (_bannerStyle) { %> style="<%= _bannerStyle %>"<% } %>>
              <div class="card-banner-content">
                <h4><%= course.name %></h4>
                <% if (subtitle) { %><p><%= subtitle %></p><% } %>
              </div>
              <div class="card-banner-deco">
                <span class="material-symbols-outlined"><%= course.isOwner ? 'school' : 'menu_book' %></span>
              </div>
            </div>
            <div class="card-body">
              <% if (course.isOwner) { %>
                <div class="card-stat">
                  <span class="material-symbols-outlined">group</span>
                  <span><%= course.students.length %> alumno<%= course.students.length !== 1 ? 's' : '' %></span>
                </div>
              <% } else { %>
                <div class="card-stat">
                  <div class="avatar" style="width:26px;height:26px;font-size:11px;background:#1a73e8"><%= course.owner.name.charAt(0).toUpperCase() %></div>
                  <span><%= course.owner.name %></span>
                </div>
              <% } %>
            </div>
            <div class="card-footer">
              <div class="card-footer-icons">
                <button class="icon-btn card-icon-btn" title="Novedades"
                  onclick="event.preventDefault();event.stopPropagation();window.location.href='/courses/<%= course._id %>'">
                  <span class="material-symbols-outlined">campaign</span>
                </button>
                <button class="icon-btn card-icon-btn" title="Actividades"
                  onclick="event.preventDefault();event.stopPropagation();window.location.href='/courses/<%= course._id %>'">
                  <span class="material-symbols-outlined">assignment</span>
                </button>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </main>

  <div class="modal-overlay" id="createModal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-header-left">
          <span class="material-symbols-outlined modal-header-icon">add_circle</span>
          <h3>Crear clase</h3>
        </div>
        <button class="icon-btn" onclick="hideCreateModal()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="warning-banner">
          <span class="material-symbols-outlined warning-icon">info</span>
          <span><strong>Aviso:</strong> Este es un clon con fines educativos.</span>
        </div>
        <form id="createForm">
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">badge</span>
            <input type="text" id="className" placeholder="Nombre de la materia (obligatorio)" required>
          </div>
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">class</span>
            <select id="divisionId" required style="flex:1;border:none;background:transparent;font-size:14px;color:var(--text-primary);outline:none;padding:0">
              <option value="">Cargando cursos...</option>
            </select>
          </div>
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">meeting_room</span>
            <input type="text" id="room" placeholder="Salón (opcional)">
          </div>
          <div class="form-error" id="createError"></div>
          <button type="submit" class="btn btn-primary btn-full">
            <span class="material-symbols-outlined">check</span>
            Crear
          </button>
        </form>
      </div>
    </div>
  </div>

  <%# Única vía del alumno para pedir el alta: junta DNI y nombre completo y los manda como
      una sugerencia común, que el superadmin ve en /superadmin/suggestions junto al resto.
      No matricula ni toca la base más que creando esa sugerencia. %>
  <div class="modal-overlay" id="requestModal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-header-left">
          <span class="material-symbols-outlined modal-header-icon">outgoing_mail</span>
          <h3>Enviar solicitud para unirme</h3>
        </div>
        <button class="icon-btn" onclick="hideRequestModal()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">Completá los datos del alumno. La solicitud le llega al administrador, que se encarga de matricularte.</p>
        <form id="requestForm">
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">badge</span>
            <input type="text" id="requestDni" placeholder="DNI del alumno" inputmode="numeric" autocomplete="off" required>
          </div>
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">person</span>
            <input type="text" id="requestName" placeholder="Nombre completo del alumno" autocomplete="off" required>
          </div>
          <div class="form-error" id="requestError"></div>
          <div class="form-success" id="requestOk"></div>
          <button type="submit" class="btn btn-primary btn-full">
            <span class="material-symbols-outlined">send</span>
            Enviar solicitud
          </button>
        </form>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
