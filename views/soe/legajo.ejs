<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= alumno.name %> — Orientación Escolar</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=block" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/soe-styles') %>
  <style>
    /* Cabecera de la ficha. La franja de color de arriba es la PRIORIDAD del legajo: el
       mismo dato que el chip, pero legible de un vistazo antes de leer una palabra. */
    .ficha { position: relative; overflow: hidden; }
    .ficha .franja { position: absolute; inset: 0 0 auto 0; height: 4px; }
    .ficha-cabecera { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
    .ficha-avatar {
      width: 60px; height: 60px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #0d7377, #14919b);
      color: #ffffff;                 /* fondo en hex ⇒ texto en hex */
      font-size: 26px; font-weight: 600; object-fit: cover;
      box-shadow: 0 2px 6px rgba(13, 115, 119, .28);
    }

    .anclas { display: flex; gap: 6px; flex-wrap: wrap; margin: 16px 0; }
    .anclas a {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 7px 14px; border-radius: 20px; font-size: 13px; font-weight: 500;
      text-decoration: none; color: var(--text-secondary);
      background: var(--surface); border: 1px solid var(--border);
      transition: color .12s ease, border-color .12s ease, transform .12s ease;
    }
    .anclas a .material-symbols-outlined { font-size: 16px; }
    .anclas a:hover { color: var(--primary); border-color: var(--primary); transform: translateY(-1px); }

    /* Indicadores de "Cómo viene". El color lo pone la vista según el propio número: no es
       un semáforo de riesgo, es el mismo dato pintado para que salte a la vista. */
    .indicadores { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
    .ind { position: relative; background: var(--bg); border-radius: var(--radius-sm); padding: 12px 14px; }
    .ind .n { font-size: 22px; font-weight: 700; }
    .ind .t { font-size: 11.5px; color: var(--text-secondary); margin-top: 2px; line-height: 1.35; }
    .ind .ico { position: absolute; top: 10px; right: 10px; font-size: 18px; color: var(--text-hint); opacity: .6; }
    .ind.bien   .n { color: #137333; }
    .ind.aviso  .n { color: #b06000; }
    .ind.alerta .n { color: #c5221f; }
    .ind .barra { height: 4px; border-radius: 2px; background: var(--border); margin-top: 9px; overflow: hidden; }
    .ind .barra > i { display: block; height: 100%; border-radius: 2px; background: var(--text-hint); }
    .ind.bien   .barra > i { background: #137333; }
    .ind.aviso  .barra > i { background: #ea8600; }
    .ind.alerta .barra > i { background: #ea4335; }

    /* Los tres colores de arriba están pensados para fondo claro: sobre --bg oscuro (#111418)
       el verde da 2:1 y el número deja de leerse. En oscuro van los tonos claros de la misma
       familia. Misma razón por la que la franja de prioridad —que sí viene en línea desde
       PRIORIDAD_COLORS— se levanta con un filtro en vez de con un color nuevo. */
    [data-theme="dark"] .ind.bien   .n { color: #81c995; }
    [data-theme="dark"] .ind.aviso  .n { color: #fdd663; }
    [data-theme="dark"] .ind.alerta .n { color: #f28b82; }
    [data-theme="dark"] .ind.bien   .barra > i { background: #81c995; }
    [data-theme="dark"] .ind.aviso  .barra > i { background: #fdd663; }
    [data-theme="dark"] .ind.alerta .barra > i { background: #f28b82; }
    [data-theme="dark"] .ficha .franja { filter: brightness(1.35); }

    .lectura { font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
    .lectura.vacia { color: var(--text-hint); font-style: italic; }
    .campo-lectura { margin-bottom: 16px; }
    .campo-lectura > label {
      display: block; font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .4px; color: var(--text-secondary); margin-bottom: 5px;
    }

    /* Lo que cargó el alumno en su propio perfil. Va en su propia caja para que se lea como
       lo que es: la voz del chico, no una observación del gabinete. */
    .perfil { margin-top: 18px; border-top: 1px solid var(--border); padding-top: 16px; }
    .perfil .rotulo {
      display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .4px; color: var(--text-secondary);
    }
    .perfil .rotulo .material-symbols-outlined { font-size: 16px; }
    .perfil .caja { background: var(--bg); border-radius: var(--radius-sm); padding: 14px 16px; }
    .perfil .meta { font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary); font-weight: 700; }
    .perfil .dato { font-size: 14px; line-height: 1.55; margin-top: 3px; word-break: break-word; }
    .perfil .sep { border-top: 1px solid var(--border); margin: 12px 0; }

    .red-fila { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
    .red-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 13px; border-radius: 20px; font-size: 13px; font-weight: 500;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); text-decoration: none;
    }
    .red-chip:hover { border-color: var(--primary); color: var(--primary); }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../partials/soe-nav', { activePage }) %>

    <a href="/soe" class="back-link" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--text-secondary);text-decoration:none;margin-bottom:12px">
      <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Volver al resumen
    </a>

    <div class="soe-panel ficha">
      <% if (legajo) { %>
        <div class="franja" style="background:<%= acceso.PRIORIDAD_COLORS[legajo.prioridad] %>"></div>
      <% } %>
      <div class="ficha-cabecera">
        <% if (alumno.avatar) { %>
          <img src="<%= alumno.avatar %>" alt="" class="ficha-avatar">
        <% } else { %>
          <div class="ficha-avatar"><%= (alumno.name || '?').trim().charAt(0).toUpperCase() %></div>
        <% } %>
        <div style="flex:1;min-width:200px">
          <h2 style="margin:0;font-size:22px"><%= alumno.name %></h2>
          <div style="font-size:12.5px;color:var(--text-secondary);margin-top:3px">
            <% if (alumno.dni) { %>DNI <%= alumno.dni %> · <% } %>
            <%= indicadores.cantidadMaterias %> materia<%= indicadores.cantidadMaterias === 1 ? '' : 's' %>
            <% if (alumno.lastSeen) { %> · última conexión <%= fmt.fechaCorta(alumno.lastSeen) %><% } %>
          </div>
          <% if (legajo) { %>
            <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
              <span class="chip chip-neutro">
                <span class="punto" style="background:<%= acceso.PRIORIDAD_COLORS[legajo.prioridad] %>"></span>
                Prioridad <%= acceso.PRIORIDAD_LABELS[legajo.prioridad].toLowerCase() %>
              </span>
              <span class="chip <%= legajo.estado === 'cerrado' ? 'chip-neutro' : 'chip-ok' %>">
                <%= acceso.ESTADO_LABELS[legajo.estado] %>
              </span>
              <% if (legajo.tieneDerivacionActiva) { %>
                <span class="chip chip-aviso">
                  <span class="material-symbols-outlined" style="font-size:13px">share</span> con derivación en curso
                </span>
              <% } %>
              <%# La fecha de repaso. En aviso mientras falta, en alerta cuando ya pasó: es
                  el mismo dato que pone al legajo en el panel del resumen. Solo llega hasta
                  acá en nivel completo, así que en resumen el chip no existe. %>
              <% if (legajo.proximoRepaso) { %>
                <% const vencido = acceso.legajoNecesitaRepaso(legajo); %>
                <span class="chip <%= vencido ? 'chip-alerta' : 'chip-aviso' %>">
                  <span class="material-symbols-outlined" style="font-size:13px">event_repeat</span>
                  <%= vencido ? 'Había que verlo el' : 'Volver a verlo el' %> <%= fmt.fechaCorta(legajo.proximoRepaso) %>
                </span>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

      <% if (!legajo) { %>
        <div style="border-top:1px solid var(--border);margin-top:14px;padding-top:14px">
          <% if (soeEscribe) { %>
            <h3 style="margin:0 0 4px;font-size:15px">Este alumno todavía no tiene legajo</h3>
            <p style="font-size:13px;color:var(--text-secondary);margin:0 0 14px;line-height:1.5">
              Abrirlo no le avisa a nadie: el alumno no ve nada de esta pantalla, y el resto
              del personal solo ve lo que la escuela haya habilitado.
            </p>
            <form method="POST" action="/soe/legajo/<%= alumno._id %>/abrir" class="soe-form">
              <div>
                <label for="motivo">Motivo de la intervención</label>
                <textarea id="motivo" name="motivo" maxlength="500" placeholder="Qué se observó, quién lo trajo, desde cuándo…"></textarea>
              </div>
              <div class="fila">
                <div>
                  <label for="prioridad">Prioridad</label>
                  <select id="prioridad" name="prioridad">
                    <% acceso.PRIORIDADES.forEach(p => { %>
                      <option value="<%= p %>" <%= p === 'media' ? 'selected' : '' %>><%= acceso.PRIORIDAD_LABELS[p] %></option>
                    <% }) %>
                  </select>
                </div>
                <div style="display:flex;align-items:flex-end">
                  <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">folder_open</span> Abrir legajo
                  </button>
                </div>
              </div>
            </form>
          <% } else { %>
            <div class="vacio" style="padding:20px 0">
              <span class="material-symbols-outlined">folder_off</span>
              Este alumno no tiene legajo abierto en Orientación Escolar.
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="anclas">
      <% if (legajo) { %>
        <a href="#situacion"><span class="material-symbols-outlined">assignment_ind</span> Situación</a>
      <% } %>
      <% if (legajo && nivel === 'completo') { %>
        <a href="#linea"><span class="material-symbols-outlined">timeline</span> Línea de tiempo</a>
        <a href="#derivaciones"><span class="material-symbols-outlined">share</span> Derivaciones</a>
      <% } %>
      <a href="#como-viene"><span class="material-symbols-outlined">insights</span> Cómo viene</a>
    </div>

    <%# ── Situación ──────────────────────────────────────────────────────── %>
    <% if (legajo) { %>
      <div class="soe-panel" id="situacion">
        <h3><span class="material-symbols-outlined">assignment_ind</span> Situación</h3>

        <% if (soeEscribe && legajo.estado !== 'cerrado') { %>
          <form method="POST" action="/soe/legajo/<%= legajo._id %>/situacion" class="soe-form">
            <div>
              <label for="s-motivo">Motivo de la intervención</label>
              <textarea id="s-motivo" name="motivo" maxlength="500"><%= legajo.motivo %></textarea>
            </div>
            <div>
              <label for="s-fortalezas">Fortalezas — con qué cuenta</label>
              <textarea id="s-fortalezas" name="fortalezas" maxlength="1000"><%= legajo.fortalezas %></textarea>
              <div class="ayuda">Lo que se le da bien, lo que lo engancha, quién lo sostiene. Este campo lo ven también los docentes si la escuela les dio acceso al resumen.</div>
            </div>
            <div>
              <label for="s-dificultades">Dificultades — qué le cuesta</label>
              <textarea id="s-dificultades" name="dificultades" maxlength="1000"><%= legajo.dificultades %></textarea>
            </div>
            <div>
              <label for="s-estrategias">Cómo contenerlo — estrategias acordadas</label>
              <textarea id="s-estrategias" name="estrategias" maxlength="2000"><%= legajo.estrategias %></textarea>
              <div class="ayuda">Qué hacer en el aula concretamente. Es la otra mitad de lo que ve el docente con acceso al resumen.</div>
            </div>
            <div class="fila">
              <div>
                <label for="s-prioridad">Prioridad</label>
                <select id="s-prioridad" name="prioridad">
                  <% acceso.PRIORIDADES.forEach(p => { %>
                    <option value="<%= p %>" <%= p === legajo.prioridad ? 'selected' : '' %>><%= acceso.PRIORIDAD_LABELS[p] %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label for="s-estado">Estado</label>
                <select id="s-estado" name="estado">
                  <option value="abierto"     <%= legajo.estado === 'abierto'     ? 'selected' : '' %>>Abierto</option>
                  <option value="seguimiento" <%= legajo.estado === 'seguimiento' ? 'selected' : '' %>>En seguimiento</option>
                </select>
              </div>
              <div>
                <label for="s-repaso">Volver a verlo el</label>
                <input type="date" id="s-repaso" name="proximoRepaso" value="<%= paraInput(legajo.proximoRepaso) %>">
                <div class="ayuda">Cuando la fecha pasa, el legajo aparece en el resumen. Vacío la borra.</div>
              </div>
              <div style="display:flex;align-items:flex-end">
                <button type="submit" class="btn btn-primary">
                  <span class="material-symbols-outlined">save</span> Guardar
                </button>
              </div>
            </div>
          </form>
        <% } else { %>
          <%# Lectura. En nivel 'resumen' motivo y dificultades ni siquiera llegan a la vista
              (los cortó services/soeAcceso.js), así que acá no hay nada que esconder. %>
          <% if (nivel === 'completo') { %>
            <div class="campo-lectura">
              <label>Motivo de la intervención</label>
              <div class="lectura <%= legajo.motivo ? '' : 'vacia' %>"><%= legajo.motivo || 'Sin registrar' %></div>
            </div>
          <% } %>
          <div class="campo-lectura">
            <label>Fortalezas</label>
            <div class="lectura <%= legajo.fortalezas ? '' : 'vacia' %>"><%= legajo.fortalezas || 'Sin registrar' %></div>
          </div>
          <% if (nivel === 'completo') { %>
            <div class="campo-lectura">
              <label>Dificultades</label>
              <div class="lectura <%= legajo.dificultades ? '' : 'vacia' %>"><%= legajo.dificultades || 'Sin registrar' %></div>
            </div>
          <% } %>
          <div class="campo-lectura">
            <label>Cómo contenerlo — estrategias acordadas</label>
            <div class="lectura <%= legajo.estrategias ? '' : 'vacia' %>"><%= legajo.estrategias || 'Sin registrar' %></div>
          </div>
        <% } %>

        <% if (nivel === 'completo' && soeEscribe) { %>
          <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:14px">
            <% if (legajo.estado === 'cerrado') { %>
              <div style="font-size:13px;color:var(--text-secondary);margin-bottom:10px;line-height:1.5">
                Cerrado el <%= fmt.fechaCorta(legajo.closedAt) %>.
                <% if (legajo.cierreMotivo) { %><br><em><%= legajo.cierreMotivo %></em><% } %>
              </div>
              <form method="POST" action="/soe/legajo/<%= legajo._id %>/reabrir">
                <button type="submit" class="btn btn-outline">
                  <span class="material-symbols-outlined">lock_open</span> Reabrir legajo
                </button>
              </form>
            <% } else { %>
              <form method="POST" action="/soe/legajo/<%= legajo._id %>/cerrar" class="soe-form">
                <div>
                  <label for="cierre">Cerrar el legajo</label>
                  <input type="text" id="cierre" name="cierreMotivo" maxlength="500" required
                         placeholder="Por qué se cierra (obligatorio)">
                  <div class="ayuda">No se borra nada: el seguimiento y las derivaciones quedan, y se puede reabrir.</div>
                </div>
                <div>
                  <button type="submit" class="btn btn-outline">
                    <span class="material-symbols-outlined">folder_off</span> Cerrar legajo
                  </button>
                </div>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>

    <%# ── Seguimiento ────────────────────────────────────────────────────── %>
    <% if (legajo && nivel === 'completo') { %>
      <div class="soe-panel" id="linea">
        <h3><span class="material-symbols-outlined">timeline</span> Línea de tiempo</h3>

        <% if (soeEscribe) { %>
          <form method="POST" action="/soe/legajo/<%= legajo._id %>/entrada" class="soe-form" style="margin-bottom:20px">
            <div class="fila">
              <div>
                <label for="e-fecha">Fecha del hecho</label>
                <input type="date" id="e-fecha" name="fecha" value="<%= paraInput(new Date()) %>">
                <div class="ayuda">La del encuentro, no la de hoy si lo estás anotando después.</div>
              </div>
              <div>
                <label for="e-tipo">Tipo</label>
                <select id="e-tipo" name="tipo">
                  <%# TIPOS_ENTRADA_MANUALES y NO TIPOS_ENTRADA: el enum del modelo acepta
                      ademas `derivacion`, que es el hito que escribe la bandeja de pedidos
                      firmado por el preceptor. Ofrecerlo aca dejaria fabricar a mano una
                      derivacion de Preceptoria que nunca existio. Ver la trampa del D3. %>
                  <% acceso.TIPOS_ENTRADA_MANUALES.forEach(t => { %>
                    <option value="<%= t %>" <%= t === 'entrevista' ? 'selected' : '' %>><%= acceso.TIPO_ENTRADA_LABELS[t] %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label for="e-animo">Cómo se lo vio</label>
                <select id="e-animo" name="animo">
                  <option value="">No corresponde</option>
                  <% acceso.ANIMOS.forEach(a => { %>
                    <option value="<%= a %>"><%= acceso.ANIMO_LABELS[a] %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <%# Acá se decide de verdad cuándo volver a verlo: recién termina la entrevista
                    y el gabinete sabe si hay que citarlo en dos semanas. Vacío NO borra la
                    fecha que ya tenga — para eso está el formulario de Situación. %>
                <label for="e-repaso">Volver a verlo el</label>
                <input type="date" id="e-repaso" name="proximoRepaso">
                <div class="ayuda">Opcional. En blanco deja la fecha que ya tenga el legajo.</div>
              </div>
            </div>
            <div>
              <label for="e-texto">Qué pasó</label>
              <textarea id="e-texto" name="texto" maxlength="4000" required placeholder="Lo que se habló, lo que se observó, lo que se acordó…"></textarea>
            </div>
            <div>
              <button type="submit" class="btn btn-primary">
                <span class="material-symbols-outlined">add</span> Agregar a la línea de tiempo
              </button>
            </div>
          </form>
        <% } %>

        <%# ── El hilo ──────────────────────────────────────────────────────────
            `linea` viene armada por services/soeLinea.js sobre el legajo YA SANITIZADO.
            La vista no decide qué entra: solo dibuja. Ver la decisión D6 de
            specs/soe-derivacion-y-linea-de-tiempo.spec.md. %>
        <% if (!linea.length) { %>
          <div class="vacio">
            <span class="material-symbols-outlined">timeline</span>
            Todavía no hay nada registrado en el legajo.
          </div>
        <% } else { %>
          <div class="linea-barra">
            <span class="cuenta">
              <%= linea.length %> <%= linea.length === 1 ? 'actuación registrada' : 'actuaciones registradas' %>
            </span>
            <%# El botón invierte el hilo del lado del navegador. El <noscript> de más abajo
                deja el mismo camino por query param para quien tenga JS apagado. %>
            <button type="button" class="btn-orden" id="btn-orden" aria-pressed="false"
                    aria-controls="hilo" title="Invertir el orden de la línea">
              <span class="material-symbols-outlined">swap_vert</span>
              <span id="btn-orden-txt">Lo último arriba</span>
            </button>
          </div>

          <ol class="linea" id="hilo">
            <% linea.forEach(h => { const autor = autores.get(String(h.autor)); %>
              <li class="hito-<%= h.tipo %>">
                <div class="hito-fecha">
                  <%= fmt.diaMes(h.fecha) %>
                  <span class="anio"><%= fmt.anio(h.fecha) %></span>
                </div>

                <%# El círculo toma el color de CÓMO SE LO VIO cuando el hito lo tiene; si no,
                    el del tipo de hito. Leída de arriba abajo, la columna de círculos es el
                    pulso del chico.
                    El color va por CLASE y no por `style=` con ANIMO_COLORS: un color inline
                    le gana a la variante de modo oscuro, y estos verdes/rojos sobre fondo
                    oscuro quedan ilegibles. La clase tiene su par en soe-styles.ejs. %>
                <div class="icono<%= h.animo ? ' animo-' + h.animo : '' %>">
                  <span class="material-symbols-outlined"><%= h.icono %></span>
                </div>

                <div class="cuerpo">
                  <div class="tarjeta">
                    <div class="hito-fecha-inline"><%= fmt.diaMesAnio(h.fecha) %></div>
                    <div class="hito-cab">
                      <span class="hito-titulo"><%= h.titulo %></span>
                      <% if (h.animo) { %>
                        <span class="chip chip-neutro">
                          <span class="punto" style="background:<%= acceso.ANIMO_COLORS[h.animo] %>"></span>
                          <%= acceso.ANIMO_LABELS[h.animo] %>
                        </span>
                      <% } %>
                      <% if (h.meta && h.tipo === 'derivacion') { %>
                        <span class="chip chip-neutro"><%= h.meta %></span>
                      <% } %>
                    </div>

                    <% if (h.texto) { %><div class="texto"><%= h.texto %></div><% } %>

                    <div class="meta">
                      <%= fmt.fechaCorta(h.fecha) %>
                      <% if (autor) { %> · <%= autor.name %><% } %>
                      <% if (h.meta && h.tipo === 'entrada') { %> · <%= h.meta %><% } %>
                      <%# La derivación y su devolución linkean al panel de gestión de abajo,
                          que es donde se les cambia el estado y se les carga la respuesta. %>
                      <% if (h.refId) { %>
                        · <a href="#deriv-<%= h.refId %>" style="color:var(--primary);text-decoration:none">ver la derivación</a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </li>
            <% }) %>
          </ol>

          <noscript>
            <div style="margin-top:10px">
              <a href="/soe/legajo/<%= alumno._id %>?orden=<%= orden === 'cronologico' ? 'reciente' : 'cronologico' %>#linea"
                 style="font-size:12.5px;color:var(--primary)">
                Ver <%= orden === 'cronologico' ? 'lo último arriba' : 'del comienzo al presente' %>
              </a>
            </div>
          </noscript>
        <% } %>
      </div>
    <% } %>

    <%# ── Derivaciones ───────────────────────────────────────────────────── %>
    <% if (legajo && nivel === 'completo') { %>
      <div class="soe-panel" id="derivaciones">
        <h3><span class="material-symbols-outlined">share</span> Derivaciones</h3>

        <% const derivaciones = (legajo.referrals || []).slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha)); %>
        <% if (!derivaciones.length) { %>
          <div class="vacio" style="padding:20px 0">
            <span class="material-symbols-outlined">share</span>
            No se lo derivó a ningún servicio externo.
          </div>
        <% } %>

        <% derivaciones.forEach(r => { const atencion = acceso.derivacionNecesitaAtencion(r); %>
          <div class="deriv <%= atencion ? 'atencion' : '' %>" id="deriv-<%= r._id %>">
            <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap">
              <div style="min-width:200px;flex:1">
                <h4><%= r.destino %></h4>
                <div style="font-size:12px;color:var(--text-secondary)">
                  <%= acceso.TIPO_DERIVACION_LABELS[r.tipo] %> · derivado el <%= fmt.fechaCorta(r.fecha) %>
                  <% if (r.contacto) { %> · <%= r.contacto %><% } %>
                </div>
              </div>
              <div>
                <span class="chip <%= atencion ? 'chip-alerta' : (acceso.DERIVACION_TERMINADA.includes(r.estado) ? 'chip-neutro' : 'chip-ok') %>">
                  <%= acceso.ESTADO_DERIVACION_LABELS[r.estado] %>
                </span>
              </div>
            </div>

            <% if (r.motivo) { %>
              <div class="lectura" style="margin-top:8px;font-size:13.5px"><%= r.motivo %></div>
            <% } %>

            <% if (r.proximoSeguimiento) { %>
              <div style="margin-top:8px;font-size:12.5px;color:<%= atencion ? '#c5221f' : 'var(--text-secondary)' %>">
                <span class="material-symbols-outlined" style="font-size:14px;vertical-align:-2px">event</span>
                Volver a preguntar el <%= fmt.fechaCorta(r.proximoSeguimiento) %>
              </div>
            <% } %>

            <% (r.devoluciones || []).slice().sort((a, b) => new Date(a.fecha) - new Date(b.fecha)).forEach(d => { %>
              <div class="devolucion">
                <div style="font-size:11px;color:var(--text-hint);margin-bottom:3px">
                  Devolución del <%= fmt.fechaCorta(d.fecha) %>
                </div>
                <%= d.texto %>
              </div>
            <% }) %>

            <% if (soeEscribe && legajo.estado !== 'cerrado') { %>
              <details style="margin-top:12px">
                <summary style="cursor:pointer;font-size:13px;color:var(--primary)">Registrar devolución o cambiar el estado</summary>
                <form method="POST" action="/soe/legajo/<%= legajo._id %>/derivacion/<%= r._id %>/devolucion" class="soe-form" style="margin-top:12px">
                  <div class="fila">
                    <div>
                      <label>Fecha de la devolución</label>
                      <input type="date" name="fecha" value="<%= paraInput(new Date()) %>">
                    </div>
                  </div>
                  <div>
                    <label>Qué dijeron</label>
                    <textarea name="texto" maxlength="2000" placeholder="Lo que informó el servicio: diagnóstico, tratamiento, sugerencias para la escuela…"></textarea>
                  </div>
                  <div><button type="submit" class="btn btn-primary">Guardar devolución</button></div>
                </form>
                <form method="POST" action="/soe/legajo/<%= legajo._id %>/derivacion/<%= r._id %>" class="soe-form" style="margin-top:14px;border-top:1px solid var(--border);padding-top:14px">
                  <div class="fila">
                    <div>
                      <label>Estado</label>
                      <select name="estado">
                        <% acceso.ESTADOS_DERIVACION.forEach(e => { %>
                          <option value="<%= e %>" <%= e === r.estado ? 'selected' : '' %>><%= acceso.ESTADO_DERIVACION_LABELS[e] %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div>
                      <label>Volver a preguntar el</label>
                      <input type="date" name="proximoSeguimiento" value="<%= paraInput(r.proximoSeguimiento) %>">
                    </div>
                    <div style="display:flex;align-items:flex-end">
                      <button type="submit" class="btn btn-outline">Actualizar</button>
                    </div>
                  </div>
                </form>
              </details>
            <% } %>
          </div>
        <% }) %>

        <% if (soeEscribe && legajo.estado !== 'cerrado') { %>
          <details style="margin-top:8px">
            <summary style="cursor:pointer;font-size:13.5px;font-weight:600;color:var(--primary)">+ Derivar a un servicio externo</summary>
            <form method="POST" action="/soe/legajo/<%= legajo._id %>/derivacion" class="soe-form" style="margin-top:14px">
              <div class="fila">
                <div>
                  <label for="d-destino">A dónde</label>
                  <input type="text" id="d-destino" name="destino" maxlength="200" required placeholder="Hospital Zonal — Salud Mental">
                </div>
                <div>
                  <label for="d-tipo">Tipo</label>
                  <select id="d-tipo" name="tipo">
                    <% acceso.TIPOS_DERIVACION.forEach(t => { %>
                      <option value="<%= t %>"><%= acceso.TIPO_DERIVACION_LABELS[t] %></option>
                    <% }) %>
                  </select>
                </div>
                <div>
                  <label for="d-contacto">Referente</label>
                  <input type="text" id="d-contacto" name="contacto" maxlength="200" placeholder="Con quién se habló">
                </div>
              </div>
              <div>
                <label for="d-motivo">Por qué se lo deriva</label>
                <textarea id="d-motivo" name="motivo" maxlength="1000"></textarea>
              </div>
              <div class="fila">
                <div>
                  <label for="d-fecha">Fecha de la derivación</label>
                  <input type="date" id="d-fecha" name="fecha" value="<%= paraInput(new Date()) %>">
                </div>
                <div>
                  <label for="d-prox">Volver a preguntar el</label>
                  <input type="date" id="d-prox" name="proximoSeguimiento">
                  <div class="ayuda">Pasada esta fecha sin devolución, la derivación aparece resaltada en el resumen.</div>
                </div>
                <div style="display:flex;align-items:flex-end">
                  <button type="submit" class="btn btn-primary">Registrar derivación</button>
                </div>
              </div>
            </form>
          </details>
        <% } %>
      </div>
    <% } %>

    <%# ── Cómo viene ─────────────────────────────────────────────────────── %>
    <div class="soe-panel" id="como-viene">
      <h3><span class="material-symbols-outlined">insights</span> Cómo viene</h3>
      <p style="font-size:12.5px;color:var(--text-hint);margin:-6px 0 14px;line-height:1.5">
        Datos que la plataforma ya tiene. No los carga nadie a mano y no arman ningún índice
        de riesgo: son los números, el juicio es tuyo.
      </p>

      <%
        // El color de cada indicador sale del propio número, no de ninguna fórmula de riesgo:
        // es el mismo dato pintado para que salte a la vista. Los cortes son los que ya usa la
        // escuela para hablar (85% de asistencia, 6 de nota).
        //
        // Sin días cargados la asistencia da 0% por definición, y pintar eso de rojo diría
        // "faltó a todo" cuando lo que pasa es que nadie tomó lista. Ese caso va sin color.
        const _dias   = (a) => a.presentes + a.tarde + a.ausentes + a.justificados;
        const _colorA = (a) => (!_dias(a) ? '' : a.porcentaje >= 90 ? 'bien' : a.porcentaje >= 85 ? 'aviso' : 'alerta');
        const _a30    = indicadores.asistencia.ultimos30;
        const _aCiclo = indicadores.asistencia.ciclo;
        const _prom   = indicadores.promedioGeneral;
        const _colorP = _prom === null ? '' : (_prom >= 7 ? 'bien' : _prom >= 6 ? 'aviso' : 'alerta');
        const _pend   = indicadores.entregas.pendientes;
        const _colorE = !_pend ? 'bien' : (indicadores.entregas.pendientesVencidas ? 'alerta' : 'aviso');
        const _ancho  = (n) => Math.max(0, Math.min(100, Number(n) || 0));
      %>
      <div class="indicadores" style="margin-bottom:18px">
        <div class="ind <%= _colorA(_a30) %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">event_available</span>
          <div class="n"><%= _a30.porcentaje %>%</div>
          <div class="t">Asistencia, últimos <%= indicadores.asistencia.ventana %> días</div>
          <div class="barra"><i style="width:<%= _ancho(_a30.porcentaje) %>%"></i></div>
        </div>
        <div class="ind <%= _colorA(_aCiclo) %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">calendar_month</span>
          <div class="n"><%= _aCiclo.porcentaje %>%</div>
          <div class="t">Asistencia del ciclo (<%= _aCiclo.ausentes %> faltas)</div>
          <div class="barra"><i style="width:<%= _ancho(_aCiclo.porcentaje) %>%"></i></div>
        </div>
        <div class="ind <%= _colorP %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">grade</span>
          <div class="n"><%= _prom === null ? '—' : _prom %></div>
          <div class="t">Promedio general sobre 10</div>
          <% if (_prom !== null) { %>
            <div class="barra"><i style="width:<%= _ancho(_prom * 10) %>%"></i></div>
          <% } %>
        </div>
        <div class="ind <%= _colorE %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">assignment_late</span>
          <div class="n"><%= _pend %></div>
          <div class="t">Actividades sin entregar (<%= indicadores.entregas.pendientesVencidas %> vencidas)</div>
        </div>
      </div>

      <% if (indicadores.materias.length) { %>
        <div class="tabla-scroll">
          <table class="soe-tabla">
            <thead>
              <tr><th>Materia</th><th>Promedio</th><th>Notas</th><th>Entregadas</th><th>Tarde</th><th>Pendientes</th></tr>
            </thead>
            <tbody>
              <% indicadores.materias.forEach(m => { %>
                <tr>
                  <td><%= m.nombre %></td>
                  <td>
                    <% if (m.promedio === null) { %>—<% } else { %>
                      <span class="chip <%= m.promedio < 6 ? 'chip-alerta' : 'chip-ok' %>"><%= m.promedio %></span>
                    <% } %>
                  </td>
                  <td><%= m.notas %></td>
                  <td><%= m.entregadas %></td>
                  <td><%= m.tardias || '—' %></td>
                  <td><%= m.pendientes || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="vacio" style="padding:20px 0">
          <span class="material-symbols-outlined">menu_book</span>
          El alumno no está inscripto en ninguna materia.
        </div>
      <% } %>

      <%
        // Lo que cargó el alumno en su propio perfil. Las REDES van aparte y SOLO en nivel
        // completo: la bio, los intereses y el proyecto son lo que el chico eligió contar de
        // sí mismo dentro de la escuela, pero un usuario de Instagram es su identidad real
        // fuera de ella. El nivel 'resumen' existe justamente para no repartir eso.
        const _redes = [];
        if (alumno.instagram) {
          _redes.push({ label: '@' + alumno.instagram, url: 'https://instagram.com/' + alumno.instagram,
                        icono: 'photo_camera', color: '#e1306c' });
        }
        if (alumno.facebook) {
          _redes.push({ label: 'Facebook', url: 'https://facebook.com/' + alumno.facebook,
                        icono: 'group', color: '#1877f2' });
        }
        const _verRedes  = nivel === 'completo' && _redes.length > 0;
        const _hayPerfil = alumno.futureGoal || alumno.bio || (alumno.interests || []).length || _verRedes;
      %>
      <% if (_hayPerfil) { %>
        <div class="perfil">
          <div class="rotulo">
            <span class="material-symbols-outlined">badge</span>
            Lo que cargó el alumno en su perfil
          </div>
          <div class="caja">
            <% if (alumno.futureGoal) { %>
              <div class="meta">A qué le gustaría dedicarse</div>
              <div class="dato"><%= alumno.futureGoal %></div>
            <% } %>

            <% if (alumno.bio) { %>
              <% if (alumno.futureGoal) { %><div class="sep"></div><% } %>
              <div class="meta">Su presentación</div>
              <div class="dato"><%= alumno.bio %></div>
            <% } %>

            <% if ((alumno.interests || []).length) { %>
              <% if (alumno.futureGoal || alumno.bio) { %><div class="sep"></div><% } %>
              <div class="meta">Le interesa</div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:7px">
                <% alumno.interests.forEach(i => { %>
                  <span class="chip chip-neutro">
                    <span class="material-symbols-outlined" style="font-size:13px"><%= INTEREST_ICONS[i] || 'star' %></span>
                    <%= INTEREST_LABELS[i] || i %>
                  </span>
                <% }) %>
              </div>
            <% } %>

            <% if (_verRedes) { %>
              <% if (alumno.futureGoal || alumno.bio || (alumno.interests || []).length) { %><div class="sep"></div><% } %>
              <div class="meta">Redes que dejó en su perfil</div>
              <% _redes.forEach(r => { %>
                <div class="red-fila">
                  <a class="red-chip" href="<%= r.url %>" target="_blank" rel="noopener noreferrer">
                    <span class="material-symbols-outlined" style="font-size:16px;color:<%= r.color %>"><%= r.icono %></span>
                    <%= r.label %>
                  </a>
                  <%# Analizar con IA: todavía no existe, así que el botón va apagado. La pista
                      cuelga del <span> y NO del <button>: un control deshabilitado no dispara
                      eventos de mouse, ni siquiera para mostrar su propio `title`. %>
                  <span class="pista" tabindex="0"
                        title="La implementación de la IA todavía no se encuentra disponible."
                        data-pista="La implementación de la IA todavía no se encuentra disponible.">
                    <button type="button" class="btn-ia" disabled aria-disabled="true">
                      <span class="material-symbols-outlined" style="font-size:14px">auto_awesome</span>
                      Analizar
                    </button>
                  </span>
                  <div class="pista-nota">La implementación de la IA todavía no se encuentra disponible.</div>
                </div>
              <% }) %>
              <div style="font-size:11.5px;color:var(--text-hint);margin-top:9px;line-height:1.45">
                El enlace abre el perfil público y nada más: la plataforma no lo sigue, no lo
                guarda y no lo lee.
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // El orden de la línea de tiempo.
    //
    // Por defecto lo último arriba: para el trabajo diario importa la última actuación.
    // Invertido se lee como historia, del comienzo al presente. La inversión es CSS pura
    // (`flex-direction: column-reverse`) — no se reordena el DOM ni se vuelve al servidor,
    // así que no se pierde el scroll ni un formulario a medio llenar.
    //
    // El hilo que une los hitos está dibujado sobre el CONTENEDOR y no sobre cada ítem,
    // justamente para que sobreviva a esto (ver views/partials/soe-styles.ejs).
    (function () {
      var hilo  = document.getElementById('hilo');
      var boton = document.getElementById('btn-orden');
      var texto = document.getElementById('btn-orden-txt');
      if (!hilo || !boton) return;

      var CLAVE = 'soe:orden-linea';
      // Cómo lo mandó el servidor. Si vino por query param ya está en el orden pedido y la
      // preferencia guardada no tiene que volver a darlo vuelta.
      var ordenServidor = '<%= orden %>';

      // localStorage puede tirar excepción, no solo devolver null: en una ventana privada o
      // con el almacenamiento del sitio bloqueado, el acceso mismo falla. Envuelto, porque
      // la lista tiene que dibujarse igual — en el orden por defecto.
      function leer() {
        try { return localStorage.getItem(CLAVE); } catch (e) { return null; }
      }
      function guardar(v) {
        try { localStorage.setItem(CLAVE, v); } catch (e) { /* sin persistencia, y ya */ }
      }

      function pintar(cronologico) {
        hilo.classList.toggle('invertida', cronologico !== (ordenServidor === 'cronologico'));
        boton.setAttribute('aria-pressed', cronologico ? 'true' : 'false');
        texto.textContent = cronologico ? 'Del comienzo al presente' : 'Lo último arriba';
      }

      var guardado = leer();
      var cronologico = guardado ? guardado === 'cronologico' : ordenServidor === 'cronologico';
      pintar(cronologico);

      boton.addEventListener('click', function () {
        cronologico = !cronologico;
        guardar(cronologico ? 'cronologico' : 'reciente');
        pintar(cronologico);
      });
    })();
  </script>
</body>
</html>
