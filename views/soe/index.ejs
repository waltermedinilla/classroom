<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resumen — Orientación Escolar</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/soe-styles') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content main-content-ancho">
    <%- include('../partials/soe-nav', { activePage }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Orientación Escolar</h2>
        <div style="font-size:12.5px;color:var(--text-secondary);margin-top:2px">
          <% if (scopeAll) { %>Todos los cursos de la escuela<% } else { %>Los cursos que tenés asignados<% } %>
        </div>
      </div>
      <% if (soeEscribe) { %>
        <a href="/soe/alumnos" class="btn btn-primary">
          <span class="material-symbols-outlined">person_search</span> Buscar un alumno
        </a>
      <% } %>
    </div>

    <%# Los íconos son decorativos: el número y su rótulo ya dicen todo. Van con aria-hidden
        para que un lector de pantalla no lea "carpeta abierta" antes de cada cifra. %>
    <div class="soe-cards">
      <div class="soe-card">
        <span class="material-symbols-outlined ico" aria-hidden="true">folder_open</span>
        <div class="n"><%= totales.activos %></div>
        <div class="t">Legajos activos</div>
      </div>
      <div class="soe-card">
        <span class="material-symbols-outlined ico" aria-hidden="true">timeline</span>
        <div class="n"><%= totales.seguimiento %></div>
        <div class="t">En seguimiento</div>
      </div>
      <div class="soe-card">
        <span class="material-symbols-outlined ico" aria-hidden="true">share</span>
        <div class="n"><%= totales.derivacionesActivas %></div>
        <div class="t">Con derivación en curso</div>
      </div>
      <%# Solo con acceso completo: en nivel resumen estos números siempre serían 0 (la ruta
          ni arma las listas) y mentirían por omisión. %>
      <% if (totales.veDerivaciones) { %>
        <div class="soe-card <%= totales.atencion ? 'alerta' : '' %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">priority_high</span>
          <div class="n"><%= totales.atencion %></div>
          <div class="t">Derivaciones que piden atención</div>
        </div>
        <div class="soe-card <%= totales.repasos ? 'alerta' : '' %>">
          <span class="material-symbols-outlined ico" aria-hidden="true">event_repeat</span>
          <div class="n"><%= totales.repasos %></div>
          <div class="t">Para volver a ver</div>
        </div>
        <%# Los pedidos de Preceptoría sin resolver. Es el aviso de la feature: el rol `soe`
            aterriza en esta pantalla, así que es acá donde tiene que enterarse de que alguien
            le derivó un chico. Solo el número — el motivo es una observación sobre un menor y
            se lee en /soe/pedidos, no en una tarjeta de resumen. %>
        <a href="/soe/pedidos" class="soe-card <%= totales.pedidos ? 'alerta' : '' %>" style="text-decoration:none;color:inherit">
          <span class="material-symbols-outlined ico" aria-hidden="true">move_to_inbox</span>
          <div class="n"><%= totales.pedidos %></div>
          <div class="t">Pedidos de Preceptoría</div>
        </a>
      <% } %>
    </div>

    <% if (pendientes.length || repasos.length) { %>
      <%# Lo primero de la pantalla, antes que los legajos. Dos listas en un solo panel
          porque son el mismo problema: el hueco entre "se lo derivó" y "el lugar nunca
          contestó", y el chico al que se acompaña sin derivar y se enfría en silencio. %>
      <div class="soe-panel">
        <h3><span class="material-symbols-outlined" style="color:#ea4335">priority_high</span> Necesitan que alguien pregunte</h3>

        <% if (pendientes.length) { %>
          <% if (repasos.length) { %>
            <div class="sub-lista">Derivaciones sin novedad</div>
          <% } %>
          <div class="tabla-scroll">
            <table class="soe-tabla">
              <thead>
                <tr><th>Alumno</th><th>Derivado a</th><th>Estado</th><th>Desde</th><th>Volver a preguntar</th></tr>
              </thead>
              <tbody>
                <% pendientes.forEach(p => { %>
                  <tr>
                    <td><a href="/soe/legajo/<%= p.legajo.student._id %>"><%= p.legajo.student.name %></a></td>
                    <td><%= p.referral.destino %></td>
                    <td>
                      <span class="chip <%= acceso.ESTADOS_DERIVACION_ALERTA.includes(p.referral.estado) ? 'chip-alerta' : 'chip-aviso' %>">
                        <%= acceso.ESTADO_DERIVACION_LABELS[p.referral.estado] %>
                      </span>
                    </td>
                    <td><%= fmt.fechaCorta(p.referral.fecha) %></td>
                    <td>
                      <% if (p.referral.proximoSeguimiento) { %>
                        <span class="chip chip-alerta"><%= fmt.fechaCorta(p.referral.proximoSeguimiento) %></span>
                      <% } else { %>—<% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (repasos.length) { %>
          <%# El repaso vencido de un legajo. No dice por qué hay que volver a verlo —eso está
              en el legajo—, dice que la fecha que puso el gabinete ya pasó. %>
          <div class="sub-lista" style="<%= pendientes.length ? 'margin-top:18px' : '' %>">Para volver a ver</div>
          <div class="tabla-scroll">
            <table class="soe-tabla">
              <thead>
                <tr><th>Alumno</th><th>Curso</th><th>Prioridad</th><th>Última novedad</th><th>Había que verlo</th></tr>
              </thead>
              <tbody>
                <% repasos.forEach(r => { %>
                  <tr>
                    <td><a href="/soe/legajo/<%= r.student._id %>"><%= r.student.name %></a></td>
                    <td><%= r.division ? r.division.name : '—' %></td>
                    <td>
                      <span class="chip chip-neutro">
                        <span class="punto" style="background:<%= acceso.PRIORIDAD_COLORS[r.prioridad] %>"></span>
                        <%= acceso.PRIORIDAD_LABELS[r.prioridad] %>
                      </span>
                    </td>
                    <td><%= r.lastEntryAt ? fmt.fechaCorta(r.lastEntryAt) : '—' %></td>
                    <td><span class="chip chip-alerta"><%= fmt.fechaCorta(r.proximoRepaso) %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="soe-panel">
      <h3><span class="material-symbols-outlined">folder_open</span> Legajos activos</h3>
      <% if (!legajos.length) { %>
        <div class="vacio">
          <span class="material-symbols-outlined">psychology</span>
          Todavía no hay legajos abiertos.
          <% if (soeEscribe) { %>
            <div style="margin-top:12px">
              <a href="/soe/alumnos" class="btn btn-outline">Buscar un alumno</a>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="tabla-scroll">
          <table class="soe-tabla">
            <thead>
              <tr><th>Alumno</th><th>Curso</th><th>Prioridad</th><th>Estado</th><th>Última novedad</th></tr>
            </thead>
            <tbody>
              <% legajos.forEach(l => { %>
                <tr>
                  <td>
                    <a href="/soe/legajo/<%= l.student._id %>"><%= l.student.name %></a>
                    <%# El booleano ya viene resuelto por el sanitizado: en nivel resumen el
                        array de derivaciones no llega hasta acá, y este chip es justamente
                        todo lo que ese nivel puede saber de ellas. %>
                    <% if (l.tieneDerivacionActiva) { %>
                      <span class="chip chip-neutro" style="margin-left:6px">
                        <span class="material-symbols-outlined" style="font-size:12px">share</span> derivado
                      </span>
                    <% } %>
                  </td>
                  <td><%= l.division ? l.division.name : '—' %></td>
                  <td>
                    <span class="chip chip-neutro">
                      <span class="punto" style="background:<%= acceso.PRIORIDAD_COLORS[l.prioridad] %>"></span>
                      <%= acceso.PRIORIDAD_LABELS[l.prioridad] %>
                    </span>
                  </td>
                  <td><%= acceso.ESTADO_LABELS[l.estado] %></td>
                  <td><%= l.lastEntryAt ? fmt.fechaCorta(l.lastEntryAt) : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <% if (cerrados) { %>
        <div style="margin-top:12px;font-size:12px;color:var(--text-hint)">
          Además hay <strong><%= cerrados %></strong> legajo<%= cerrados === 1 ? '' : 's' %> cerrado<%= cerrados === 1 ? '' : 's' %>.
          Se siguen viendo desde la ficha del alumno.
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
