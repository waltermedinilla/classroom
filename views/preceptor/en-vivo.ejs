    preceptor es quien controla la asistencia, y su trabajo es que se note que está mirando. %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>En vivo — Preceptoría</title>
  <%- include('../partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <%- include('../partials/preceptor-nav', { activePage: 'envivo' }) %>
    <%- include('../partials/live-cards') %>
  </main>

  <%# El footer no es decorativo: define toggleDrawer(), logout(), el tema y carga
      nav-responsive.js. Sin él, TODOS los botones del header de esta página quedan muertos.
      Faltaba desde que se creó el panel. %>
  <%- include('../partials/footer') %>
</body>
</html>
