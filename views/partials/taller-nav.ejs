<%# Panel Taller (specs/jefe-de-taller.spec.md). Cada solapa depende de can(), como el resto.
    "Actividades" y "Docentes (MEP)" son las pantallas de /jefatura con el alcance de talleres. %>
<% const puede = (k) => (typeof can === 'function' ? can(k) : true);
   const esJefeTaller = typeof user !== 'undefined' && user && user.role === 'jefetaller'; %>
<nav class="admin-nav">
  <% if (puede('taller_resumen')) { %>
  <a href="/taller" class="admin-nav-item <%= activePage === 'resumen' ? 'active' : '' %>">
    <span class="material-symbols-outlined">construction</span>
    Resumen del día
  </a>
  <% } %>
  <% if (puede('taller_docentes')) { %>
  <a href="/taller/docentes" class="admin-nav-item <%= activePage === 'docentes' ? 'active' : '' %>">
    <span class="material-symbols-outlined">fact_check</span>
    Control de MEP
  </a>
  <% } %>
  <% if (esJefeTaller && puede('jefe_dashboard')) { %>
  <a href="/jefatura" class="admin-nav-item">
    <span class="material-symbols-outlined">assignment</span>
    Actividades
  </a>
  <% } %>
  <% if (esJefeTaller && puede('jefe_teachers')) { %>
  <a href="/jefatura/docentes" class="admin-nav-item">
    <span class="material-symbols-outlined">badge</span>
    Docentes (MEP)
  </a>
  <% } %>
  <% if (puede('taller_secciones')) { %>
  <a href="/taller/secciones" class="admin-nav-item <%= activePage === 'secciones' ? 'active' : '' %>">
    <span class="material-symbols-outlined">account_tree</span>
    Secciones
  </a>
  <% } %>
  <% if (puede('taller_jefes')) { %>
  <a href="/taller/jefes" class="admin-nav-item <%= activePage === 'jefes' ? 'active' : '' %>">
    <span class="material-symbols-outlined">groups</span>
    Jefes y MEP
  </a>
  <% } %>
  <% if (puede('taller_horario')) { %>
  <a href="/taller/horario" class="admin-nav-item <%= activePage === 'horario' ? 'active' : '' %>">
    <span class="material-symbols-outlined">calendar_view_week</span>
    Horarios
  </a>
  <% } %>
  <% if (puede('taller_rotacion')) { %>
  <a href="/taller/rotacion" class="admin-nav-item <%= activePage === 'rotacion' ? 'active' : '' %>">
    <span class="material-symbols-outlined">autorenew</span>
    Rotación
  </a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && ['jefetaller', 'admin', 'superadmin'].includes(user.role) && puede('taller_materias')) { %>
  <a href="/taller/materias" class="admin-nav-item <%= activePage === 'materias' ? 'active' : '' %>">
    <span class="material-symbols-outlined">checklist</span>
    Materias de taller
  </a>
  <% } %>
</nav>
