<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Docentes — Panel Directivo</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0..200&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Colores de la columna anclada (ver `.nombre-fijo` en style.css): el encabezado y el
       hover de esta tabla son var(--bg), no el default var(--surface). */
    .teachers-table {
      width: 100%; border-collapse: collapse; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
      --celda-fija-bg-head: var(--bg); --celda-fija-bg-hover: var(--bg);
    }
    .teachers-table th, .teachers-table td {
      padding: 10px 14px; text-align: left; font-size: 13px;
      border-bottom: 1px solid var(--border);
    }
    .teachers-table th {
      background: var(--bg); font-weight: 600; font-size: 11px;
      text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary);
    }
    .teachers-table tr:last-child td { border-bottom: none; }
    .teachers-table tr:hover td { background: var(--bg); }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; }
    .badge-red { background: #fce8e6; color: #c5221f; }
    .badge-warn { background: #fef4e5; color: #e67e00; }
    .badge-ok { background: #e6f4ea; color: #137333; }
    a.name-link { color: var(--text-primary); text-decoration: none; font-weight: 500; }
    a.name-link:hover { color: var(--primary); text-decoration: underline; }
    .empty-state {
      text-align: center; padding: 40px; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius); color: var(--text-secondary);
    }

    /* Sparkline de la serie mensual. Barras CSS puras — el proyecto no usa librerías
       de charting; mismo enfoque que .bucket-bar en grades.ejs y .rate-bar-fill en courses.ejs */
    .spark { display: flex; align-items: flex-end; gap: 3px; height: 30px; }
    .spark-bar {
      width: 7px; background: var(--primary); border-radius: 2px 2px 0 0;
      /* min-height para que un mes en cero se lea como "no hubo actividad" y no como
         un hueco de renderizado. Sin esto, una fila vacía parece un bug. */
      min-height: 2px; opacity: .85; transition: opacity .15s;
    }
    .spark-bar.cero { background: var(--border); }
    .spark:hover .spark-bar { opacity: 1; }
    .spark-wrap { display: flex; align-items: center; gap: 8px; justify-content: center; }
    .trend { font-size: 18px; line-height: 1; }
    .trend-sube    { color: #137333; }
    .trend-baja    { color: #c5221f; }
    .trend-estable { color: var(--text-hint); }
    .trend-sin     { color: var(--border); }
    .spark-labels {
      display: flex; gap: 3px; margin-top: 3px;
      font-size: 8px; color: var(--text-hint); text-transform: uppercase;
    }
    .spark-labels span { width: 7px; text-align: center; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <%- include('../partials/directivo-nav', { activePage: 'teachers' }) %>

    <div class="dashboard-topbar">
      <div>
        <h2>Docentes</h2>
        <p style="color:var(--text-secondary);font-size:14px;margin-top:4px">
          Actividad publicada, entregas pendientes de calificación y evolución de los últimos
          <%= meses.length %> meses
        </p>
      </div>
    </div>

    <form method="GET" class="filters-bar">
      <input type="search" name="search" placeholder="Buscar docente por nombre..." value="<%= search %>">
      <select name="sort">
        <option value="overdue-desc" <%= sort === 'overdue-desc' ? 'selected' : '' %>>Más entregas sin calificar primero</option>
        <option value="acts-asc"     <%= sort === 'acts-asc'     ? 'selected' : '' %>>Menos actividad reciente primero</option>
        <option value="acts-desc"    <%= sort === 'acts-desc'    ? 'selected' : '' %>>Más actividad reciente primero</option>
        <option value="name"         <%= sort === 'name'         ? 'selected' : '' %>>Nombre (A→Z)</option>
      </select>
      <button type="submit" class="btn btn-outline">
        <span class="material-symbols-outlined">filter_alt</span>
        Aplicar
      </button>
    </form>

    <div style="font-size:12px;color:var(--text-hint);margin-bottom:8px">
      <% if (total === 0) { %>
        Sin resultados
      <% } else { %>
        Mostrando <%= (page - 1) * 25 + 1 %>–<%= Math.min(page * 25, total) %> de <strong><%= total %></strong> docente<%= total === 1 ? '' : 's' %>
      <% } %>
    </div>

    <% if (!teachers.length) { %>
      <div class="empty-state">
        <span class="material-symbols-outlined" style="font-size:36px;color:var(--text-hint)">badge</span>
        <% if (search) { %>
          <p>Ningún docente coincide con "<strong><%= search %></strong>".</p>
          <a href="/directivo/teachers" class="btn btn-outline" style="margin-top:8px">Limpiar búsqueda</a>
        <% } else { %>
          <p>No hay docentes registrados en esta escuela.</p>
        <% } %>
      </div>
    <% } else { %>
      <div style="overflow-x:auto">
        <table class="teachers-table nombre-fijo">
          <thead>
            <tr>
              <th>Docente</th>
              <th style="text-align:center">Cursos</th>
              <th style="text-align:center">Alumnos</th>
              <th style="text-align:center" title="<%= mesesLabel.join(' · ') %>">
                Actividades por mes
                <div style="font-weight:400;text-transform:none;letter-spacing:0;font-size:9px">
                  <%= mesesLabel[0] %> → <%= mesesLabel[mesesLabel.length - 1] %>
                </div>
              </th>
              <th style="text-align:center">Sin calificar (&gt;15d)</th>
              <th style="text-align:center">Promedio de notas</th>
            </tr>
          </thead>
          <tbody>
            <% teachers.forEach(t => { %>
              <tr>
                <td>
                  <a href="/directivo/teachers/<%= t._id %>" class="name-link"><%= t.name %></a>
                  <% if (t.active === false) { %><span class="badge badge-red" style="margin-left:4px">Deshabilitado</span><% } %>
                  <div style="font-size:11px;color:var(--text-hint)"><%= t.email %></div>
                </td>
                <td style="text-align:center"><%= t.courseCount %></td>
                <td style="text-align:center"><%= t.studentCount %></td>
                <td>
                  <%
                    // Escala relativa a la propia fila: interesa la FORMA de la serie del
                    // docente, no compararlo con el más productivo de la escuela (que
                    // aplastaría visualmente a todos los demás).
                    const maxFila = Math.max(...t.serieActs, 1);
                  %>
                  <div class="spark-wrap">
                    <div>
                      <div class="spark">
                        <% t.serieActs.forEach((v, i) => { %>
                          <div class="spark-bar <%= v === 0 ? 'cero' : '' %>"
                            style="height:<%= v === 0 ? 2 : Math.max(3, Math.round((v / maxFila) * 30)) %>px"
                            title="<%= mesesLabel[i] %>: <%= v %> actividad<%= v === 1 ? '' : 'es' %> · <%= t.serieCorr[i] %> <%= t.serieCorr[i] === 1 ? 'corrección' : 'correcciones' %>"></div>
                        <% }) %>
                      </div>
                      <div class="spark-labels">
                        <% mesesLabel.forEach(m => { %><span><%= m.charAt(0) %></span><% }) %>
                      </div>
                    </div>
                    <span class="material-symbols-outlined trend trend-<%= t.tendencia === 'sin-datos' ? 'sin' : t.tendencia %>"
                      title="<%= t.tendencia === 'sube' ? 'En aumento' : t.tendencia === 'baja' ? 'En descenso' : t.tendencia === 'estable' ? 'Estable' : 'Sin actividad en el período' %>">
                      <%= t.tendencia === 'sube' ? 'trending_up' : t.tendencia === 'baja' ? 'trending_down' : t.tendencia === 'estable' ? 'trending_flat' : 'remove' %>
                    </span>
                  </div>
                </td>
                <td style="text-align:center">
                  <% if (t.overdueActs > 0) { %>
                    <span class="badge badge-warn"><%= t.overdueActs %></span>
                  <% } else { %>
                    <span class="badge badge-ok">0</span>
                  <% } %>
                </td>
                <td style="text-align:center">
                  <% if (t.avg === null) { %>
                    <span style="color:var(--text-hint)">—</span>
                  <% } else { %>
                    <strong style="color:<%= t.avg < 6 ? '#ea4335' : t.avg < 8 ? '#ea8600' : '#34a853' %>"><%= t.avg %></strong>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
