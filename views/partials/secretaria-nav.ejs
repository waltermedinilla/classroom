<%# Nav del panel de la Secretaria. secretaria_dia está locked en config/sections.js (es el
    destino del redirect de "/"), así que ese if siempre da true: va por simetría con los
    otros paneles, por si mañana se suma una solapa configurable. %>
<% const puede = (k) => (typeof can === 'function' ? can(k) : true); %>
<nav class="admin-nav">
  <% if (puede('secretaria_dia')) { %>
  <a href="/secretaria" class="admin-nav-item <%= activePage === 'dia' ? 'active' : '' %>">
    <span class="material-symbols-outlined">event_note</span>
    Docentes del día
  </a>
  <% } %>
  <% if (puede('secretaria_curso')) { %>
  <a href="/secretaria/curso" class="admin-nav-item <%= activePage === 'curso' ? 'active' : '' %>">
    <span class="material-symbols-outlined">grid_view</span>
    Horario del curso
  </a>
  <% } %>
  <%# El horario oficial cuelga de la misma solapa que "Horario del curso" (no es una sección nueva). %>
  <% if (puede('secretaria_curso')) { %>
  <a href="/secretaria/oficial" class="admin-nav-item <%= activePage === 'oficial' ? 'active' : '' %>">
    <span class="material-symbols-outlined">fact_check</span>
    Horario oficial
  </a>
  <% } %>
  <% if (puede('secretaria_horario')) { %>
  <a href="/secretaria/horario" class="admin-nav-item <%= activePage === 'horario' ? 'active' : '' %>">
    <span class="material-symbols-outlined">calendar_view_week</span>
    Horario de materias
  </a>
  <% } %>
</nav>
