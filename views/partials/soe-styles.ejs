<%# Estilos compartidos por las cuatro pantallas de /soe. Una sola vez, como en
    partials/jefatura-styles.ejs: nacieron juntas y tienen que verse iguales.

    Móvil: las tablas van SIEMPRE adentro de .tabla-scroll (overflow-x propio) y las grillas
    colapsan a una columna en <700px. Son dos de los patrones de la revisión móvil que no
    hay que reintroducir. %>
<style>
  .soe-lectura {
    display: flex; gap: 10px; align-items: flex-start;
    background: var(--primary-light); color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 10px 14px; margin-bottom: 16px; font-size: 13px; line-height: 1.5;
  }
  .soe-lectura .material-symbols-outlined { font-size: 20px; color: var(--primary); flex-shrink: 0; }

  .soe-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .soe-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px 16px;
  }
  .soe-card .n { font-size: 26px; font-weight: 700; line-height: 1.1; }
  .soe-card .t { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
  .soe-card.alerta { border-color: #ea4335; }
  .soe-card.alerta .n { color: #ea4335; }

  .soe-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px; margin-bottom: 18px;
  }
  .soe-panel > h3 {
    margin: 0 0 14px; font-size: 14px; text-transform: uppercase;
    letter-spacing: .4px; color: var(--text-secondary);
    display: flex; align-items: center; gap: 8px;
  }

  /* Rótulo de una lista adentro de un panel que tiene más de una (el resumen apila las
     derivaciones sin novedad y los repasos vencidos bajo el mismo título). */
  .sub-lista {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
    color: var(--text-secondary); margin-bottom: 8px;
  }

  .tabla-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .soe-tabla { width: 100%; border-collapse: collapse; min-width: 520px; }
  .soe-tabla th, .soe-tabla td {
    padding: 10px 12px; text-align: left; font-size: 13.5px;
    border-bottom: 1px solid var(--border); vertical-align: top;
  }
  .soe-tabla th {
    background: var(--bg); font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary); white-space: nowrap;
  }
  .soe-tabla tr:last-child td { border-bottom: none; }
  .soe-tabla a { color: var(--text); text-decoration: none; font-weight: 500; }
  .soe-tabla a:hover { color: var(--primary); text-decoration: underline; }

  .chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px; border-radius: 11px; font-size: 11px;
    font-weight: 600; letter-spacing: .2px; white-space: nowrap;
  }
  .chip .punto { width: 7px; height: 7px; border-radius: 50%; }
  .chip-neutro { background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border); }
  .chip-alerta { background: #fce8e6; color: #c5221f; }
  .chip-ok     { background: #e6f4ea; color: #137333; }
  .chip-aviso  { background: #fef4e5; color: #b06000; }

  .soe-form { display: grid; gap: 12px; }
  .soe-form label { display: block; font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px; }
  .soe-form input[type=text], .soe-form input[type=date], .soe-form select, .soe-form textarea {
    width: 100%; padding: 9px 12px; border: 1px solid var(--border);
    border-radius: var(--radius-sm); font-size: 14px; font-family: inherit;
    background: var(--surface); color: var(--text); box-sizing: border-box;
  }
  .soe-form textarea { min-height: 84px; resize: vertical; line-height: 1.5; }
  .soe-form .fila { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .soe-form .ayuda { font-size: 11.5px; color: var(--text-hint); margin-top: 3px; line-height: 1.45; }

  /* La línea de tiempo del seguimiento */
  .linea { list-style: none; margin: 0; padding: 0; }
  .linea li { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .linea li:last-child { border-bottom: none; }
  .linea .icono {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg); border: 1px solid var(--border);
  }
  .linea .icono .material-symbols-outlined { font-size: 18px; color: var(--text-secondary); }
  .linea .cuerpo { flex: 1; min-width: 0; }
  .linea .meta { font-size: 11.5px; color: var(--text-hint); margin-top: 4px; }
  .linea .texto { font-size: 14px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }

  .deriv { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; margin-bottom: 12px; }
  .deriv.atencion { border-color: #ea4335; background: #fce8e610; }
  .deriv h4 { margin: 0 0 4px; font-size: 15px; }
  .deriv .devolucion {
    border-left: 3px solid var(--primary); padding: 8px 12px; margin-top: 10px;
    background: var(--bg); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 13.5px; line-height: 1.5; white-space: pre-wrap;
  }

  .vacio { text-align: center; padding: 34px 16px; color: var(--text-hint); font-size: 14px; }
  .vacio .material-symbols-outlined { font-size: 40px; display: block; margin-bottom: 8px; }

  @media (max-width: 700px) {
    .soe-panel { padding: 14px; }
    .soe-cards { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
    .soe-card .n { font-size: 22px; }
  }

  /* ── El hilo de la línea de tiempo ──────────────────────────────────────────
     Une los hitos entre sí para que el seguimiento se lea como un recorrido y no
     como cuatro notas sueltas. Arranca donde termina el círculo (padding 14 + 34)
     y muere en el último, que no tiene a quién unirse. */
  .linea li { position: relative; }
  .linea li::before {
    content: ''; position: absolute; left: 17px; top: 48px; bottom: 0;
    width: 2px; background: var(--border); border-radius: 1px;
  }
  .linea li:last-child::before { display: none; }
  .linea .icono { transition: transform .12s ease; }
  .linea li:hover .icono { transform: scale(1.06); }

  /* El círculo pintado según CÓMO SE LO VIO. Los ids son los de acceso.ANIMOS; un ánimo
     nuevo sin su regla acá simplemente sale sin tinte, no rompe nada.
     Los tonos oscuros son para fondo claro: sobre --bg oscuro no se leen, así que el modo
     oscuro los levanta. Por eso el color NO puede ir inline desde la vista. */
  .linea .icono.animo-bien        { border-color: #137333; background: #13733314; }
  .linea .icono.animo-altibajos   { border-color: #ea8600; background: #ea860014; }
  .linea .icono.animo-preocupante { border-color: #ea4335; background: #ea433514; }
  .linea .icono.animo-bien        .material-symbols-outlined { color: #137333; }
  .linea .icono.animo-altibajos   .material-symbols-outlined { color: #b06000; }
  .linea .icono.animo-preocupante .material-symbols-outlined { color: #c5221f; }

  [data-theme="dark"] .linea .icono.animo-bien        { border-color: #81c995; }
  [data-theme="dark"] .linea .icono.animo-altibajos   { border-color: #fdd663; }
  [data-theme="dark"] .linea .icono.animo-preocupante { border-color: #f28b82; }
  [data-theme="dark"] .linea .icono.animo-bien        .material-symbols-outlined { color: #81c995; }
  [data-theme="dark"] .linea .icono.animo-altibajos   .material-symbols-outlined { color: #fdd663; }
  [data-theme="dark"] .linea .icono.animo-preocupante .material-symbols-outlined { color: #f28b82; }

  /* ── Pista al pasar el mouse ────────────────────────────────────────────────
     Va en el CONTENEDOR, nunca en el control: un `<button disabled>` no recibe
     eventos de mouse (Chrome los descarta), así que ni el atributo `title` ni un
     `:hover` propio llegan a dispararse. El envoltorio va con tabindex para que también
     aparezca al llegar con el teclado (en móvil no flota: ver el bloque de abajo). */
  .pista { position: relative; display: inline-flex; }
  .pista:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 18px; }
  .pista::after {
    content: attr(data-pista);
    position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%);
    background: #202124; color: #ffffff;   /* fondo en hex ⇒ el texto también, o se pierde en oscuro */
    padding: 7px 10px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,.28);
    font-size: 11.5px; font-weight: 500; line-height: 1.4;
    width: max-content; max-width: 230px; text-align: center; white-space: normal;
    opacity: 0; visibility: hidden; transition: opacity .13s ease;
    pointer-events: none; z-index: 30;
  }
  .pista::before {
    content: ''; position: absolute; bottom: calc(100% + 3px); left: 50%;
    transform: translateX(-50%); border: 6px solid transparent; border-top-color: #202124;
    opacity: 0; visibility: hidden; transition: opacity .13s ease; z-index: 30;
  }
  .pista:hover::after, .pista:hover::before,
  .pista:focus::after, .pista:focus::before { opacity: 1; visibility: visible; }

  /* Acción de IA que todavía no existe. Se dibuja apagada y con el borde punteado a
     propósito: que se vea dónde va a estar es la mitad del punto. */
  .btn-ia {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 12px; border-radius: 16px;
    border: 1px dashed var(--border); background: var(--bg);
    color: var(--text-secondary); font-family: inherit;
    font-size: 11.5px; font-weight: 600; letter-spacing: .2px;
    cursor: not-allowed;
  }

  /* Ícono de fondo de las tarjetas del resumen. Decorativo: aria-hidden en el marcado. */
  .soe-card { position: relative; overflow: hidden; }
  .soe-card .ico {
    position: absolute; top: 12px; right: 12px;
    font-size: 20px; color: var(--text-hint); opacity: .6;
  }
  .soe-card.alerta .ico { color: #ea4335; opacity: .9; }
  .soe-card .n, .soe-card .t { position: relative; }

  /* En un teléfono no hay mouse que pasar, y una burbuja flotante cerca del borde queda
     recortada (el body lleva overflow-x:hidden, así que ni se puede arrastrar para verla).
     Bajo 700 px la pista deja de flotar y se lee como una nota debajo del botón. */
  .pista-nota { display: none; }
  @media (max-width: 700px) {
    .pista::after, .pista::before { display: none; }
    .pista-nota {
      display: block; flex-basis: 100%;
      font-size: 11px; line-height: 1.4; color: var(--text-hint); margin-top: 2px;
    }
  }
</style>
