<%# Estilos compartidos por las cuatro pantallas de /soe. Una sola vez, como en
    partials/jefatura-styles.ejs: nacieron juntas y tienen que verse iguales.

    Móvil: las tablas van SIEMPRE adentro de .tabla-scroll (overflow-x propio) y las grillas
    colapsan a una columna en <700px. Son dos de los patrones de la revisión móvil que no
    hay que reintroducir. %>
<style>
  .soe-lectura {
    display: flex; gap: 10px; align-items: flex-start;
    background: var(--primary-light); color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 10px 14px; margin-bottom: 16px; font-size: 13px; line-height: 1.5;
  }
  .soe-lectura .material-symbols-outlined { font-size: 20px; color: var(--primary); flex-shrink: 0; }

  .soe-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .soe-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px 16px;
  }
  .soe-card .n { font-size: 26px; font-weight: 700; line-height: 1.1; }
  .soe-card .t { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
  .soe-card.alerta { border-color: #ea4335; }
  .soe-card.alerta .n { color: #ea4335; }

  .soe-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px; margin-bottom: 18px;
  }
  .soe-panel > h3 {
    margin: 0 0 14px; font-size: 14px; text-transform: uppercase;
    letter-spacing: .4px; color: var(--text-secondary);
    display: flex; align-items: center; gap: 8px;
  }

  /* Rótulo de una lista adentro de un panel que tiene más de una (el resumen apila las
     derivaciones sin novedad y los repasos vencidos bajo el mismo título). */
  .sub-lista {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
    color: var(--text-secondary); margin-bottom: 8px;
  }

  .tabla-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .soe-tabla { width: 100%; border-collapse: collapse; min-width: 520px; }
  .soe-tabla th, .soe-tabla td {
    padding: 10px 12px; text-align: left; font-size: 13.5px;
    border-bottom: 1px solid var(--border); vertical-align: top;
  }
  .soe-tabla th {
    background: var(--bg); font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: .4px; color: var(--text-secondary); white-space: nowrap;
  }
  .soe-tabla tr:last-child td { border-bottom: none; }
  .soe-tabla a { color: var(--text); text-decoration: none; font-weight: 500; }
  .soe-tabla a:hover { color: var(--primary); text-decoration: underline; }

  .chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px; border-radius: 11px; font-size: 11px;
    font-weight: 600; letter-spacing: .2px; white-space: nowrap;
  }
  .chip .punto { width: 7px; height: 7px; border-radius: 50%; }
  .chip-neutro { background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border); }
  .chip-alerta { background: #fce8e6; color: #c5221f; }
  .chip-ok     { background: #e6f4ea; color: #137333; }
  .chip-aviso  { background: #fef4e5; color: #b06000; }

  .soe-form { display: grid; gap: 12px; }
  .soe-form label { display: block; font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px; }
  .soe-form input[type=text], .soe-form input[type=date], .soe-form select, .soe-form textarea {
    width: 100%; padding: 9px 12px; border: 1px solid var(--border);
    border-radius: var(--radius-sm); font-size: 14px; font-family: inherit;
    background: var(--surface); color: var(--text); box-sizing: border-box;
  }
  .soe-form textarea { min-height: 84px; resize: vertical; line-height: 1.5; }
  .soe-form .fila { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .soe-form .ayuda { font-size: 11.5px; color: var(--text-hint); margin-top: 3px; line-height: 1.45; }

  /* ── La línea de tiempo del legajo ─────────────────────────────────────────
     Un solo hilo con TODAS las actuaciones del gabinete: la apertura, las entradas
     del seguimiento, las derivaciones, las devoluciones de los servicios y el
     cierre. Antes eran dos listas que no se cruzaban y no se veía el recorrido.

     Tres columnas: la fecha, el círculo sobre el hilo, y la tarjeta del hito.
     El ancho de la primera y el diámetro del círculo son los que fijan dónde cae
     el hilo (ver .linea::before más abajo): si se tocan, se toca también ese left. */
  .linea { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; }
  .linea li {
    display: grid; grid-template-columns: 56px 34px 1fr; gap: 12px;
    align-items: start; padding: 10px 0; position: relative;
  }

  /* La fecha, afuera de la tarjeta, como en la referencia visual. Dos renglones para
     que el año no empuje el ancho de la columna. */
  .linea .hito-fecha {
    text-align: right; padding-top: 7px; line-height: 1.25;
    font-size: 12.5px; font-weight: 600; color: var(--text-secondary);
  }
  .linea .hito-fecha .anio { display: block; font-size: 11px; font-weight: 500; color: var(--text-hint); }
  /* El gemelo que aparece solo en pantallas chicas, cuando la columna se pliega. */
  .linea .hito-fecha-inline { display: none; font-size: 11.5px; color: var(--text-hint); margin-bottom: 3px; }

  .linea .icono {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg); border: 1px solid var(--border);
    /* Por encima del hilo, que pasa por atrás del centro del círculo. */
    position: relative; z-index: 1;
  }
  .linea .icono .material-symbols-outlined { font-size: 18px; color: var(--text-secondary); }
  .linea .cuerpo { min-width: 0; }
  /* --text-secondary y no --text-hint: este renglón lleva la fecha y quién firmó el hito,
     que es información y no decoración. Sobre el fondo de la tarjeta, hint da 2,39:1 en modo
     claro (por debajo del 4,5:1 que pide la pauta); secondary da 5,47:1 en claro y 9,21:1 en
     oscuro. Medido en el navegador el 2026-08-27. */
  .linea .meta { font-size: 11.5px; color: var(--text-secondary); margin-top: 4px; }
  .linea .texto { font-size: 14px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }

  /* La tarjeta del hito.
     ⚠️ El fondo es var(--bg) y NO un pastel como el de la referencia visual. Un fondo
     saturado en hex obliga a declarar su color de texto también en hex, y el par que
     se lee en claro da 1,10:1 en oscuro (ya pasó en la sala en vivo). Acá el color
     del tipo de hito entra por el BORDE y por el círculo, que no llevan texto encima,
     y el texto sigue en los tokens del tema: legible en los dos modos sin duplicar
     una sola declaración. */
  .linea .tarjeta {
    background: var(--bg); border-radius: var(--radius-sm);
    border-left: 4px solid var(--acento, var(--border));
    padding: 11px 14px;
  }
  .linea .hito-titulo { font-size: 13.5px; font-weight: 600; }
  .linea .hito-cab { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 5px; }

  /* El acento por tipo de hito. Es una variable y no un color suelto para que el borde
     de la tarjeta y el círculo no se puedan desincronizar. */
  .linea li.hito-apertura   { --acento: #1a73e8; }
  .linea li.hito-entrada    { --acento: #0d7377; }
  .linea li.hito-derivacion { --acento: #9334e6; }
  .linea li.hito-devolucion { --acento: #188038; }
  .linea li.hito-cierre     { --acento: #5f6368; }
  .linea li .icono { border-color: var(--acento, var(--border)); }
  .linea li .icono .material-symbols-outlined { color: var(--acento, var(--text-secondary)); }

  /* Los cinco acentos están elegidos para fondo claro. Sobre --bg oscuro pierden
     contraste, así que el modo oscuro levanta la misma familia — misma razón por la
     que el color no puede ir inline desde la vista. */
  [data-theme="dark"] .linea li.hito-apertura   { --acento: #8ab4f8; }
  [data-theme="dark"] .linea li.hito-entrada    { --acento: #4db6bb; }
  [data-theme="dark"] .linea li.hito-derivacion { --acento: #d7aefb; }
  [data-theme="dark"] .linea li.hito-devolucion { --acento: #81c995; }
  [data-theme="dark"] .linea li.hito-cierre     { --acento: #9aa0a6; }

  /* La barra de arriba del hilo: cuántos hitos hay y el botón que invierte el orden. */
  .linea-barra { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
  .linea-barra .cuenta { font-size: 12.5px; color: var(--text-secondary); }
  .btn-orden {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 6px 12px; border-radius: 20px; font-size: 12.5px; font-weight: 500;
    background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
    cursor: pointer; font-family: inherit;
  }
  .btn-orden:hover { color: var(--primary); border-color: var(--primary); }
  .btn-orden .material-symbols-outlined { font-size: 16px; }

  .deriv { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; margin-bottom: 12px; }
  .deriv.atencion { border-color: #ea4335; background: #fce8e610; }
  .deriv h4 { margin: 0 0 4px; font-size: 15px; }
  .deriv .devolucion {
    border-left: 3px solid var(--primary); padding: 8px 12px; margin-top: 10px;
    background: var(--bg); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 13.5px; line-height: 1.5; white-space: pre-wrap;
  }

  .vacio { text-align: center; padding: 34px 16px; color: var(--text-hint); font-size: 14px; }
  .vacio .material-symbols-outlined { font-size: 40px; display: block; margin-bottom: 8px; }

  @media (max-width: 700px) {
    .soe-panel { padding: 14px; }
    .soe-cards { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
    .soe-card .n { font-size: 22px; }

    /* La columna de fecha se pliega: en 360px de ancho, 56px de fecha + 34 de círculo
       dejan la tarjeta en nada y el texto largo empuja el ancho del body (que tiene
       overflow-x:hidden y lo recortaría en silencio). La fecha pasa adentro de la
       tarjeta, arriba del título. */
    .linea li { grid-template-columns: 28px 1fr; gap: 10px; }
    .linea .hito-fecha { display: none; }
    .linea .hito-fecha-inline { display: block; }
    .linea .icono { width: 28px; height: 28px; }
    .linea .icono .material-symbols-outlined { font-size: 15px; }
    .linea .tarjeta { padding: 10px 12px; }
    /* ⚠️ El hilo NO se recoloca acá: su regla base está más abajo en este mismo archivo y,
       con la misma especificidad, la que gana es la última del documento — una media query
       no suma especificidad. El override vive pegado a la regla base. */
  }

  /* ── El hilo ────────────────────────────────────────────────────────────────
     Une los hitos entre sí para que el legajo se lea como un recorrido y no como
     ocho notas sueltas.

     Cada ítem dibuja el tramo que va de SU círculo al del vecino de abajo. No un hilo
     único sobre el contenedor: ese tendría que terminar en el centro del último
     círculo, y desde el contenedor ese punto no se puede expresar — la última tarjeta
     es más alta que su círculo, así que un `bottom` fijo deja el hilo colgando por
     debajo del último hito (unos 80px con una entrada larga).

     Los números: `left` es el centro de la columna del círculo — 56 (fecha) + 12 (gap)
     + 17 (medio círculo) = 85. `top: 27` es el centro del círculo dentro del ítem —
     10 (padding) + 17. Y `bottom: -27` estira el tramo 27px DENTRO del ítem siguiente,
     que es donde cae el centro del próximo círculo (los ítems no tienen gap entre sí).
     Si cambia el ancho de la fecha, el diámetro del círculo o el padding, cambia acá.

     ⚠️ Y ACÁ ESTÁ LA TRAMPA DE LA INVERSIÓN. La geometría de arriba funciona igual con
     la lista dada vuelta —"27px más abajo" sigue cayendo en el centro del círculo
     vecino, que ahora es el ítem anterior del DOM—, pero cambia CUÁL es el ítem que no
     tiene a nadie abajo: en orden normal es el último del DOM, y con
     `column-reverse` es el PRIMERO. Sin las dos reglas de abajo, el hilo queda colgando
     de un extremo apenas se toca el botón de orden. */
  .linea li::before {
    content: ''; position: absolute; left: 85px; top: 27px; bottom: -27px;
    width: 2px; background: var(--border); border-radius: 1px;
  }
  .linea li:last-child::before { display: none; }

  /* La inversión, sin recargar la página. */
  .linea.invertida { flex-direction: column-reverse; }
  .linea.invertida li:last-child::before  { display: block; }
  .linea.invertida li:first-child::before { display: none; }

  /* El hilo en pantalla chica. Va acá, inmediatamente después de la regla base y no en el
     bloque de móvil de más arriba: con la misma especificidad gana la última regla del
     documento, y una media query no cambia eso. Ahí arriba quedaba sin efecto.
     Los números: círculo de 28 ⇒ centro en 14 (left) y en 10 (padding) + 14 = 24 (top). */
  @media (max-width: 700px) {
    .linea li::before { left: 14px; top: 24px; bottom: -24px; }
  }

  .linea .icono { transition: transform .12s ease; }
  .linea li:hover .icono { transform: scale(1.06); }

  /* El círculo pintado según CÓMO SE LO VIO. Los ids son los de acceso.ANIMOS; un ánimo
     nuevo sin su regla acá simplemente sale sin tinte, no rompe nada.
     Los tonos oscuros son para fondo claro: sobre --bg oscuro no se leen, así que el modo
     oscuro los levanta. Por eso el color NO puede ir inline desde la vista. */
  .linea .icono.animo-bien        { border-color: #137333; background: #13733314; }
  .linea .icono.animo-altibajos   { border-color: #ea8600; background: #ea860014; }
  .linea .icono.animo-preocupante { border-color: #ea4335; background: #ea433514; }
  .linea .icono.animo-bien        .material-symbols-outlined { color: #137333; }
  .linea .icono.animo-altibajos   .material-symbols-outlined { color: #b06000; }
  .linea .icono.animo-preocupante .material-symbols-outlined { color: #c5221f; }

  [data-theme="dark"] .linea .icono.animo-bien        { border-color: #81c995; }
  [data-theme="dark"] .linea .icono.animo-altibajos   { border-color: #fdd663; }
  [data-theme="dark"] .linea .icono.animo-preocupante { border-color: #f28b82; }
  [data-theme="dark"] .linea .icono.animo-bien        .material-symbols-outlined { color: #81c995; }
  [data-theme="dark"] .linea .icono.animo-altibajos   .material-symbols-outlined { color: #fdd663; }
  [data-theme="dark"] .linea .icono.animo-preocupante .material-symbols-outlined { color: #f28b82; }

  /* ── Pista al pasar el mouse ────────────────────────────────────────────────
     Va en el CONTENEDOR, nunca en el control: un `<button disabled>` no recibe
     eventos de mouse (Chrome los descarta), así que ni el atributo `title` ni un
     `:hover` propio llegan a dispararse. El envoltorio va con tabindex para que también
     aparezca al llegar con el teclado (en móvil no flota: ver el bloque de abajo). */
  .pista { position: relative; display: inline-flex; }
  .pista:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 18px; }
  .pista::after {
    content: attr(data-pista);
    position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%);
    background: #202124; color: #ffffff;   /* fondo en hex ⇒ el texto también, o se pierde en oscuro */
    padding: 7px 10px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,.28);
    font-size: 11.5px; font-weight: 500; line-height: 1.4;
    width: max-content; max-width: 230px; text-align: center; white-space: normal;
    opacity: 0; visibility: hidden; transition: opacity .13s ease;
    pointer-events: none; z-index: 30;
  }
  .pista::before {
    content: ''; position: absolute; bottom: calc(100% + 3px); left: 50%;
    transform: translateX(-50%); border: 6px solid transparent; border-top-color: #202124;
    opacity: 0; visibility: hidden; transition: opacity .13s ease; z-index: 30;
  }
  .pista:hover::after, .pista:hover::before,
  .pista:focus::after, .pista:focus::before { opacity: 1; visibility: visible; }

  /* Acción de IA que todavía no existe. Se dibuja apagada y con el borde punteado a
     propósito: que se vea dónde va a estar es la mitad del punto. */
  .btn-ia {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 12px; border-radius: 16px;
    border: 1px dashed var(--border); background: var(--bg);
    color: var(--text-secondary); font-family: inherit;
    font-size: 11.5px; font-weight: 600; letter-spacing: .2px;
    cursor: not-allowed;
  }

  /* Ícono de fondo de las tarjetas del resumen. Decorativo: aria-hidden en el marcado. */
  .soe-card { position: relative; overflow: hidden; }
  .soe-card .ico {
    position: absolute; top: 12px; right: 12px;
    font-size: 20px; color: var(--text-hint); opacity: .6;
  }
  .soe-card.alerta .ico { color: #ea4335; opacity: .9; }
  .soe-card .n, .soe-card .t { position: relative; }

  /* En un teléfono no hay mouse que pasar, y una burbuja flotante cerca del borde queda
     recortada (el body lleva overflow-x:hidden, así que ni se puede arrastrar para verla).
     Bajo 700 px la pista deja de flotar y se lee como una nota debajo del botón. */
  .pista-nota { display: none; }
  @media (max-width: 700px) {
    .pista::after, .pista::before { display: none; }
    .pista-nota {
      display: block; flex-basis: 100%;
      font-size: 11px; line-height: 1.4; color: var(--text-hint); margin-top: 2px;
    }
  }

  /* ── Avisos del formulario ──────────────────────────────────────────────────
     El cartel de "ese archivo no entró". Aparece arriba de la ficha después de un
     redirect, que es como guardan todos los formularios de este panel. */
  .soe-aviso {
    display: flex; gap: 10px; align-items: flex-start;
    border-radius: var(--radius-sm); padding: 11px 14px; margin-bottom: 16px;
    font-size: 13px; line-height: 1.5;
    background: #fef4e5; color: #7a4100; border: 1px solid #f2c98a;
  }
  .soe-aviso .material-symbols-outlined { font-size: 20px; flex-shrink: 0; }
  /* El par de arriba está pensado para fondo claro y da 1,3:1 en oscuro. Como el fondo va en
     hex, el texto tiene que ir en hex también — y por eso el modo oscuro redeclara los tres. */
  [data-theme="dark"] .soe-aviso { background: #3a2c12; color: #fdd663; border-color: #6b5220; }

  /* ── Material: archivos y enlaces ───────────────────────────────────────────
     El certificado, la receta, el informe. Se dibujan como una fila con el ícono de la
     categoría a la izquierda, para que se puedan barrer con la vista buscando "el
     certificado" sin leer ningún título. */
  .adj-lista { display: flex; flex-direction: column; gap: 8px; }
  .adj {
    display: flex; gap: 10px; align-items: flex-start;
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 10px 12px; background: var(--bg);
  }
  .adj .ico {
    width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--surface); border: 1px solid var(--border);
  }
  .adj .ico .material-symbols-outlined { font-size: 18px; color: var(--primary); }
  .adj .cuerpo { min-width: 0; flex: 1; }
  .adj .titulo {
    font-size: 13.5px; font-weight: 600; color: var(--text);
    text-decoration: none; word-break: break-word;
  }
  a.titulo:hover { color: var(--primary); text-decoration: underline; }
  /* --text-secondary y no --text-hint: este renglón dice quién firmó el papel y de cuándo es,
     que es información y no adorno. Misma medición que la meta de la línea de tiempo. */
  .adj .meta { font-size: 11.5px; color: var(--text-secondary); margin-top: 3px; line-height: 1.45; }
  .adj .nota { font-size: 12.5px; color: var(--text); margin-top: 5px; line-height: 1.5; white-space: pre-wrap; }
  .adj .acciones { flex-shrink: 0; }
  .adj-baja {
    background: none; border: none; padding: 4px; cursor: pointer;
    color: var(--text-secondary); line-height: 0; border-radius: 50%;
  }
  .adj-baja:hover { color: #c5221f; background: var(--surface); }
  [data-theme="dark"] .adj-baja:hover { color: #f28b82; }
  .adj-baja .material-symbols-outlined { font-size: 17px; }

  /* Dado de baja: el registro queda, el archivo no. Se ve apagado y tachado, que es
     exactamente lo que pasó — no desaparece, para que el legajo siga siendo completo. */
  .adj.baja { opacity: .6; }
  .adj.baja .titulo { text-decoration: line-through; }
  .adj.baja .ico .material-symbols-outlined { color: var(--text-secondary); }

  /* Los papeles colgados de un hito de la línea de tiempo: más chicos, en fila. */
  .adj-hito { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  .adj-chip {
    display: inline-flex; align-items: center; gap: 5px; max-width: 100%;
    padding: 4px 10px; border-radius: 14px; font-size: 11.5px; font-weight: 500;
    background: var(--surface); border: 1px solid var(--border);
    color: var(--text); text-decoration: none;
  }
  .adj-chip:hover { border-color: var(--primary); color: var(--primary); }
  .adj-chip .material-symbols-outlined { font-size: 14px; flex-shrink: 0; }
  .adj-chip span.txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .adj-chip.baja { opacity: .55; text-decoration: line-through; pointer-events: none; }

  /* ── El azul de los desplegables ────────────────────────────────────────────
     ⚠️ `--primary` (#1a73e8) vale LO MISMO en los dos temas, y sobre el fondo oscuro de una
     tarjeta (#1e2124) da **3,59:1** — por debajo del 4,5:1 que pide la pauta. Medido en el
     navegador el 2026-08-30. Es la misma familia de problema que documenta la memoria del
     contraste de los grises, entrando por el color de marca.
     `--primary-dark` sería todavía peor: el tema oscuro necesita el tono CLARO de la familia,
     que es el mismo #8ab4f8 que ya usa el acento de los hitos de apertura más arriba.

     Va como CLASE y no como `style=` inline en cada <summary>, y esa es la única forma de que
     funcione: un color inline le gana a la variante de modo oscuro (es la trampa que dejó el
     texto invisible en la sala en vivo). */
  .soe-desplegar { cursor: pointer; color: var(--primary); }
  [data-theme="dark"] .soe-desplegar { color: #8ab4f8; }

  /* El bloque plegado que suma material a una actuación ya registrada. */
  .adj-alta { margin-top: 10px; }
  .adj-alta > summary {
    cursor: pointer; font-size: 12.5px; color: var(--primary);
    display: inline-flex; align-items: center; gap: 4px;
  }
  [data-theme="dark"] .adj-alta > summary { color: #8ab4f8; }
  .adj-alta > summary .material-symbols-outlined { font-size: 15px; }

  /* Un <input type=file> propio: el nativo no se puede estilar y se ve distinto en cada
     navegador. La etiqueta es el control visible y el input queda tapado detrás de ella. */
  .archivo-campo { position: relative; }
  .archivo-campo input[type=file] {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: pointer;
  }
  .archivo-campo .caja {
    display: flex; align-items: center; gap: 8px;
    border: 1px dashed var(--border); border-radius: var(--radius-sm);
    padding: 10px 12px; font-size: 13px; color: var(--text-secondary); background: var(--surface);
  }
  .archivo-campo input[type=file]:focus-visible + .caja { border-color: var(--primary); outline: 2px solid var(--primary); outline-offset: 1px; }
  .archivo-campo:hover .caja { border-color: var(--primary); color: var(--primary); }
  .archivo-campo .caja .material-symbols-outlined { font-size: 19px; }

  /* ── Citaciones ─────────────────────────────────────────────────────────────
     Misma caja que una derivación: son las dos actuaciones que tienen un estado propio y
     esperan algo del mundo de afuera. */
  .cita { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; margin-bottom: 12px; }
  /* Pasó el día y nadie registró qué pasó. El mismo resaltado que la derivación sin
     respuesta: es el agujero por el que se pierde el dato. */
  .cita.atencion { border-color: #ea4335; background: #fce8e610; }
  .cita h4 { margin: 0 0 4px; font-size: 15px; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
  .cita h4 .material-symbols-outlined { font-size: 18px; color: var(--text-secondary); }
  .cita .cuando { font-size: 13px; font-weight: 600; color: var(--text); }
  .cita .resultado {
    border-left: 3px solid var(--primary); padding: 8px 12px; margin-top: 10px;
    background: var(--bg); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 13.5px; line-height: 1.5; white-space: pre-wrap;
  }

  /* El hito de citación en la línea de tiempo. El acento es el mismo azul de la apertura
     porque las dos son actos institucionales de la escuela, no del servicio externo.
     El par claro/oscuro va acá igual que los otros cinco: sobre --bg oscuro el tono de
     abajo pierde contraste. */
  .linea li.hito-citacion { --acento: #1a73e8; }
  [data-theme="dark"] .linea li.hito-citacion { --acento: #8ab4f8; }
  .linea .resultado {
    border-left: 3px solid var(--acento, var(--border)); padding: 7px 11px; margin-top: 8px;
    background: var(--surface); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 13px; line-height: 1.5; white-space: pre-wrap;
  }

  /* ── El calendario de la agenda ─────────────────────────────────────────────
     Mes de pared, de domingo a sábado, igual que el de Preceptoría y el de Dirección (la
     grilla la arma services/actividadesDelDia.js, compartida con ellos). Los colores, en
     cambio, van por tokens y NO en hex como en aquellas dos pantallas: este panel se usa
     también de noche y con el tema oscuro puesto. */
  .cal-cab { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .cal-cab .mes { font-size: 16px; font-weight: 600; text-transform: capitalize; }
  .cal-nav { display: flex; gap: 6px; }
