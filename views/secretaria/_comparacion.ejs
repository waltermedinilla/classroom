<%# La comparación de un curso con el horario oficial (specs/secretaria-horario-oficial.spec.md, D4).
    Recibe `comparacion` ({ oficial, filas, sobran, resumen } o { oficial: null, hayImportado }),
    NOMBRE_DIA y ETIQUETA_ESTADO. Todo lo que sale del JSON se escapa.
    `enlaceOficial` (opcional): adónde llevan los enlaces al horario oficial; null los saca
    (el Jefe de Taller no entra a /secretaria/oficial). %>
<% const _enlaceOficial = typeof enlaceOficial === 'undefined' ? '/secretaria/oficial' : enlaceOficial; %>
<style>
  .co-res { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
  .co-res .n { background:#fff; border:1px solid #dadce0; border-radius:10px; padding:8px 12px; font-size:13px; }
  .co-res .n b { font-size:18px; display:block; }
  .co-dia { font-size:15px; margin:16px 0 6px; }
  .co-tabla { border-collapse:collapse; width:100%; font-size:12.5px; background:#fff; border:1px solid #dadce0; border-radius:10px; overflow:hidden; }
  .co-tabla th { text-align:left; font-weight:600; color:#3c4043; padding:7px 8px; border-bottom:1px solid #dadce0; background:#fff; }
  .co-tabla td { padding:7px 8px; border-bottom:1px solid #f1f3f4; vertical-align:top; }
  .co-tabla td.h { white-space:nowrap; color:#3c4043; }
  .co-doc { font-weight:700; color:#202124; }
  .co-nota { color:#80868b; font-size:11.5px; }
  .co-est { display:inline-block; font-size:11.5px; font-weight:600; padding:2px 8px; border-radius:10px; white-space:nowrap; }
  .co-est.e-coincide { background:#e6f4ea; color:#137333; }
  .co-est.e-docenteParecido { background:#fef7e0; color:#8a5300; }
  .co-est.e-otroDocente, .co-est.e-otraMateria, .co-est.e-sobra { background:#feefe3; color:#b45309; }
  .co-est.e-falta { background:#fce8e6; color:#b3261e; }
  .co-est.e-sinModulo, .co-est.e-sinMateria { background:#f1f3f4; color:#5f6368; }
  .co-solo { display:inline-flex; align-items:center; gap:6px; font-size:13px; margin-bottom:6px; cursor:pointer; }
  .co-wrap.solo tr.co-ok, .co-wrap.solo .co-todo-ok { display:none; }
</style>

<% if (!comparacion.oficial) { %>
  <div class="sd-aviso">
    <% if (comparacion.hayImportado) { %>
      Este curso no está en el horario oficial importado (se busca por los números del curso y la división).
    <% } else { %>
      Todavía no se importó el horario oficial.
    <% } %>
    <% if (_enlaceOficial) { %><a href="<%= _enlaceOficial %>">Ver el horario oficial</a>.<% } %>
  </div>
<% } else {
     const o = comparacion.oficial, r = comparacion.resumen;
     const dias = [...new Set(comparacion.filas.map(f => f.dia).concat(comparacion.sobran.map(s => s.dia)))].sort((a, b) => a - b); %>
  <p class="sd-ayuda" style="margin-top:0">
    Oficial: <b><%= o.curso %>° <%= String(o.division).padStart(2, '0') %>°</b> · <%= o.turno %> · <%= o.carrera %>.
    Se compara por la hora de cada renglón contra los módulos de la grilla de la escuela.
    <% if (_enlaceOficial) { %><a href="<%= _enlaceOficial %>">Resumen de todos los cursos</a>.<% } %>
  </p>
  <% (o.notas || []).forEach(n => { %><div class="sd-aviso"><%= n %></div><% }) %>

  <div class="co-res">
    <div class="n"><b class="ho-ok" style="color:#137333"><%= r.coincide %></b>coinciden</div>
    <div class="n"><b style="color:<%= r.diferencias ? '#b45309' : '#137333' %>"><%= r.diferencias %></b>diferencias</div>
    <div class="n"><b style="color:#8a5300"><%= r.parecidos %></b>docentes a confirmar</div>
    <div class="n"><b style="color:#5f6368"><%= r.informativos %></b>fuera de la grilla o sin materia</div>
  </div>

  <label class="co-solo"><input type="checkbox" id="coSolo"> Mostrar solo las diferencias y lo que hay que confirmar</label>
  <div class="co-wrap" id="coWrap">
  <% dias.forEach(d => {
       const filas = comparacion.filas.filter(f => f.dia === d);
       const sobran = comparacion.sobran.filter(s => s.dia === d);
       const todoOk = !sobran.length && filas.every(f => ['coincide', 'sinModulo', 'sinMateria'].includes(f.estado)); %>
    <div class="<%= todoOk ? 'co-todo-ok' : '' %>">
    <h3 class="co-dia"><%= NOMBRE_DIA[d] %></h3>
    <div style="overflow-x:auto">
      <table class="co-tabla">
        <thead><tr><th>Horario</th><th>Oficial</th><th>En la plataforma</th><th>Estado</th></tr></thead>
        <tbody>
          <% filas.forEach(f => { %>
            <tr class="<%= ['coincide', 'sinModulo', 'sinMateria'].includes(f.estado) ? 'co-ok' : '' %>">
              <td class="h"><%= f.desde %> - <%= f.hasta %></td>
              <td>
                <div><%= f.materia || '—' %><% if (f.nota) { %> <span class="co-nota">(<%= f.nota %>)</span><% } %></div>
                <% if (f.docente) { %><div class="co-doc"><%= f.docente %></div><% } %>
              </td>
              <td>
                <% if (!f.plataforma.length) { %><span class="co-nota">—</span><% } %>
                <% f.plataforma.forEach(p => { %>
                  <div><%= p.materia %></div>
                  <% p.docentes.forEach(n => { %><div class="co-doc"><%= n %></div><% }) %>
                <% }) %>
              </td>
              <td>
                <span class="co-est e-<%= f.estado %>"><%= ETIQUETA_ESTADO[f.estado] %></span>
                <% if (f.estado === 'docenteParecido' && f.docenteEn) { %><div class="co-nota">¿<%= f.docente %> es <%= f.docenteEn %>?</div><% } %>
              </td>
            </tr>
          <% }) %>
          <% sobran.forEach(s => { %>
            <tr>
              <td class="h"><%= s.desde %> - <%= s.hasta %></td>
              <td><span class="co-nota">—</span></td>
              <td><div><%= s.materia %></div><% s.docentes.forEach(n => { %><div class="co-doc"><%= n %></div><% }) %></td>
              <td><span class="co-est e-sobra">No está en el oficial</span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    </div>
  <% }) %>
  </div>
  <script>
    document.getElementById('coSolo').addEventListener('change', function () {
      document.getElementById('coWrap').classList.toggle('solo', this.checked);
    });
  </script>

  <p class="sd-ayuda">
    <b>Coincide</b>: misma materia y mismo docente en esos módulos. <b>¿Mismo docente?</b>: mismo apellido y parte del nombre,
    hay que confirmarlo. <b>Fuera de la grilla</b>: el horario oficial no cae en ningún módulo de la escuela (por ejemplo,
    Educación Física a contraturno); no es una diferencia. <% if (typeof textoCorregir === 'string') { %><%= textoCorregir %><% } else { %>Para corregir lo cargado, usá el modo <b>Cargar</b>.<% } %>
  </p>
<% } %>
