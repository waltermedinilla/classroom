<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi perfil - Classroom</title>
  <%- include('partials/head-iconos') %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Dos columnas para Contacto + Sobre mí. Aprovecha el espacio a la derecha que antes
       quedaba vacío (los inputs de contacto tenían max-width:420px en una card full-width). */
    .profile-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
    @media (max-width: 900px) { .profile-two-col { grid-template-columns: 1fr; } }

    .about-label {
      display: block; font-size: 12px; font-weight: 600; color: var(--text-secondary);
      text-transform: uppercase; letter-spacing: .3px; margin-bottom: 8px;
    }
    .about-textarea {
      width: 100%; box-sizing: border-box; padding: 10px 12px; font-family: inherit;
      font-size: 14px; line-height: 1.5; resize: vertical;
      border: 1px solid var(--divider, #dadce0); border-radius: 8px;
      background: var(--bg); color: var(--text-primary);
    }
    .about-textarea:focus { outline: none; border-color: var(--primary); }
    .about-counter { text-align: right; font-size: 11px; color: var(--text-hint); margin-top: 4px; }
    .about-counter.limite { color: #ea8600; font-weight: 600; }

    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 12px; border-radius: 20px; cursor: pointer;
      border: 1px solid var(--divider, #dadce0); background: var(--surface);
      color: var(--text-secondary); font-size: 13px; font-family: inherit;
      transition: background .15s, border-color .15s, color .15s;
    }
    .chip .material-symbols-outlined { font-size: 16px; }
    .chip:hover { background: var(--bg); }
    .chip-on {
      background: #e8f0fe; border-color: var(--primary); color: var(--primary); font-weight: 500;
    }
    /* Al llegar al tope, los no elegidos se atenúan para que se entienda por qué no responden */
    .chip.bloqueado { opacity: .4; cursor: not-allowed; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <main class="main-content">

    <!-- Encabezado del perfil -->
    <div class="profile-header">
      <div class="profile-avatar">
        <% const _avatarBg = user.role === 'admin' ? '#ea4335' : user.role === 'teacher' ? '#1a73e8' : user.role === 'directivo' ? '#9334e6' : user.role === 'preceptor' ? '#ea8600' : user.role === 'jefe' ? '#3f51b5' : user.role === 'soe' ? '#0d7377' : '#5f6368'; %>
        <div class="profile-avatar-wrap" id="avatarWrap" style="border-radius:50%">
          <% if (user.avatar) { %>
            <div class="avatar-huge avatar-img" style="width:80px;height:80px"><img src="<%= user.avatar %>" alt="<%= user.name %>"></div>
          <% } else { %>
            <div class="avatar-huge" id="avatarInitial" style="width:80px;height:80px;font-size:36px;background:<%= _avatarBg %>">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <div class="upload-overlay" id="avatarUploadOverlay" style="border-radius:50%">
            <div class="upload-spinner"></div>
          </div>
          <label class="avatar-upload-btn" title="Cambiar foto de perfil">
            <input type="file" id="avatarFileInput" accept="image/*,.jfif,.avif,.tif,.tiff" hidden>
            <span class="material-symbols-outlined">photo_camera</span>
          </label>
        </div>
        <% if (user.avatar) { %>
          <button class="avatar-remove-btn" id="avatarRemoveBtn" onclick="removeAvatar()">Quitar foto</button>
        <% } else { %>
          <button class="avatar-remove-btn" id="avatarRemoveBtn" onclick="removeAvatar()" style="display:none">Quitar foto</button>
        <% } %>
      </div>
      <div class="profile-info">
        <h2><%= user.name %></h2>
        <% if (user.dni) { %>
          <p style="font-family:monospace;font-size:13px;color:var(--text-secondary);margin-bottom:2px">DNI: <%= user.dni %></p>
        <% } %>
        <p class="profile-email" id="profileEmailText"><%= user.email %></p>
        <% if (typeof verificacionEnabled !== 'undefined' && verificacionEnabled) { %>
          <p style="margin:2px 0 8px" id="verifChipEmailCabecera">
            <%- include('partials/chip-verificado', { person: user, canal: 'email' }) %>
          </p>
        <% } %>
        <span class="role-badge role-<%= user.role %>" style="font-size:14px;padding:6px 16px"><%= roleNames[user.role] || user.role %></span>
        <% if (school) { %>
          <p style="font-size:13px;color:var(--text-secondary);margin-top:8px;display:flex;align-items:center;gap:6px">
            <span style="width:10px;height:10px;border-radius:50%;background:<%= school.color %>;display:inline-block;flex-shrink:0"></span>
            <%= school.name %>
          </p>
        <% } %>
        <p class="profile-date">Miembro desde <%= fmt.diaMesLargo(user.createdAt) %></p>
      </div>
      <div class="profile-actions">
        <% if (user.email !== systemOwnerEmail) { %>
        <button class="btn btn-outline" onclick="document.getElementById('changeEmailModal').style.display='flex'">
          <span class="material-symbols-outlined" style="font-size:18px">alternate_email</span>
          Cambiar correo
        </button>
        <% } %>
        <button class="btn btn-outline" onclick="document.getElementById('changePwdModal').style.display='flex'">
          <span class="material-symbols-outlined" style="font-size:18px">lock</span>
          Cambiar contraseña
        </button>
      </div>
    </div>

    <!-- Modal cambiar correo -->
    <div id="changeEmailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center">
      <div style="background:#fff;border-radius:12px;padding:32px;width:100%;max-width:400px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.2)">
        <h3 style="margin:0 0 20px;font-size:18px">Cambiar correo electrónico</h3>
        <div id="changeEmailError" style="display:none;background:#fce8e6;color:#c5221f;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>
        <div id="changeEmailOk" style="display:none;background:#e6f4ea;color:#137333;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <input type="email" id="newEmailInput" placeholder="Nuevo correo electrónico" style="padding:10px 14px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none">
          <input type="password" id="currentPwdForEmail" placeholder="Contraseña actual" style="padding:10px 14px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none">
        </div>
        <p style="font-size:12px;color:var(--text-secondary);margin-top:10px">
          La próxima vez que inicies sesión vas a usar el correo nuevo. Guardalo bien.
        </p>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:24px">
          <button class="btn btn-outline" onclick="closeEmailModal()">Cancelar</button>
          <button class="btn btn-primary" id="saveEmailBtn" onclick="submitChangeEmail()">Guardar</button>
        </div>
      </div>
    </div>

    <!-- Modal cambiar contraseña -->
    <div id="changePwdModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center">
      <div style="background:#fff;border-radius:12px;padding:32px;width:100%;max-width:400px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.2)">
        <h3 style="margin:0 0 20px;font-size:18px">Cambiar contraseña</h3>
        <div id="changePwdError" style="display:none;background:#fce8e6;color:#c5221f;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>
        <div id="changePwdOk" style="display:none;background:#e6f4ea;color:#137333;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <input type="password" id="currentPwd" placeholder="Contraseña actual" style="padding:10px 14px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none">
          <input type="password" id="newPwd" placeholder="Nueva contraseña (mín. 6 caracteres)" style="padding:10px 14px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none">
          <input type="password" id="confirmPwd" placeholder="Confirmar nueva contraseña" style="padding:10px 14px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none">
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:24px">
          <button class="btn btn-outline" onclick="closePwdModal()">Cancelar</button>
          <button class="btn btn-primary" id="savePwdBtn" onclick="submitChangePwd()">Guardar</button>
        </div>
      </div>
    </div>

    <!-- Contacto y redes + Sobre mí, lado a lado (colapsan a una columna en móvil) -->
    <div class="profile-two-col" style="margin-top:32px">

      <section class="section" style="margin-top:0">
        <div class="section-header">
          <span class="material-symbols-outlined section-icon">contact_phone</span>
          <h3>Contacto y redes</h3>
        </div>
        <div class="profile-action-card">
          <div class="form-error" id="contactError"></div>
          <div id="contactOk" style="display:none;background:#e6f4ea;color:#137333;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>
          <div style="display:flex;flex-direction:column;gap:14px">
            <div class="input-group">
              <span class="material-symbols-outlined input-icon">call</span>
              <input type="tel" id="contactPhone" placeholder="Celular" value="<%= user.phone || '' %>">
            </div>
            <div class="input-group">
              <span class="material-symbols-outlined input-icon">photo_camera</span>
              <input type="text" id="contactInstagram" placeholder="Instagram (usuario o link)" value="<%= user.instagram || '' %>">
            </div>
            <div class="input-group">
              <span class="material-symbols-outlined input-icon">group</span>
              <input type="text" id="contactFacebook" placeholder="Facebook (usuario o link)" value="<%= user.facebook || '' %>">
            </div>
          </div>
          <div style="margin-top:20px">
            <button class="btn btn-primary" id="saveContactBtn" onclick="submitContact()">Guardar</button>
          </div>
        </div>
      </section>

      <section class="section" style="margin-top:0">
        <div class="section-header">
          <span class="material-symbols-outlined section-icon">sentiment_satisfied</span>
          <h3>Sobre mí</h3>
        </div>
        <div class="profile-action-card">
          <div class="form-error" id="aboutError"></div>
          <div id="aboutOk" style="display:none;background:#e6f4ea;color:#137333;padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:16px"></div>

          <label class="about-label" for="aboutBio">Presentación</label>
          <textarea id="aboutBio" rows="3" maxlength="280" class="about-textarea"
            placeholder="Contá algo sobre vos en pocas palabras..."><%= user.bio || '' %></textarea>
          <div class="about-counter"><span id="bioCount"><%= (user.bio || '').length %></span>/280</div>

          <label class="about-label" style="margin-top:18px">
            Mis intereses
            <span style="font-weight:400;color:var(--text-hint)">(hasta <%= MAX_INTERESTS %>)</span>
          </label>
          <div class="chips" id="interestChips">
            <% INTERESTS.forEach(it => { %>
              <button type="button"
                class="chip <%= (user.interests || []).includes(it.id) ? 'chip-on' : '' %>"
                data-interest="<%= it.id %>" onclick="toggleInterest(this)">
                <span class="material-symbols-outlined"><%= it.icon %></span>
                <%= it.label %>
              </button>
            <% }) %>
          </div>

          <label class="about-label" for="aboutGoal" style="margin-top:18px">
            <% if (user.role === 'student') { %>
              Me gustaría dedicarme a...
            <% } else { %>
              Formación o especialidad
            <% } %>
          </label>
          <div class="input-group">
            <span class="material-symbols-outlined input-icon">
              <%= user.role === 'student' ? 'rocket_launch' : 'workspace_premium' %>
            </span>
            <input type="text" id="aboutGoal" maxlength="120"
              placeholder="<%= user.role === 'student' ? 'Ej: Ingeniería, música, oficios...' : 'Ej: Profesorado en Matemática' %>"
              value="<%= user.futureGoal || '' %>">
          </div>

          <div style="margin-top:20px">
            <button class="btn btn-primary" id="saveAboutBtn" onclick="submitAbout()">Guardar</button>
          </div>
          <p style="font-size:11px;color:var(--text-hint);margin-top:12px;line-height:1.5">
            <span class="material-symbols-outlined" style="font-size:13px;vertical-align:-2px">lock</span>
            Esta información la ves vos y el equipo directivo de la escuela. No la ven tus
            compañeros.
          </p>
        </div>
      </section>

    </div>

    <%# ─── Verificación de contacto ─────────────────────────────────────────────
        specs/verificacion-de-contacto.spec.md

        Esta es LA pantalla de la feature, y es la misma para el alumno, el docente y
        cualquier otro rol: "Mi perfil" existe para todos. La verificación NO bloquea nada
        —quien no verifica sigue usando la plataforma igual—, así que esto es informativo y
        opcional a propósito.

        La sección entera desaparece si la escuela no tiene el módulo prendido
        (verificacionEnabled sale de config/modulos.js vía server.js). %>
    <% if (typeof verificacionEnabled !== 'undefined' && verificacionEnabled) { %>
    <section class="section" style="margin-top:32px">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">verified_user</span>
        <h3>Verificación de contacto</h3>
      </div>
      <div class="profile-action-card">

        <p style="font-size:13px;color:var(--text-secondary);margin:0 0 18px;line-height:1.5">
          Confirmar tu correo y tu celular le sirve a la escuela para saber que puede
          contactarte de verdad. Es opcional: no verificar no te impide usar nada.
        </p>

        <div class="form-error" id="verifError"></div>
        <div id="verifOk" class="alert-ok" style="display:none"></div>

        <%# ── Correo ── %>
        <div style="padding:14px 0;border-top:1px solid var(--border)">
          <div class="verif-fila">
            <span class="material-symbols-outlined" style="color:var(--text-secondary)">mail</span>
            <span style="font-size:14px;word-break:break-all"><%= user.email %></span>
            <span id="verifChipEmail"><%- include('partials/chip-verificado', { person: user, canal: 'email' }) %></span>
            <span class="verif-acciones">
              <% if (!user.emailVerifiedAt && emailPuedeEnviar) { %>
                <button class="btn btn-outline" id="verifBtnEmail" onclick="pedirCodigo('email')">
                  <span class="material-symbols-outlined" style="font-size:18px">send</span>
                  Verificar
                </button>
              <% } else if (!user.emailVerifiedAt) { %>
                <%# Sin proveedor configurado no se dibuja el botón: uno que no hace nada es
                    peor que no tenerlo. %>
                <span style="font-size:12px;color:var(--text-secondary)">
                  Pedile a un administrador que lo confirme
                </span>
              <% } else { %>
                <button class="btn btn-outline" onclick="quitarVerificacion('email')">Ya no es mío</button>
              <% } %>
            </span>
          </div>

          <div class="verif-codigo-caja" id="verifCajaEmail">
            <p style="font-size:13px;color:var(--text-secondary);margin:0 0 10px" id="verifTextoEmail"></p>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
              <input class="verif-codigo-input" id="verifCodigoEmail" inputmode="numeric"
                     autocomplete="one-time-code" maxlength="6" placeholder="······">
              <button class="btn btn-primary" onclick="confirmarCodigo('email')">Confirmar</button>
              <button class="btn btn-outline" id="verifReenvioEmail" onclick="pedirCodigo('email')">Reenviar</button>
            </div>
          </div>
        </div>

        <%# ── Celular ── %>
        <div style="padding:14px 0;border-top:1px solid var(--border)">
          <div class="verif-fila">
            <span class="material-symbols-outlined" style="color:var(--text-secondary)">smartphone</span>
            <% if (user.phone) { %>
              <span style="font-size:14px"><%= user.phone %></span>
              <span id="verifChipCelular"><%- include('partials/chip-verificado', { person: user, canal: 'celular' }) %></span>
            <% } else { %>
              <span style="font-size:14px;color:var(--text-secondary)">
                No cargaste tu celular todavía — lo podés poner acá arriba, en «Contacto y redes».
              </span>
            <% } %>
            <span class="verif-acciones">
              <% if (user.phone && !user.phoneVerifiedAt && !user.phoneE164) { %>
                <%# El número está cargado pero no se pudo interpretar. NO se manda nada a un
                    número sin normalizar: sería pagar por un mensaje que va a ningún lado, o
                    peor, que llega al teléfono equivocado. %>
                <span style="font-size:12px;color:var(--text-secondary)">
                  Revisá el número: no pudimos interpretarlo como un celular argentino
                </span>
              <% } else if (user.phone && !user.phoneVerifiedAt && celularPuedeEnviar) { %>
                <button class="btn btn-outline" id="verifBtnCelular" onclick="pedirCodigo('celular')">
                  <span class="material-symbols-outlined" style="font-size:18px">send</span>
                  Verificar
                </button>
              <% } else if (user.phone && !user.phoneVerifiedAt) { %>
                <span style="font-size:12px;color:var(--text-secondary)">
                  Pedile a tu preceptor o a un administrador que lo confirme
                </span>
              <% } else if (user.phoneVerifiedAt) { %>
                <button class="btn btn-outline" onclick="quitarVerificacion('celular')">Ya no es mío</button>
              <% } %>
            </span>
          </div>

          <div class="verif-codigo-caja" id="verifCajaCelular">
            <p style="font-size:13px;color:var(--text-secondary);margin:0 0 10px" id="verifTextoCelular"></p>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
              <input class="verif-codigo-input" id="verifCodigoCelular" inputmode="numeric"
                     autocomplete="one-time-code" maxlength="6" placeholder="······">
              <button class="btn btn-primary" onclick="confirmarCodigo('celular')">Confirmar</button>
              <button class="btn btn-outline" id="verifReenvioCelular" onclick="pedirCodigo('celular')">Reenviar</button>
            </div>
          </div>
        </div>

      </div>
    </section>
    <% } %>

    <!-- Stats -->
    <% if (user.role !== 'student') { %>
    <div class="stats-grid" style="margin-top:32px">
      <div class="stat-card" style="--stat-color:#1a73e8">
        <div class="stat-icon"><span class="material-symbols-outlined">school</span></div>
        <div>
          <div class="stat-value"><%= createdCourses.length %></div>
          <div class="stat-label">Curso<%= createdCourses.length !== 1 ? 's' : '' %> dictado<%= createdCourses.length !== 1 ? 's' : '' %></div>
        </div>
      </div>
      <div class="stat-card" style="--stat-color:#34a853">
        <div class="stat-icon"><span class="material-symbols-outlined">people</span></div>
        <div>
          <div class="stat-value"><%= totalStudents %></div>
          <div class="stat-label">Alumno<%= totalStudents !== 1 ? 's' : '' %> en total</div>
        </div>
      </div>
      <div class="stat-card" style="--stat-color:#ea8600">
        <div class="stat-icon"><span class="material-symbols-outlined">assignment</span></div>
        <div>
          <div class="stat-value"><%= activityCount %></div>
          <div class="stat-label">Actividad<%= activityCount !== 1 ? 'es' : '' %> creada<%= activityCount !== 1 ? 's' : '' %></div>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="stats-grid" style="margin-top:32px">
      <div class="stat-card" style="--stat-color:#34a853">
        <div class="stat-icon"><span class="material-symbols-outlined">menu_book</span></div>
        <div>
          <div class="stat-value"><%= joinedCourses.length %></div>
          <div class="stat-label">Curso<%= joinedCourses.length !== 1 ? 's' : '' %> inscripto<%= joinedCourses.length !== 1 ? 's' : '' %></div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Mis cursos (docente) -->
    <% if (user.role !== 'student') { %>
    <section class="section" style="margin-top:40px">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">school</span>
        <h3>Mis cursos</h3>
      </div>
      <% if (createdCourses.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><span class="material-symbols-outlined">class</span></div>
          <p>Todavía no creaste ningún curso.</p>
        </div>
      <% } %>
      <div class="course-grid">
        <% createdCourses.forEach(c => { %>
          <% const subtitle = c.division?.name || ''; %>
          <a href="/courses/<%= c._id %>" class="course-card" style="--card-color:#1a73e8">
            <div class="card-banner">
              <div class="card-banner-content">
                <h4><%= c.name %></h4>
                <% if (subtitle) { %><p><%= subtitle %></p><% } %>
              </div>
              <div class="card-banner-deco">
                <span class="material-symbols-outlined">school</span>
              </div>
            </div>
            <div class="card-body">
              <div class="card-stat">
                <span class="material-symbols-outlined">group</span>
                <span><%= c.students.length %> alumno<%= c.students.length !== 1 ? 's' : '' %></span>
              </div>
            </div>
            <div class="card-footer">
              <div class="card-footer-icons">
                <button class="icon-btn card-icon-btn" title="Ir al curso"
                  onclick="event.preventDefault();event.stopPropagation();window.location.href='/courses/<%= c._id %>'">
                  <span class="material-symbols-outlined">open_in_new</span>
                </button>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } else { %>
    <!-- Cursos del alumno -->
    <section class="section" style="margin-top:40px">
      <div class="section-header">
        <span class="material-symbols-outlined section-icon">menu_book</span>
        <h3>Mis clases</h3>
      </div>
      <% if (joinedCourses.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><span class="material-symbols-outlined">class</span></div>
          <p>No estás inscripto en ningún curso.</p>
        </div>
      <% } %>
      <div class="course-grid">
        <% joinedCourses.forEach(c => { %>
          <% const subtitle = c.division?.name || ''; %>
          <a href="/courses/<%= c._id %>" class="course-card" style="--card-color:#34a853">
            <div class="card-banner">
              <div class="card-banner-content">
                <h4><%= c.name %></h4>
                <% if (subtitle) { %><p><%= subtitle %></p><% } %>
              </div>
              <div class="card-banner-deco">
                <span class="material-symbols-outlined">menu_book</span>
              </div>
            </div>
            <div class="card-body">
              <div class="card-stat">
                <div class="avatar" style="width:22px;height:22px;font-size:10px;background:#34a853"><%= (c.owner?.name || '—').charAt(0).toUpperCase() %></div>
                <span><%= c.owner?.name || 'Sin docente' %></span>
              </div>
            </div>
            <div class="card-footer">
              <div class="card-footer-icons">
                <button class="icon-btn card-icon-btn" title="Ir al curso"
                  onclick="event.preventDefault();event.stopPropagation();window.location.href='/courses/<%= c._id %>'">
                  <span class="material-symbols-outlined">open_in_new</span>
                </button>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

  </main>

  <%- include('partials/footer') %>
  <script>
    document.getElementById('avatarFileInput').addEventListener('change', async function () {
      const file = this.files[0];
      if (!file) return;

      const wrap    = document.getElementById('avatarWrap');
      const overlay = document.getElementById('avatarUploadOverlay');

      // 1. Preview local inmediata — el usuario ve la imagen antes de que suba
      const localUrl = URL.createObjectURL(file);
      const prev = wrap.querySelector('.avatar-huge, .avatar-img');
      if (prev) prev.remove();
      const previewDiv = document.createElement('div');
      previewDiv.className = 'avatar-huge avatar-img';
      previewDiv.style.cssText = 'width:80px;height:80px';
      previewDiv.innerHTML = `<img src="${localUrl}" alt="">`;
      wrap.prepend(previewDiv);

      // 2. Spinner encima de la preview mientras sube
      overlay.classList.add('show');

      const fd = new FormData();
      fd.append('avatar', file);
      const res = await fetch('/courses/profile/avatar', { method: 'POST', body: fd });

      overlay.classList.remove('show');
      URL.revokeObjectURL(localUrl);

      if (res.ok) {
        const { avatar } = await res.json();
        // Reemplaza la preview local con la URL definitiva del servidor
        previewDiv.innerHTML = `<img src="${avatar}" alt="">`;
        document.getElementById('avatarRemoveBtn').style.display = '';
        const headerAvatar = document.querySelector('.header .avatar, .header .avatar-img');
        if (headerAvatar) {
          headerAvatar.className = 'avatar avatar-img';
          headerAvatar.innerHTML = `<img src="${avatar}" alt="">`;
        }
      } else {
        previewDiv.remove();
        alert('No se pudo subir la imagen');
      }
      this.value = '';
    });

    async function removeAvatar() {
      if (!confirm('¿Quitar tu foto de perfil?')) return;
      const res = await fetch('/courses/profile/avatar', { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('No se pudo quitar el avatar');
    }

    function closePwdModal() {
      document.getElementById('changePwdModal').style.display = 'none';
      document.getElementById('currentPwd').value = '';
      document.getElementById('newPwd').value = '';
      document.getElementById('confirmPwd').value = '';
      document.getElementById('changePwdError').style.display = 'none';
      document.getElementById('changePwdOk').style.display = 'none';
    }

    async function submitChangePwd() {
      const errBox  = document.getElementById('changePwdError');
      const okBox   = document.getElementById('changePwdOk');
      const saveBtn = document.getElementById('savePwdBtn');
      errBox.style.display = 'none';
      okBox.style.display  = 'none';

      const currentPassword = document.getElementById('currentPwd').value;
      const newPassword     = document.getElementById('newPwd').value;
      const confirmPassword = document.getElementById('confirmPwd').value;

      if (newPassword !== confirmPassword) {
        errBox.textContent = 'Las contraseñas nuevas no coinciden';
        errBox.style.display = 'block';
        return;
      }

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="upload-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px"></span>Guardando…';

      try {
        const res  = await fetch('/courses/profile/change-password', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ currentPassword, newPassword }),
        });
        const data = await res.json();

        if (res.ok) {
          okBox.textContent = 'Contraseña actualizada correctamente';
          okBox.style.display = 'block';
          document.getElementById('currentPwd').value = '';
          document.getElementById('newPwd').value = '';
          document.getElementById('confirmPwd').value = '';
          setTimeout(closePwdModal, 1500);
        } else {
          errBox.textContent = data.error || 'Error al cambiar la contraseña';
          errBox.style.display = 'block';
        }
      } catch (e) {
        errBox.textContent = 'Error de conexión. Intentá de nuevo.';
        errBox.style.display = 'block';
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Guardar';
      }
    }

    function closeEmailModal() {
      document.getElementById('changeEmailModal').style.display = 'none';
      document.getElementById('newEmailInput').value = '';
      document.getElementById('currentPwdForEmail').value = '';
      document.getElementById('changeEmailError').style.display = 'none';
      document.getElementById('changeEmailOk').style.display = 'none';
    }

    async function submitChangeEmail() {
      const errBox  = document.getElementById('changeEmailError');
      const okBox   = document.getElementById('changeEmailOk');
      const saveBtn = document.getElementById('saveEmailBtn');
      errBox.style.display = 'none';
      okBox.style.display  = 'none';

      const newEmail        = document.getElementById('newEmailInput').value.trim();
      const currentPassword = document.getElementById('currentPwdForEmail').value;

      if (!newEmail || !currentPassword) {
        errBox.textContent = 'Completá los dos campos';
        errBox.style.display = 'block';
        return;
      }

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="upload-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px"></span>Guardando…';

      try {
        const res  = await fetch('/courses/profile/change-email', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ newEmail, currentPassword }),
        });
        const data = await res.json();

        if (res.ok) {
          okBox.textContent = 'Correo actualizado. La próxima vez ingresá con el nuevo.';
          okBox.style.display = 'block';
          document.getElementById('profileEmailText').textContent = data.email;
          document.getElementById('currentPwdForEmail').value = '';
          setTimeout(closeEmailModal, 1800);
        } else {
          errBox.textContent = data.error || 'Error al cambiar el correo';
          errBox.style.display = 'block';
        }
      } catch (e) {
        errBox.textContent = 'Error de conexión. Intentá de nuevo.';
        errBox.style.display = 'block';
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Guardar';
      }
    }

    async function submitContact() {
      const errBox  = document.getElementById('contactError');
      const okBox   = document.getElementById('contactOk');
      const saveBtn = document.getElementById('saveContactBtn');
      errBox.classList.remove('show');
      okBox.style.display = 'none';

      const phone     = document.getElementById('contactPhone').value.trim();
      const instagram = document.getElementById('contactInstagram').value.trim();
      const facebook  = document.getElementById('contactFacebook').value.trim();

      saveBtn.disabled = true;
      const originalLabel = saveBtn.textContent;
      saveBtn.innerHTML = '<span class="upload-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px"></span>Guardando…';

      try {
        const res  = await fetch('/courses/profile/contact', {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ phone, instagram, facebook }),
        });
        const data = await res.json();

        if (res.ok) {
          document.getElementById('contactPhone').value     = data.phone     || '';
          document.getElementById('contactInstagram').value = data.instagram || '';
          document.getElementById('contactFacebook').value  = data.facebook  || '';
          okBox.textContent = 'Datos de contacto actualizados';
          okBox.style.display = 'block';
          setTimeout(() => { okBox.style.display = 'none'; }, 2500);
        } else {
          errBox.textContent = data.error || 'Error al guardar los datos de contacto';
          errBox.classList.add('show');
        }
      } catch (e) {
        errBox.textContent = 'Error de conexión. Intentá de nuevo.';
        errBox.classList.add('show');
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalLabel;
      }
    }

    /* ─── Sobre mí ─── */
    const MAX_INTERESTS = <%= MAX_INTERESTS %>;

    // Contador de caracteres de la presentación. maxlength ya impide pasarse, esto solo avisa.
    const bioInput = document.getElementById('aboutBio');
    bioInput.addEventListener('input', function () {
      const n = this.value.length;
      document.getElementById('bioCount').textContent = n;
      document.querySelector('.about-counter').classList.toggle('limite', n > 250);
    });

    function interesesElegidos() {
      return [...document.querySelectorAll('#interestChips .chip-on')].map(c => c.dataset.interest);
    }

    // Al llegar al tope se atenúan los no elegidos, para que se entienda por qué dejan de
    // responder al click en vez de que parezca que la página se colgó.
    function sincronizarTope() {
      const enTope = interesesElegidos().length >= MAX_INTERESTS;
      document.querySelectorAll('#interestChips .chip').forEach(c => {
        c.classList.toggle('bloqueado', enTope && !c.classList.contains('chip-on'));
      });
    }

    function toggleInterest(chip) {
      const yaEsta = chip.classList.contains('chip-on');
      if (!yaEsta && interesesElegidos().length >= MAX_INTERESTS) return;
      chip.classList.toggle('chip-on');
      sincronizarTope();
    }
    sincronizarTope();

    async function submitAbout() {
      const errBox  = document.getElementById('aboutError');
      const okBox   = document.getElementById('aboutOk');
      const saveBtn = document.getElementById('saveAboutBtn');
      errBox.classList.remove('show');
      okBox.style.display = 'none';

      const bio        = document.getElementById('aboutBio').value.trim();
      const futureGoal = document.getElementById('aboutGoal').value.trim();
      const interests  = interesesElegidos();

      saveBtn.disabled = true;
      const originalLabel = saveBtn.textContent;
      saveBtn.innerHTML = '<span class="upload-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px"></span>Guardando…';

      try {
        const res  = await fetch('/courses/profile/about', {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ bio, interests, futureGoal }),
        });
        const data = await res.json();

        if (res.ok) {
          okBox.textContent = 'Perfil actualizado';
          okBox.style.display = 'block';
          setTimeout(() => { okBox.style.display = 'none'; }, 2500);
        } else {
          errBox.textContent = data.error || 'Error al guardar el perfil';
          errBox.classList.add('show');
        }
      } catch (e) {
        errBox.textContent = 'Error de conexión. Intentá de nuevo.';
        errBox.classList.add('show');
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalLabel;
      }
    }

    /* ─── Verificación de contacto ────────────────────────────────────────────
       specs/verificacion-de-contacto.spec.md

       Dos canales, una sola pareja de funciones: la única diferencia entre verificar el correo
       y verificar el celular es el texto del cartel. El servidor ya trata a los dos igual
       (un modelo, un service), así que duplicar acá sería crear la divergencia justo en el
       último tramo. */
    const VERIF_CHIPS = {
      email:   ['verifChipEmail', 'verifChipEmailCabecera'],
      celular: ['verifChipCelular'],
    };

    function verifMensaje(texto, esError) {
      const err = document.getElementById('verifError');
      const ok  = document.getElementById('verifOk');
      if (!err || !ok) return;
      err.classList.remove('show');
      ok.style.display = 'none';
      if (esError) {
        err.textContent = texto;
        err.classList.add('show');
      } else {
        ok.textContent = texto;
        ok.style.display = 'block';
      }
    }

    // Cuenta regresiva del botón de reenvío. Es lo que corta el doble click, que es el 90% del
    // "abuso" real — el servidor igual lo rechaza (cooldown de 60s), pero un botón que se ve
    // apretable y contesta 429 parece que está roto.
    function verifCuentaRegresiva(idBoton, segundos) {
      const btn = document.getElementById(idBoton);
      if (!btn) return;
      const etiqueta = btn.dataset.etiqueta || btn.textContent.trim();
      btn.dataset.etiqueta = etiqueta;
      let quedan = segundos;
      btn.disabled = true;
      btn.textContent = etiqueta + ' (' + quedan + ')';
      const t = setInterval(() => {
        quedan -= 1;
        if (quedan <= 0) {
          clearInterval(t);
          btn.disabled = false;
          btn.textContent = etiqueta;
        } else {
          btn.textContent = etiqueta + ' (' + quedan + ')';
        }
      }, 1000);
    }

    async function pedirCodigo(canal) {
      const Canal = canal === 'email' ? 'Email' : 'Celular';
      verifMensaje('', false);
      document.getElementById('verifOk').style.display = 'none';

      try {
        const res  = await fetch('/verificacion/' + canal + '/enviar', { method: 'POST' });
        const data = await res.json();

        if (!res.ok) {
          verifMensaje(data.error || 'No pudimos enviar el código.', true);
          // El 429 del cooldown trae cuántos segundos faltan: se los muestra en el botón en vez
          // de dejar a la persona apretando a ciegas.
          if (data.esperaSegundos) verifCuentaRegresiva('verifReenvio' + Canal, data.esperaSegundos);
          return;
        }

        document.getElementById('verifCaja' + Canal).classList.add('abierta');
        document.getElementById('verifTexto' + Canal).textContent =
          canal === 'email'
            ? 'Te mandamos un correo a ' + data.destino + '. Tocá el enlace, o escribí acá el código de 6 números.'
            : 'Te mandamos un código a ' + data.destino + '. Escribilo acá abajo.';
        document.getElementById('verifCodigo' + Canal).focus();
        verifCuentaRegresiva('verifReenvio' + Canal, data.esperaSegundos || 60);

        const botonPedir = document.getElementById('verifBtn' + Canal);
        if (botonPedir) botonPedir.style.display = 'none';
      } catch (e) {
        verifMensaje('Error de conexión. Intentá de nuevo.', true);
      }
    }

    async function confirmarCodigo(canal) {
      const Canal  = canal === 'email' ? 'Email' : 'Celular';
      const codigo = document.getElementById('verifCodigo' + Canal).value.trim();

      try {
        const res = await fetch('/verificacion/' + canal + '/codigo', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ codigo }),
        });
        const data = await res.json();

        if (!res.ok) {
          verifMensaje(data.error || 'El código no es correcto.', true);
          return;
        }

        document.getElementById('verifCaja' + Canal).classList.remove('abierta');
        verifMensaje(canal === 'email' ? '¡Listo! Tu correo quedó verificado.'
                                       : '¡Listo! Tu celular quedó verificado.', false);
        refrescarChips();
      } catch (e) {
        verifMensaje('Error de conexión. Intentá de nuevo.', true);
      }
    }

    async function quitarVerificacion(canal) {
      if (!confirm('¿Sacar la marca de verificado? Vas a poder volver a verificarlo cuando quieras.')) return;
      try {
        const res  = await fetch('/verificacion/' + canal, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) { verifMensaje(data.error || 'No se pudo.', true); return; }
        location.reload(); // cambian los botones, no solo el chip
      } catch (e) {
        verifMensaje('Error de conexión. Intentá de nuevo.', true);
      }
    }

    // Repinta los chips sin recargar. Usa la MISMA regla que el servidor
    // (public/js/estadoVerificacion.js, cargado como <script> más abajo): si acá se decidiera
    // el texto por las suyas, la pantalla y el resto del sistema podrían decir cosas distintas
    // sobre el mismo dato.
    async function refrescarChips() {
      try {
        const res  = await fetch('/verificacion/estado');
        if (!res.ok) return;
        const data = await res.json();

        for (const canal of ['email', 'celular']) {
          const e = window.EstadoVerificacion.estadoContacto(data.user, canal);
          const html = '<span class="chip-verif chip-verif--' + (e.tono === 'ok' ? 'ok' : 'neutro') + '">'
                     + '<span class="material-symbols-outlined">' + e.icono + '</span>' + e.texto + '</span>';
          for (const id of VERIF_CHIPS[canal]) {
            const nodo = document.getElementById(id);
            if (nodo) nodo.innerHTML = html;
          }
        }
      } catch (e) { /* el chip se actualiza igual al recargar; no vale romper la pantalla por esto */ }
    }
  </script>
  <%# La regla del chip, la misma que usa el servidor. Va al final para que las funciones de
      arriba la encuentren cargada cuando se las llama (nunca en el parseo). %>
  <% if (typeof verificacionEnabled !== 'undefined' && verificacionEnabled) { %>
    <script src="/js/estadoVerificacion.js"></script>
  <% } %>
</body>
</html>
